---
import { getMenu, getSiteSettings } from 'ecliptic';

const settings = await getSiteSettings();
const primaryMenu = await getMenu('primary');
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-[#7a1830]/10 bg-[#4a1525] px-4 py-10 text-white dark:border-[#c9506a]/10 dark:bg-[#1c1614] sm:px-8 sm:py-14">
    <div class="mx-auto max-w-5xl">
        <div class="grid gap-8 sm:grid-cols-3">
            {/* About column */}
            <div class="sm:col-span-2">
                <p class="text-lg font-extrabold tracking-tight text-white dark:text-slate-100">{settings.title}</p>
                {settings.tagline && (
                    <p class="mt-2 max-w-md text-sm leading-relaxed text-white/85 dark:text-slate-400">
                        {settings.tagline}
                    </p>
                )}
            </div>

            {/* Navigation column */}
            {primaryMenu?.items && primaryMenu.items.length > 0 && (
                <div>
                    <p class="text-xs font-bold uppercase tracking-widest text-white/70 dark:text-accent">Navigate</p>
                    <ul class="mt-3 space-y-2">
                        {primaryMenu.items.map((item) => (
                            <li>
                                <a href={item.url} class="text-sm text-white/85 hover:text-white dark:text-slate-400 dark:hover:text-accent transition-colors duration-300">
                                    {item.label}
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>
            )}
        </div>

        <div class="mt-10 border-t border-white/10 pt-6 dark:border-slate-700">
            <p class="text-xs text-white/60 dark:text-slate-500">
                &copy; {currentYear} {settings.title}. Built with Astro &amp; Ecliptic.
            </p>
        </div>
    </div>
</footer>
