---
import { Image } from 'ecliptic/ui';

interface Props {
    post: any;
}

const { post } = Astro.props;
const publishedAt = post.publishedAt ? new Date(post.publishedAt) : null;
const formattedDate = publishedAt?.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<article class="group">
    <div class="grid gap-6 lg:grid-cols-2 lg:gap-10 items-center">
        {post.data.featured_image?.src && (
            <a href={`/posts/${post.slug}`} aria-label={post.data.title} class="block overflow-hidden rounded-lg">
                <Image
                    image={post.data.featured_image}
                    alt={post.data.featured_image.alt || post.data.title}
                    width={960}
                    height={540}
                    class="w-full aspect-[16/9] object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                />
            </a>
        )}
        <div>
            <h2 class="text-2xl font-extrabold leading-snug tracking-tight text-slate-900 dark:text-slate-100 sm:text-3xl lg:text-4xl">
                <a href={`/posts/${post.slug}`} class="hover:text-primary dark:hover:text-accent transition-colors duration-300">{post.data.title}</a>
            </h2>
            {post.data.excerpt && (
                <p class="mt-3 text-base leading-relaxed text-slate-600 dark:text-slate-400 line-clamp-3">{post.data.excerpt}</p>
            )}
            {formattedDate && (
                <div class="mt-4 flex items-center gap-3 text-sm text-slate-500 dark:text-slate-400">
                    <time datetime={publishedAt?.toISOString()}>{formattedDate}</time>
                </div>
            )}
            <div class="mt-5">
                <a
                    class="inline-flex items-center gap-1.5 text-sm font-bold text-primary hover:text-secondary dark:text-accent dark:hover:text-white transition-colors duration-300"
                    href={`/posts/${post.slug}`}
                >
                    Read article
                    <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
                    </svg>
                </a>
            </div>
        </div>
    </div>
</article>
