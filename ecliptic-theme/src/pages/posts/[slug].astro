---
import { getEclipticEntry, getEntryTerms } from 'ecliptic';
import { PortableText, Image } from 'ecliptic/ui';
import Base from '../../layouts/Base.astro';

const { slug } = Astro.params;
const { entry: post } = await getEclipticEntry('posts', slug!);

if (!post) {
    return Astro.redirect('/404');
}

const categories = await getEntryTerms('posts', post.id, 'categories');
const publishedAt = post.publishedAt ? new Date(post.publishedAt) : null;
const formattedDate = publishedAt?.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const { href } = Astro.url;
---

<Base title={post.data.title} description={post.data.excerpt}>
    <main class="px-4 py-12 grow sm:px-8 sm:py-16">
        <article class="max-w-6xl mx-auto mb-12 sm:mb-16">
            <nav class="max-w-3xl mx-auto mb-6 text-sm" aria-label="Breadcrumb">
                <ol class="flex items-center gap-1.5">
                    <li><a href="/" class="text-slate-500 dark:text-slate-400 hover:text-primary dark:hover:text-accent transition-colors">Home</a></li>
                    <li class="before:content-['/'] before:mx-1.5 before:text-slate-300 dark:before:text-slate-600"><a href="/posts/" class="text-slate-500 dark:text-slate-400 hover:text-primary dark:hover:text-accent transition-colors">Blog</a></li>
                    {categories.length > 0 && (
                        <li class="before:content-['/'] before:mx-1.5 before:text-slate-300 dark:before:text-slate-600">
                            <a href={`/categories/${categories[0].slug}`} class="text-primary dark:text-accent hover:text-secondary dark:hover:text-white transition-colors">{categories[0].label}</a>
                        </li>
                    )}
                    <li class="before:content-['/'] before:mx-1.5 before:text-slate-300 dark:before:text-slate-600 text-slate-900 dark:text-slate-100 font-medium truncate" aria-current="page">{post.data.title}</li>
                </ol>
            </nav>

            {post.data.featured_image?.src ? (
                <header class="relative mb-8 sm:mb-10 rounded-lg overflow-hidden">
                    <Image
                        image={post.data.featured_image}
                        alt={post.data.featured_image.alt || post.data.title}
                        width={1200}
                        height={675}
                        class="w-full aspect-[16/9] object-cover"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
                    <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-8 lg:p-10">
                        <h1 class="text-2xl font-extrabold tracking-tight text-white sm:text-3xl md:text-4xl lg:text-5xl drop-shadow-lg">{post.data.title}</h1>
                        {formattedDate && (
                            <div class="mt-3 flex items-center gap-3 text-sm text-white/80">
                                <time datetime={publishedAt?.toISOString()}>{formattedDate}</time>
                            </div>
                        )}
                    </div>
                </header>
            ) : (
                <header class="max-w-3xl mx-auto mb-8 sm:mb-10">
                    <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-slate-100 sm:text-4xl md:text-5xl">{post.data.title}</h1>
                    {formattedDate && (
                        <div class="mt-4 flex items-center gap-3 text-sm text-slate-500 dark:text-slate-400">
                            <time datetime={publishedAt?.toISOString()}>{formattedDate}</time>
                        </div>
                    )}
                </header>
            )}

            <div class="max-w-3xl mx-auto">
                <div class="prose prose-slate sm:prose-lg max-w-none">
                    <PortableText value={post.data.content} />
                </div>

                {/* Category links */}
                {categories.length > 0 && (
                    <div class="mt-10 flex flex-wrap items-center gap-2 border-t border-slate-200 pt-6 dark:border-[#2a2623]">
                        <span class="text-sm font-semibold text-slate-700 dark:text-slate-300">Categories</span>
                        {categories.map((cat) => (
                            <a
                                href={`/categories/${cat.slug}`}
                                class="rounded-full bg-primary/15 px-2.5 py-0.5 text-xs font-bold text-primary transition-colors duration-300 hover:bg-primary hover:text-white dark:bg-accent/15 dark:text-accent dark:hover:bg-accent dark:hover:text-slate-900"
                            >
                                {cat.label}
                            </a>
                        ))}
                    </div>
                )}

                {/* Share buttons */}
                <div class="mt-6 flex items-center gap-3 border-t border-slate-200 pt-6 dark:border-[#2a2623]">
                    <span class="text-sm font-semibold text-slate-700 dark:text-slate-300">Share</span>
                    <div class="flex gap-2">
                        <a
                            class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-slate-100 text-slate-600 transition-colors duration-300 hover:bg-black hover:text-white dark:bg-[#2a2623] dark:text-slate-300"
                            href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(href)}&text=${encodeURIComponent(post.data.title)}`}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="Share on X"
                        >
                            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                        </a>
                        <a
                            class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-slate-100 text-slate-600 transition-colors duration-300 hover:bg-[#0085ff] hover:text-white dark:bg-[#2a2623] dark:text-slate-300"
                            href={`https://bsky.app/intent/compose?text=${encodeURIComponent(post.data.title + ' ' + href)}`}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="Share on Bluesky"
                        >
                            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.596 6.449.77 2.819 3.513 3.502 5.942 3.134-3.476.558-6.594 1.654-3.378 5.757C5.505 22.329 11.116 21.63 12 17.558c.884 4.074 5.356 4.827 8.84 1.55 3.216-4.103.098-5.199-3.378-5.757 2.429.368 5.172-.315 5.942-3.134.218-.8.596-5.759.596-6.449 0-.688-.139-1.86-.902-2.203-.659-.3-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8Z"/></svg>
                        </a>
                        <a
                            class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-slate-100 text-slate-600 transition-colors duration-300 hover:bg-[#0077b5] hover:text-white dark:bg-[#2a2623] dark:text-slate-300"
                            href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(href)}`}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="Share on LinkedIn"
                        >
                            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                        </a>
                    </div>
                </div>
            </div>
        </article>
    </main>
</Base>
