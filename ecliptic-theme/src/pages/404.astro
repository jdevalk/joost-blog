---
import { getEclipticCollection } from 'ecliptic';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';

const { entries: recentPosts } = await getEclipticCollection('posts', {
    where: { status: 'published' },
    orderBy: { publishedAt: 'desc' },
    limit: 3
});
---

<Base title="Page Not Found">
    <main class="grow px-4 py-12 sm:px-8">
        <div class="max-w-3xl mx-auto text-center">
            <h1 class="text-8xl font-bold text-slate-300 dark:text-slate-600 mb-4">404</h1>
            <h2 class="text-2xl font-semibold text-slate-900 dark:text-slate-100 mb-4">Page Not Found</h2>
            <p class="text-lg text-slate-600 dark:text-slate-400 mb-8">
                The page you are looking for does not exist or has been moved.
            </p>
            <a
                href="/"
                class="inline-block px-6 py-3 bg-primary text-white font-semibold rounded-lg hover:opacity-90 transition-opacity"
            >
                Go Home
            </a>
        </div>
        {recentPosts.length > 0 && (
            <div class="max-w-3xl mx-auto xl:max-w-6xl mt-16">
                <h2 class="text-xl font-semibold text-slate-900 dark:text-slate-100 mb-8">Recent Posts</h2>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                    {recentPosts.map((post) => (
                        <PostCard post={post} />
                    ))}
                </div>
            </div>
        )}
    </main>
</Base>
