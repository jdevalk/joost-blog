---
import { getTerm, getEntriesByTerm } from 'ecliptic';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import PostCard from '../../components/PostCard.astro';

const { slug } = Astro.params;
const tag = await getTerm('tags', slug!);
const posts = await getEntriesByTerm('posts', 'tags', slug!);

if (!tag) {
    return Astro.redirect('/404');
}
---

<Base title={tag.label} description={`Posts tagged ${tag.label}`}>
    <div class="relative bg-gradient-to-br from-[#4a1525] via-[#3a1a28] to-[#2e1220] text-white" slot="header">
        <Header variant="dark" />
        <div class="h-[52px] sm:h-[56px]"></div>
        <section class="px-4 py-10 sm:px-8 sm:py-14">
            <div class="max-w-5xl mx-auto">
                <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl">Tag: {tag.label}</h1>
            </div>
        </section>
    </div>

    <main class="grow">
        <section class="px-4 py-10 sm:px-8 sm:py-14">
            <div class="max-w-5xl mx-auto">
                <p class="mb-8 text-lg text-slate-600 dark:text-slate-400">{posts.length} {posts.length === 1 ? 'post' : 'posts'} tagged {tag.label}.</p>
                <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                    {posts.map((post) => <PostCard post={post} />)}
                </div>
            </div>
        </section>
    </main>
</Base>
