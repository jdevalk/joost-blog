---
import { getEmDashCollection, getSiteSettings, getSection, getTermsForEntries } from 'emdash';
import { getReadingTime } from '../utils/reading-time';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import PostCard from '../components/PostCard.astro';
import FeaturedPost from '../components/FeaturedPost.astro';

const settings = await getSiteSettings();
const heroSection = await getSection('homepage-hero');

// Sidebar card sections
const cardSlugs = ['homepage-product', 'homepage-investment', 'homepage-code'];
const cardSections = (await Promise.all(cardSlugs.map(s => getSection(s)))).filter(Boolean);

let heroHeading = "Joost de Valk";
let heroLabel = "Hi, I'm";
let heroBody = "";
let heroImageUrl: string | undefined;
let heroImageAlt = "";
let heroLinks: {text: string; href: string; blank?: boolean}[] = [];

if (heroSection) {
    heroHeading = heroSection.title || heroHeading;
    heroLabel = heroSection.description || heroLabel;

    // Extract image and body from section content
    const bodyBlocks: any[] = [];
    for (const block of (heroSection.content || [])) {
        if (block._type === 'image') {
            const asset = block.asset;
            if (asset?.url) heroImageUrl = asset.url;
            else if (asset?._ref) heroImageUrl = `/_emdash/api/media/file/${asset._ref}`;
            heroImageAlt = block.alt || heroHeading;
        } else {
            bodyBlocks.push(block);
        }
    }

    // Extract text and links from first body block
    if (bodyBlocks.length > 0) {
        const block = bodyBlocks[0];
        const markDefs = block.markDefs || [];
        let text = "";
        for (const child of (block.children || [])) {
            if (child.marks?.length > 0) {
                const linkDef = markDefs.find((m: any) => child.marks.includes(m._key));
                if (linkDef) {
                    heroLinks.push({ text: child.text, href: linkDef.href, blank: linkDef.blank });
                    text += `<a href="${linkDef.href}"${linkDef.blank ? ' target="_blank" rel="noopener noreferrer"' : ''}>${child.text}</a>`;
                } else {
                    text += child.text;
                }
            } else {
                text += child.text;
            }
        }
        heroBody = text;
    }
}

const { entries: allPosts, cacheHint } = await getEmDashCollection('posts', {
    orderBy: { published_at: 'desc' },
    limit: 7
});
Astro.cache.set(cacheHint);

const sortedPosts = [...allPosts].sort(
    (a, b) => (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0)
);

const featuredPost = sortedPosts.find((p) => p.data.featured);
const latestPosts = sortedPosts.filter((p) => p.id !== featuredPost?.id).slice(0, 6);

// Fetch categories for all displayed posts (data.id is the ULID, entry.id is the slug)
const displayedIds = [...(featuredPost ? [featuredPost.data.id] : []), ...latestPosts.map(p => p.data.id)];
const categoryMap = displayedIds.length > 0 ? await getTermsForEntries('posts', displayedIds, 'category') : new Map();
---

<Base title="Home">
    <div class="relative bg-gradient-to-br from-[#4a1525] via-[#3a1a28] to-[#2e1220] text-white" slot="header">
        <Header variant="dark" />
        <div class="h-[52px] sm:h-[56px]"></div>
        <section class="relative px-4 py-10 sm:px-8 sm:py-14">
            <div class="flex flex-col items-center w-full max-w-3xl mx-auto sm:flex-row sm:items-center sm:text-left sm:gap-8">
                {heroImageUrl && (
                    <div class="shrink-0 mb-4 sm:mb-0">
                        <img
                            src={heroImageUrl}
                            alt={heroImageAlt}
                            class="object-cover w-36 sm:w-44 border-2 rounded-full aspect-square border-white/20 shadow-avatar-dark"
                            width="176"
                            height="176"
                            loading="eager"
                        />
                    </div>
                )}
                <div class="text-center sm:text-left">
                    <div class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
                        {heroLabel} <h1 class="inline">{heroHeading}</h1>
                    </div>
                    {heroBody && (
                        <p class="mt-2 text-base sm:text-lg leading-relaxed text-white/75 [&_a]:text-accent [&_a]:underline [&_a]:underline-offset-2 [&_a:hover]:text-white" set:html={heroBody} />
                    )}
                    <div class="flex flex-wrap gap-x-2 gap-y-2 justify-center sm:justify-start mt-5">
                        <a class="inline-flex h-11 w-11 items-center justify-center rounded-full transition duration-300 bg-white/10 hover:bg-white/20 text-white hover:text-white" href="https://x.com/jdevalk" target="_blank" rel="noopener noreferrer" aria-label="X / Twitter">
                            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                        </a>
                        <a class="inline-flex h-11 w-11 items-center justify-center rounded-full transition duration-300 bg-white/10 hover:bg-white/20 text-white hover:text-white" href="https://github.com/jdevalk" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
                            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
                        </a>
                        <a class="inline-flex h-11 w-11 items-center justify-center rounded-full transition duration-300 bg-white/10 hover:bg-white/20 text-white hover:text-white" href="https://www.linkedin.com/in/jdevalk/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                        </a>
                        <a class="inline-flex h-11 w-11 items-center justify-center rounded-full transition duration-300 bg-white/10 hover:bg-white/20 text-white hover:text-white" href="https://bsky.app/profile/joost.blog" target="_blank" rel="noopener noreferrer" aria-label="Bluesky">
                            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.785 2.627 3.59 3.513 6.182 3.268-4.578.695-8.618 2.552-5.073 7.769 3.873 4.832 6.478-1.587 7.267-3.942.789 2.355 2.036 8.475 7.267 3.942 3.545-5.217-.495-7.074-5.073-7.769 2.592.245 5.397-.641 6.182-3.268C17.622 9.418 18 4.458 18 3.768c0-.688-.139-1.86-.902-2.203-.659-.3-1.664-.62-4.3 1.24C10.046 4.747 7.087 8.686 6 10.8"/></svg>
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <main class="grow">
        {/* Currently working on */}
        <section class="px-4 py-10 sm:px-8 sm:py-14 bg-surface dark:bg-[#1e1b19]/50 border-b border-slate-200 dark:border-[#2a2623]">
            <div class="max-w-5xl mx-auto">
                <h2 class="mb-6 text-xs font-bold uppercase tracking-widest text-primary dark:text-accent">Currently working on</h2>
                <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    {cardSections.map((section) => {
                        const href = section.keywords?.[0] || '#';
                        const isExternal = href.startsWith('http');
                        const text = section.content?.[0]?.children?.[0]?.text || '';
                        return (
                            <a
                                href={href}
                                target={isExternal ? '_blank' : undefined}
                                rel={isExternal ? 'noopener noreferrer' : undefined}
                                class="group flex flex-col rounded-lg border border-slate-200 bg-white p-5 transition duration-300 hover:shadow-card-hover hover:-translate-y-0.5 dark:border-[#2a2623] dark:bg-[#1e1b19]/50"
                            >
                                <span class="mb-2 text-xs font-bold uppercase tracking-wider text-primary dark:text-accent">{section.description}</span>
                                <h3 class="text-lg font-extrabold text-slate-950 dark:text-slate-100 group-hover:text-primary dark:group-hover:text-accent transition-colors duration-300">{section.title}</h3>
                                <p class="mt-1.5 text-sm leading-relaxed text-slate-700 dark:text-slate-400">{text}</p>
                            </a>
                        );
                    })}
                </div>
            </div>
        </section>

        {/* Featured post */}
        {featuredPost && (
            <section class="px-4 py-12 sm:px-8 sm:py-16">
                <div class="max-w-5xl mx-auto">
                    <h2 class="mb-8 text-xs font-bold uppercase tracking-widest text-primary dark:text-accent">Featured</h2>
                    <FeaturedPost post={featuredPost} categories={categoryMap.get(featuredPost.data.id) || []} />
                </div>
            </section>
        )}

        {/* Latest articles grid */}
        {latestPosts.length > 0 && (
            <section class="px-4 pb-12 sm:px-8 sm:pb-16">
                <div class="max-w-5xl mx-auto">
                    <h2 class="mb-8 text-xs font-bold uppercase tracking-widest text-primary dark:text-accent">Latest Articles</h2>
                    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                        {latestPosts.map((post) => (
                            <PostCard post={post} categories={categoryMap.get(post.data.id) || []} />
                        ))}
                    </div>
                    <div class="mt-8 text-right">
                        <a
                            class="text-sm font-bold text-primary hover:text-secondary dark:text-accent dark:hover:text-white transition-colors duration-300"
                            href="/posts"
                        >
                            View all articles &rarr;
                        </a>
                    </div>
                </div>
            </section>
        )

    </main>
</Base>
