---
/**
 * Hero Banner block for Portable Text.
 *
 * Everything is loaded from an EmDash section (editable in the admin):
 *   - Section description → label (small uppercase text)
 *   - Section title → heading
 *   - Section content → body text blocks + optional image block
 *
 * If the section content contains an image block (_type: "image"),
 * it's extracted and rendered as the sidebar image. The remaining
 * blocks become the body text. This way the image is editable
 * through the section's content editor.
 *
 * Block data shape:
 * {
 *   _type: "heroBanner",
 *   sectionSlug: "contact-hero"
 * }
 */
import { getSection } from 'emdash';
import { PortableText } from 'emdash/ui';

interface Props {
    node: {
        sectionSlug?: string;
    };
}

const { node } = Astro.props;

let label: string | undefined;
let heading: string | undefined;
let bodyBlocks: any[] = [];
let imageUrl: string | undefined;
let imageAlt = '';

if (node.sectionSlug) {
    const section = await getSection(node.sectionSlug);
    if (section) {
        label = section.description || undefined;
        heading = section.title || undefined;

        // Split content: extract image blocks, keep the rest as body
        for (const block of (section.content || [])) {
            if (block._type === 'image') {
                const asset = block.asset;
                if (asset?.url) {
                    imageUrl = asset.url;
                } else if (asset?._ref) {
                    imageUrl = `/_emdash/api/media/file/${asset._ref}`;
                }
                imageAlt = block.alt || heading || '';
            } else {
                bodyBlocks.push(block);
            }
        }
    }
}
---

<section class="not-prose px-4 py-10 sm:px-8 sm:py-14 bg-surface dark:bg-[#1e1b19]/50 border-b border-slate-200 dark:border-[#2a2623]">
    <div class:list={["max-w-5xl mx-auto", imageUrl ? "grid md:grid-cols-[1fr_250px] gap-8 items-center" : ""]}>
        <div>
            {label && (
                <span class="text-xs font-bold uppercase tracking-widest text-primary dark:text-accent">{label}</span>
            )}
            {heading && (
                <h2 class="mt-2 text-2xl font-extrabold text-slate-950 dark:text-slate-100">{heading}</h2>
            )}
            {bodyBlocks.length > 0 && (
                <div class="mt-3 text-base sm:text-lg leading-relaxed text-slate-700 dark:text-slate-300 [&_a]:text-primary [&_a]:hover:text-secondary dark:[&_a]:text-accent dark:[&_a]:hover:text-white [&_a]:transition [&_a]:duration-300 [&_a]:underline [&_a]:underline-offset-2 [&_a]:decoration-1 [&_p:empty]:h-[1em]">
                    <PortableText value={bodyBlocks} />
                </div>
            )}
        </div>
        {imageUrl && (
            <img
                src={imageUrl}
                alt={imageAlt}
                class="hidden md:block rounded-lg w-full shadow-card-hover"
                loading="eager"
                width="250"
                height="250"
            />
        )}
    </div>
</section>
