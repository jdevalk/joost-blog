---
/**
 * Form block for Portable Text.
 * Fetches form definition and renders it inline.
 */
interface Props {
    node: { formId: string };
    value: { formId: string };
}

const props = Astro.props;
const formId = (props.value || props.node)?.formId;

// Fetch form definition server-side
const response = await fetch(
    new URL("/_emdash/api/plugins/emdash-forms/definition", Astro.url),
    {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ id: formId }),
    }
);

const formData = response.ok ? await response.json() : null;
const form = formData?.data;
---

{form && form.status === "active" ? (
    <form
        class="not-prose mt-6 mb-10 space-y-5"
        method="POST"
        action="/_emdash/api/plugins/emdash-forms/submit"
        data-form-id={formId}
    >
        {form.pages.map((page: any) =>
            page.fields.map((field: any) => (
                <div>
                    {field.type !== "hidden" && (
                        <label
                            for={`${formId}-${field.name}`}
                            class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5"
                        >
                            {field.label}
                            {field.required && <span class="text-red-500"> *</span>}
                        </label>
                    )}
                    {["text", "email", "tel", "url", "number", "date"].includes(field.type) && (
                        <input
                            type={field.type}
                            id={`${formId}-${field.name}`}
                            name={field.name}
                            placeholder={field.placeholder}
                            required={field.required}
                            class="w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-slate-900 placeholder-slate-400 transition-colors focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none dark:border-slate-600 dark:bg-[#1e1b19] dark:text-slate-100 dark:placeholder-slate-500 dark:focus:border-accent dark:focus:ring-accent/20"
                        />
                    )}
                    {field.type === "textarea" && (
                        <textarea
                            id={`${formId}-${field.name}`}
                            name={field.name}
                            placeholder={field.placeholder}
                            required={field.required}
                            rows="6"
                            class="w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-slate-900 placeholder-slate-400 transition-colors focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none dark:border-slate-600 dark:bg-[#1e1b19] dark:text-slate-100 dark:placeholder-slate-500 dark:focus:border-accent dark:focus:ring-accent/20 resize-y"
                        ></textarea>
                    )}
                </div>
            ))
        )}

        {form.settings.spamProtection === "honeypot" && (
            <div style="position:absolute;left:-9999px;" aria-hidden="true">
                <label for={`${formId}-_hp`}>Leave blank</label>
                <input type="text" id={`${formId}-_hp`} name="_hp" tabindex="-1" autocomplete="off" />
            </div>
        )}

        <input type="hidden" name="formId" value={formId} />

        <div>
            <button
                type="submit"
                class="inline-flex items-center gap-2 rounded-lg bg-primary px-6 py-2.5 text-sm font-semibold text-white transition-all hover:bg-secondary hover:shadow-button focus:ring-2 focus:ring-primary/20 focus:outline-none disabled:opacity-50 disabled:cursor-not-allowed"
            >
                {form.settings.submitLabel || "Submit"}
            </button>
        </div>

        <div class="ec-form-status" data-form-status aria-live="polite"></div>
    </form>
) : null}

<script>
    import { initForms } from "@emdash-cms/plugin-forms/client";
    initForms();
</script>
