---
import { getMenu, getSiteSettings } from "emdash";
import ThemeToggle from './ThemeToggle.astro';

const settings = await getSiteSettings();
const primaryMenu = await getMenu('primary');

const { class: className, variant } = Astro.props;
const isDark = variant === 'dark';
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(url: string) {
    const normalized = url.replace(/\/$/, '') || '/';
    if (normalized === '/') return currentPath === '/';
    return currentPath === normalized || currentPath.startsWith(normalized + '/');
}
---

<header class:list={['fixed top-0 left-0 right-0 z-50 flex items-center justify-between gap-4 px-4 py-3 sm:px-8 sm:py-4 transition-colors duration-300', isDark ? '' : 'bg-[#4a1525]/90 backdrop-blur-lg border-b border-white/10 text-white dark:bg-[#1c1614]/90 dark:border-[#c9506a]/10', className]}>
    <a class:list={["text-lg font-extrabold tracking-tight sm:text-xl", isDark ? "text-white" : "text-white dark:text-slate-100"]} href="/">
        {settings.title}
    </a>
    <div class="flex items-center gap-1 sm:gap-2">
        {primaryMenu?.items && primaryMenu.items.length > 0 && (
            <nav class="hidden md:flex items-center gap-1" aria-label="Primary navigation">
                {primaryMenu.items.map((item) => (
                    <a
                        class:list={[
                            "relative rounded-md px-3 py-1.5 text-sm font-medium transition duration-300",
                            isActive(item.url)
                                ? (isDark ? "text-white bg-white/20" : "text-white bg-white/20 dark:text-white dark:bg-slate-700/70")
                                : (isDark ? "text-white/90 hover:text-white hover:bg-white/15" : "text-white/90 hover:text-white hover:bg-white/15 dark:text-slate-400 dark:hover:text-white dark:hover:bg-slate-700/50"),
                        ]}
                        href={item.url}
                        aria-current={isActive(item.url) ? "page" : undefined}
                    >
                        {item.label}
                    </a>
                ))}
            </nav>
        )}
        <button
            class:list={["inline-flex items-center justify-center w-9 h-9 rounded-md transition cursor-pointer search-open", isDark ? "text-white/80 hover:text-white hover:bg-white/15" : "text-white/80 hover:text-white hover:bg-white/15 dark:text-slate-400 dark:hover:text-white dark:hover:bg-slate-700/50"]}
            aria-label="Search"
            type="button"
        >
            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24"
                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8" />
                <path d="m21 21-4.3-4.3" />
            </svg>
        </button>
        <ThemeToggle variant={isDark ? 'dark' : 'light'} />
        {/* Mobile nav */}
        {primaryMenu?.items && primaryMenu.items.length > 0 && (
            <nav class="relative md:hidden" aria-label="Mobile navigation">
                <button
                    class:list={["relative z-20 inline-flex items-center justify-center w-9 h-9 rounded-md transition cursor-pointer menu-toggle", isDark ? "text-white/80 hover:text-white hover:bg-white/15" : "text-white/80 hover:text-white hover:bg-white/15 dark:text-slate-400 dark:hover:text-white dark:hover:bg-slate-700/50"]}
                    aria-label="Open Menu"
                    aria-expanded="false"
                    aria-controls="menu-items"
                >
                    <span class="relative w-1 h-1 bg-current rounded-full menu-toggle-icon" />
                </button>
                <ul id="menu-items" class="absolute z-10 px-8 pt-16 pb-10 border menu -top-3 -right-3 border-slate-200/60 bg-white/90 dark:border-slate-600/40 dark:bg-slate-800/95 sm:px-12 sm:pt-20 sm:pb-16">
                    {primaryMenu.items.map((item) => (
                        <li class="mb-1 border-b border-slate-200/70 dark:border-slate-600/70">
                            <a
                                class:list={[
                                    "relative block py-1.5 pr-6 text-base font-semibold transition duration-300",
                                    isActive(item.url)
                                        ? "text-primary dark:text-accent"
                                        : "text-slate-700 hover:text-primary dark:text-slate-200 dark:hover:text-accent",
                                ]}
                                href={item.url}
                                aria-current={isActive(item.url) ? "page" : undefined}
                            >
                                {item.label}
                            </a>
                        </li>
                    ))}
                </ul>
            </nav>
        )}
    </div>
</header>

{/* Search modal */}
<div id="search-modal" class="fixed inset-0 z-[100] hidden" role="dialog" aria-modal="true" aria-label="Search">
    <div class="fixed inset-0 bg-black/50 backdrop-blur-sm search-backdrop"></div>
    <div class="fixed inset-x-0 top-0 mx-auto max-w-2xl p-4 pt-[max(1rem,env(safe-area-inset-top))] sm:pt-24">
        <div class="rounded-xl bg-white shadow-2xl dark:bg-[#1e1b19] border border-slate-200 dark:border-[#2a2623] overflow-hidden">
            <div class="flex items-center px-4 border-b border-slate-200 dark:border-[#2a2623]">
                <svg class="w-5 h-5 text-slate-400 dark:text-slate-500 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                <input
                    id="search-input"
                    type="text"
                    placeholder="Search posts and pages..."
                    autocomplete="off"
                    class="w-full bg-transparent px-3 py-3.5 text-base text-slate-900 dark:text-slate-100 placeholder-slate-400 dark:placeholder-slate-500 outline-none"
                />
            </div>
            <div id="search-results" class="max-h-[60vh] overflow-y-auto">
                <div id="search-empty" class="hidden px-4 py-8 text-center text-sm text-slate-400 dark:text-slate-500">No results found</div>
            </div>
            <div class="border-t border-slate-200 dark:border-[#2a2623] px-4 py-2.5 flex items-center justify-between text-xs text-slate-400 dark:text-slate-500">
                <span><kbd class="rounded bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 font-mono text-[10px]">Esc</kbd> to close</span>
                <span><kbd class="rounded bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 font-mono text-[10px]">⌘</kbd><kbd class="rounded bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 font-mono text-[10px] ml-0.5">K</kbd> to search</span>
            </div>
        </div>
    </div>
</div>

<style>
    @reference "tailwindcss";

    header.header-scrolled {
        background: rgba(74, 21, 37, 0.9);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .menu {
        width: calc(100vw - 0.5rem);
        max-width: 18.75rem;
        border-radius: 16px;
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
        backdrop-filter: blur(12px);
        opacity: 0;
        transform: scale(0.6);
        transform-origin: top right;
        transition:
            transform 0.2s cubic-bezier(0.4, 0, 0.2, 1) 0.3s,
            opacity 0.25s cubic-bezier(0.4, 0, 0.2, 1) 0.25s,
            visibility 0s 0.5s;
        visibility: hidden;
    }
    .menu.is-visible {
        opacity: 1;
        transform: scale(1);
        transition:
            transform 0.25s cubic-bezier(0.4, 0, 0.2, 1) 0.25s,
            opacity 0.15s 0.15s,
            visibility 0s 0.25s;
        visibility: visible;
    }
    .menu-toggle-icon {
        transition:
            height 0s 0.25s,
            width 0s 0.25s;
    }
    .menu-toggle-icon.is-active {
        height: 3px;
        width: 3px;
    }
    .menu-toggle-icon:before,
    .menu-toggle-icon:after {
        @apply absolute top-1/2 left-1/2 h-1 w-1 -translate-x-1/2 -translate-y-1/2 rounded-full bg-current;
        content: '';
        transition:
            width 0.25s cubic-bezier(0.4, 0, 0.2, 1),
            height 0s 0.25s,
            translate 0s 0.25s,
            rotate 0s 0.25s,
            margin 0.25s cubic-bezier(0.4, 0, 0.2, 1) 0.25s;
    }
    .menu-toggle-icon:before {
        @apply -ml-2;
    }
    .menu-toggle-icon:after {
        @apply ml-2;
    }
    .menu-toggle-icon.is-active:before,
    .menu-toggle-icon.is-active:after {
        @apply ml-0 w-5 rounded-md;
        height: 3px;
        transition:
            margin 0.25s cubic-bezier(0.4, 0, 0.2, 1),
            height 0s 0.25s,
            translate 0s 0.25s,
            rotate 0s 0.25s,
            width 0.25s cubic-bezier(0.4, 0, 0.2, 1) 0.25s;
    }
    .menu-toggle-icon.is-active:before {
        @apply rotate-45;
    }
    .menu-toggle-icon.is-active:after {
        @apply -rotate-45;
    }

</style>

<script>
    function menuToggle() {
        const menu = document.querySelector('.menu');
        const menuToggleBtn = document.querySelector('.menu-toggle');
        const menuToggleIcon = document.querySelector('.menu-toggle-icon');
        menuToggleBtn?.addEventListener('click', () => {
            const isMenuExpanded = menuToggleBtn.getAttribute('aria-expanded') === 'true';
            menuToggleBtn.setAttribute('aria-expanded', isMenuExpanded ? 'false' : 'true');
            menuToggleBtn.setAttribute('aria-label', isMenuExpanded ? 'Open Menu' : 'Close Menu');
            menuToggleIcon?.classList.toggle('is-active');
            menu?.classList.toggle('is-visible');
        });
    }
    menuToggle();
    document.addEventListener('astro:after-swap', menuToggle);

    function headerScroll() {
        const header = document.querySelector('header');
        if (!header) return;
        const handler = () => {
            if (window.scrollY > 60) {
                header.classList.add('header-scrolled');
            } else {
                header.classList.remove('header-scrolled');
            }
        };
        window.addEventListener('scroll', handler, { passive: true });
        handler();
    }
    headerScroll();
    document.addEventListener('astro:after-swap', headerScroll);

    function searchModal() {
        const modal = document.getElementById('search-modal');
        const openBtns = document.querySelectorAll('.search-open');
        const backdrop = modal?.querySelector('.search-backdrop');
        const input = document.getElementById('search-input') as HTMLInputElement | null;
        const resultsContainer = document.getElementById('search-results');
        const emptyMsg = document.getElementById('search-empty');
        if (!modal || !input || !resultsContainer) return;

        let debounceTimer: ReturnType<typeof setTimeout>;
        let abortController: AbortController | null = null;
        let activeIndex = -1;

        function open() {
            modal!.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
            requestAnimationFrame(() => input!.focus());
        }

        function close() {
            modal!.classList.add('hidden');
            document.body.style.overflow = '';
            input!.value = '';
            resultsContainer!.querySelectorAll('a').forEach(a => a.remove());
            emptyMsg!.classList.add('hidden');
            activeIndex = -1;
        }

        function updateActive() {
            const links = resultsContainer!.querySelectorAll('a');
            links.forEach((a, i) => {
                a.classList.toggle('bg-slate-100', i === activeIndex);
                a.classList.toggle('dark:bg-[#2a2623]', i === activeIndex);
            });
        }

        async function doSearch(query: string) {
            abortController?.abort();
            if (query.length < 2) {
                resultsContainer!.querySelectorAll('a').forEach(a => a.remove());
                emptyMsg!.classList.add('hidden');
                return;
            }

            abortController = new AbortController();
            try {
                const res = await fetch(`/api/search?q=${encodeURIComponent(query)}&collections=posts,pages&limit=10`, {
                    signal: abortController.signal,
                });
                const json = await res.json();
                const items = json.data?.items || [];

                resultsContainer!.querySelectorAll('a').forEach(a => a.remove());
                activeIndex = -1;

                if (items.length === 0) {
                    emptyMsg!.classList.remove('hidden');
                    return;
                }

                emptyMsg!.classList.add('hidden');
                for (const item of items) {
                    const href = item.collection === 'posts' ? `/posts/${item.slug || item.id}` : `/${item.slug || item.id}`;
                    const a = document.createElement('a');
                    a.href = href;
                    a.className = 'block px-4 py-3 hover:bg-slate-100 dark:hover:bg-[#2a2623] transition-colors';
                    a.innerHTML = `
                        <div class="text-sm font-semibold text-slate-900 dark:text-slate-100">${item.title || 'Untitled'}</div>
                        ${item.excerpt ? `<div class="mt-0.5 text-xs text-slate-500 dark:text-slate-400 line-clamp-1">${item.excerpt}</div>` : ''}
                    `;
                    resultsContainer!.appendChild(a);
                }
            } catch (e) {
                if ((e as Error).name !== 'AbortError') console.error('Search error:', e);
            }
        }

        input.addEventListener('input', () => {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(() => doSearch(input!.value.trim()), 200);
        });

        input.addEventListener('keydown', (e) => {
            const links = resultsContainer!.querySelectorAll('a');
            if (e.key === 'ArrowDown') {
                e.preventDefault();
                activeIndex = Math.min(activeIndex + 1, links.length - 1);
                updateActive();
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                activeIndex = Math.max(activeIndex - 1, -1);
                updateActive();
            } else if (e.key === 'Enter' && activeIndex >= 0 && links[activeIndex]) {
                e.preventDefault();
                (links[activeIndex] as HTMLAnchorElement).click();
            }
        });

        openBtns.forEach(btn => btn.addEventListener('click', open));
        backdrop?.addEventListener('click', close);

        document.addEventListener('keydown', (e) => {
            if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
                e.preventDefault();
                modal!.classList.contains('hidden') ? open() : close();
            }
            if (e.key === 'Escape' && !modal!.classList.contains('hidden')) {
                close();
            }
        });
    }
    searchModal();
    document.addEventListener('astro:after-swap', searchModal);
</script>
