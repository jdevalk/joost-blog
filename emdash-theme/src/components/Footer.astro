---
import { getMenu, getSiteSettings, getSection } from "emdash";

const settings = await getSiteSettings();
const primaryMenu = await getMenu('primary');
const currentYear = new Date().getFullYear();
const bioSection = await getSection('footer-bio');

// Extract bio text and social links from section content
let bioHtml = '';
let socialLinks: { platform: string; url: string; label: string }[] = [];

if (bioSection) {
    for (const block of (bioSection.content || [])) {
        if (block._type === 'block') {
            const markDefs = block.markDefs || [];
            let text = '';
            for (const child of (block.children || [])) {
                if (child.marks?.length > 0) {
                    const linkDef = markDefs.find((m: any) => child.marks.includes(m._key));
                    if (linkDef) {
                        text += `<a href="${linkDef.href}"${linkDef.blank ? ' target="_blank" rel="noopener noreferrer"' : ''}>${child.text}</a>`;
                    } else {
                        text += child.text;
                    }
                } else {
                    text += child.text;
                }
            }
            bioHtml = text;
        } else if (block._type === 'socialLinks' && block.links) {
            socialLinks = block.links;
        }
    }
}

