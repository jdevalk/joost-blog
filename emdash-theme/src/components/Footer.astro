---

<footer class="border-t border-[#7a1830]/10 bg-[#4a1525] px-4 py-10 text-white dark:border-[#c9506a]/10 dark:bg-[#1c1614] sm:px-8 sm:py-14">
    <div class="mx-auto max-w-5xl">
        <div class="grid gap-8 sm:grid-cols-3">
            {/* Bio column */}
            <div class="sm:col-span-2">
                <p class="text-lg font-extrabold tracking-tight text-white dark:text-slate-100">{bioSection?.title || settings.title}</p>
                {bioHtml ? (
                    <p class="mt-2 max-w-md text-sm leading-relaxed text-white/85 dark:text-slate-400 [&_a]:text-accent [&_a]:underline [&_a]:underline-offset-2 [&_a:hover]:text-white [&_a]:transition" set:html={bioHtml} />
                ) : settings.tagline && (
                    <p class="mt-2 max-w-md text-sm leading-relaxed text-white/85 dark:text-slate-400">
                        {settings.tagline}
                    </p>
                )}
                {socialLinks.length > 0 && (
                    <div class="mt-4 flex flex-wrap gap-2">
                        {socialLinks.map((link) => (
                            <a
                                href={link.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label={link.label}
                                class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-white/80 transition duration-300 hover:bg-white/20 hover:text-white"
                            >
                                <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" set:html={socialIcons[link.platform] || ''} />
                            </a>
                        ))}
                    </div>
                )}
            </div>

            {/* Navigation column */}
            {primaryMenu?.items && primaryMenu.items.length > 0 && (
                <div>
                    <p class="text-xs font-bold uppercase tracking-widest text-white/70 dark:text-accent">Navigate</p>
                    <ul class="mt-3 space-y-2">
                        {primaryMenu.items.map((item) => (
                            <li>
                                <a href={item.url} class="text-sm text-white/85 hover:text-white dark:text-slate-400 dark:hover:text-accent transition-colors duration-300">
                                    {item.label}
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>
            )}
        </div>

        <div class="mt-10 border-t border-white/10 pt-6 dark:border-slate-700">
            <p class="text-xs text-white/60 dark:text-slate-500">
                &copy; {currentYear} {settings.title}. Built with Astro &amp; EmDash.
            </p>
        </div>
    </div>
</footer>
