---
import { Image } from "emdash/ui";
import { getReadingTime } from "../utils/reading-time";

interface Props {
    post: any;
    categories?: { label: string; slug: string }[];
}

const { post, categories = [] } = Astro.props;
const readingTime = getReadingTime(post.data.content);
const publishedAt = post.data.publishedAt ?? null;
const formattedDate = publishedAt?.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<article class="group flex flex-col overflow-hidden rounded-lg border border-slate-200 bg-white shadow-card transition duration-300 hover:shadow-card-hover hover:-translate-y-0.5 dark:border-[#2a2623] dark:bg-[#1e1b19]/50">
    {post.data.featured_image && (
        <a href={`/posts/${post.id}`} aria-label={post.data.title} class="block h-44 overflow-hidden">
            <Image
                image={post.data.featured_image}
                class="w-full h-full object-cover object-top"
            />
        </a>
    )}
    <div class="flex flex-1 flex-col p-5">
        {categories.length > 0 && (
            <div class="mb-2 flex flex-wrap gap-1.5">
                {categories.map((cat) => (
                    <a href={`/categories/${cat.slug}`} class="inline-block rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-semibold text-primary hover:bg-primary/20 dark:bg-accent/10 dark:text-accent dark:hover:bg-accent/20 transition-colors duration-300">{cat.label}</a>
                ))}
            </div>
        )}
        <h2 class="text-xl font-extrabold leading-snug text-slate-900 dark:text-slate-100">
            <a href={`/posts/${post.id}`} class="hover:text-primary dark:hover:text-accent transition-colors duration-300">{post.data.title}</a>
        </h2>
        {post.data.excerpt && (
            <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400 line-clamp-2">{post.data.excerpt}</p>
        )}
        {formattedDate && (
            <p class="mt-auto pt-4 text-xs text-slate-500 dark:text-slate-400">
                <time datetime={publishedAt?.toISOString()}>{formattedDate}</time>{readingTime && <Fragment>&ensp;·&ensp;{readingTime} min read</Fragment>}
            </p>
        )}
    </div>
</article>
