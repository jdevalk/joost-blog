{
    "name": "joost-blog",
    "type": "module",
    "version": "1.0.0",
    "scripts": {
        "predev": "node --env-file-if-exists=.env scripts/generate-nlweb-index.mjs",
        "dev": "astro dev",
        "start": "astro dev",
        "generate-images": "node --env-file-if-exists=.env scripts/generate-featured-images.mjs",
        "generate:og": "node scripts/generate-og-images.mjs",
        "fetch-transcripts": "node scripts/fetch-transcripts.mjs",
        "images": "node --env-file-if-exists=.env scripts/image-manager.mjs",
        "build": "node scripts/generate-draft-slugs.mjs && node scripts/check-src.mjs && astro build",
        "preview": "astro preview",
        "astro": "astro"
    },
    "dependencies": {
        "@astro-community/astro-embed-youtube": "^0.5.10",
        "@astrojs/mdx": "^5.0.1",
        "@astrojs/rss": "^4.0.17",
        "@astrojs/sitemap": "^3.7.1",
        "@fontsource-variable/fraunces": "^5.2.9",
        "@fontsource-variable/inter": "^5.2.8",
        "@fontsource-variable/mona-sans": "^5.2.8",
        "@fontsource/jetbrains-mono": "^5.2.8",
        "@jdevalk/astro-seo-graph": "^1.2.0",
        "@jdevalk/seo-graph-core": "^0.6.1",
        "@tailwindcss/vite": "^4.1.16",
        "astro": "^6.1.6",
        "astro-pagefind": "^1.8.5",
        "gray-matter": "^4.0.3",
        "markdown-it": "^14.1.1",
        "sanitize-html": "^2.17.2",
        "satori": "^0.24.1",
        "satori-html": "^0.3.2",
        "sharp": "^0.34.5",
        "tailwindcss": "^4.1.16",
        "youtube-caption-extractor": "^1.9.1"
    },
    "devDependencies": {
        "@tailwindcss/typography": "^0.5.19",
        "playwright": "^1.59.1",
        "prettier": "^3.6.2",
        "prettier-plugin-astro": "^0.14.1",
        "prettier-plugin-tailwindcss": "^0.6.14"
    }
}
