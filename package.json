{
    "name": "joost-blog",
    "type": "module",
    "version": "1.0.0",
    "scripts": {
        "predev": "node --env-file-if-exists=.env scripts/generate-nlweb-index.mjs",
        "dev": "astro dev",
        "start": "astro dev",
        "generate-images": "node --env-file-if-exists=.env scripts/generate-featured-images.mjs",
        "generate:og": "node scripts/generate-og-images.mjs",
        "fetch-transcripts": "node scripts/fetch-transcripts.mjs",
        "ai-roi": "node --env-file-if-exists=.env scripts/ai-crawler-roi.mjs",
        "format": "prettier --write 'src/**/*.{ts,tsx,astro}'",
        "format:check": "prettier --check 'src/**/*.{ts,tsx,astro}'",
        "sign:ard": "node scripts/sign-ard-catalog.mjs",
        "check:ard": "node scripts/sign-ard-catalog.mjs --check",
        "build": "pnpm format:check && node scripts/generate-draft-slugs.mjs && node scripts/generate-agent-skills.mjs && node scripts/check-src.mjs && node scripts/sign-ard-catalog.mjs --check && astro build",
        "preview": "astro preview",
        "astro": "astro"
    },
    "dependencies": {
        "@astro-community/astro-embed-youtube": "^0.5.10",
        "@astrojs/mdx": "^5.0.4",
        "@astrojs/rss": "^4.0.18",
        "@astrojs/sitemap": "^3.7.3",
        "@jdevalk/astro-seo-graph": "^1.4.1",
        "@jdevalk/seo-graph-core": "^0.6.2",
        "@tailwindcss/vite": "^4.2.4",
        "astro": "^6.2.2",
        "astro-pagefind": "^1.8.6",
        "gray-matter": "^4.0.3",
        "sanitize-html": "^2.17.3",
        "sharp": "^0.34.5",
        "tailwindcss": "^4.2.4",
        "youtube-caption-extractor": "^1.9.1"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.9",
        "@tailwindcss/typography": "^0.5.19",
        "playwright": "^1.59.1",
        "prettier": "^3.8.3",
        "prettier-plugin-astro": "^0.14.1",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "typescript": "^6.0.3"
    }
}
