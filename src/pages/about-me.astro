---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SchemaGraph from '../components/SchemaGraph.astro';
import SpChrome from '../components/SpChrome.astro';
import SpFooter from '../components/SpFooter.astro';
import type { SchemaPageContext } from '../utils/schema';
import { canonicalUrl } from '../utils/schema/constants';

const allVideos = await getCollection('videos');
const recentVideos = allVideos
    .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())
    .slice(0, 4);

function formatDuration(isoDuration: string | undefined): string | null {
    if (!isoDuration) return null;
    const match = isoDuration.match(/PT(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?/);
    if (!match) return null;
    const h = parseInt(match[1] || '0');
    const m = parseInt(match[2] || '0');
    const s = parseInt(match[3] || '0');
    return h > 0
        ? `${h}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`
        : `${m}:${String(s).padStart(2, '0')}`;
}

const title = 'About Joost de Valk';
const description = 'Internet entrepreneur, founder of Yoast, WordPress contributor, and digital marketing consultant from the Netherlands.';

const pageContext: SchemaPageContext = {
    pageType: 'about',
    canonicalUrl: canonicalUrl('/about-me/'),
    title,
    description
};
---

<BaseLayout title={title} description={description}>
    <SchemaGraph pageContext={pageContext} />
    <div slot="header" />
    <div slot="footer" />

    <div class="sp-root sp-blocks sp-about">
        <SpChrome issue="ABOUT · JOOST DE VALK" />

        <section class="sp-about-hero">
            <div class="sp-about-hero-grid">
                <div>
                    <div class="sp-about-kicker">
                        <span>§ About me</span><span class="rule"></span><span>Wijchen · NL</span>
                    </div>
                    <h1 class="sp-about-title">
                        Hi, I'm <em>Joost</em> de Valk.
                    </h1>
                    <p class="sp-about-lede">
                        Internet entrepreneur from the Netherlands. I'm married to <a href="https://marieke.com/">Marieke</a>;
                        we have four children and live in Wijchen.
                    </p>
                    <p class="sp-about-sub">
                        Long history in open source and digital marketing. Founded Yoast and the
                        Yoast SEO plugin for WordPress. Increasingly contributing to <a href="https://emdash.ai/">EmDash</a>
                        and playing with Astro.
                    </p>
                </div>
                <div class="sp-about-portrait">
                    <img src="/images/joost-de-valk-profile-picture.jpg" alt="Joost de Valk" width="400" height="500" />
                    <div class="sp-about-portrait-cap">
                        Portrait · Wijchen, 2025<br />
                        Photo by Marieke
                    </div>
                </div>
            </div>
        </section>

        <section class="sp-about-story">
            <div class="sp-about-story-head">
                <div class="kicker">§ 01 · Background</div>
                <h2>My story.</h2>
            </div>
            <div class="sp-about-story-grid">
                <article class="sp-about-prose" data-pagefind-body>
                    <p>
                        I've worn a couple of different hats in my time at Yoast. First, for
                        almost <em>nine years</em>, I was the CEO. Then I became Chief Product Officer
                        when my wife <a href="https://marieke.com/">Marieke</a> took over as CEO. We sold Yoast to Newfold Digital
                        in August of 2021, after which I became Head of WordPress Strategy at Newfold
                        for a while. I then came back for a six-month stint as interim CTO (because
                        they were suddenly without one) in 2022&ndash;2023. I finally left the company
                        in April 2023.
                    </p>
                    <p>
                        When we left Yoast, Marieke and I started investing through our company,
                        <a href="https://emilia.capital/">Emilia Capital</a>. We invest in companies that play at least partly in
                        the digital space &mdash; and often in WordPress. Because of that, I'm
                        on the board of <a href="https://patchstack.com/">PatchStack</a> and <a href="https://atarim.io/">Atarim</a>. We also started our own
                        new company; we're working hard on <a href="https://progressplanner.com/">Progress Planner</a>.
                    </p>
                    <p>
                        I founded Yoast in 2010 after working as a digital marketing consultant in
                        several different companies. I've worked on some of the biggest SEO
                        projects in the world, including the <a href="https://www.theguardian.com/info/developer-blog/2014/feb/18/how-the-guardian-successfully-moved-domain">Guardian's site migration from
                        .co.uk to theguardian.com</a>.
                    </p>
                    <p>
                        In my spare time, I can often be found coaching kids' soccer at
                        <a href="https://svawc.nl/">AWC</a>, where I'm also a board member. This is also why I started
                        working on <a href="https://rondo.club/">Rondo</a>. On holidays, Marieke and I love spending time in our
                        <a href="https://limonaia.house/">holiday home in Tuscany</a> or travelling to other places in the world.
                    </p>
                </article>
                <aside class="sp-about-timeline">
                    <div class="m-lbl">Timeline</div>
                    <ol>
                        <li><span class="y">2010</span><span class="e">Founded Yoast</span></li>
                        <li><span class="y">2019</span><span class="e">Stepped down as CEO; Marieke takes over</span></li>
                        <li><span class="y">2021</span><span class="e">Sold Yoast to Newfold Digital</span></li>
                        <li><span class="y">2022</span><span class="e">Interim CTO for six months</span></li>
                        <li><span class="y">2023</span><span class="e">Left Newfold; started Emilia Capital</span></li>
                        <li><span class="y">2024</span><span class="e">Launched Progress Planner</span></li>
                        <li><span class="y">2025</span><span class="e">Building Rondo for clubs</span></li>
                        <li><span class="y">Now</span><span class="e">Writing here; contributing to EmDash &amp; Astro</span></li>
                    </ol>
                </aside>
            </div>
        </section>

        <section class="sp-about-social">
            <div class="sp-about-social-head">
                <div class="kicker">§ 02 · Connect</div>
                <h3>Find me online.</h3>
            </div>
            <div class="sp-about-social-grid">
                {[
                    {n:'GitHub', h:'@jdevalk', url:'https://github.com/jdevalk'},
                    {n:'LinkedIn', h:'in/jdevalk', url:'https://www.linkedin.com/in/jdevalk/'},
                    {n:'Bluesky', h:'@joost.blog', url:'https://bsky.app/profile/joost.blog'},
                    {n:'Threads', h:'@joostdevalk', url:'https://www.threads.net/@joostdevalk'},
                    {n:'WordPress', h:'joostdevalk', url:'https://profiles.wordpress.org/joostdevalk'},
                    {n:'Instagram', h:'@joostdevalk', url:'https://www.instagram.com/joostdevalk'},
                ].map(({n, h, url}) => (
                    <a href={url} class="sp-about-social-card" target="_blank" rel="noopener noreferrer">
                        <div class="n">{n}</div>
                        <div class="h">{h}</div>
                        <div class="arr">&rarr;</div>
                    </a>
                ))}
            </div>
        </section>

        <section class="sp-about-speaking">
            <div class="sp-about-story-head">
                <div class="kicker">§ 03 · On stage</div>
                <h2>Recent speaking engagements.</h2>
            </div>
            <div class="sp-about-speaking-grid">
                {recentVideos.map(v => {
                    const dur = formatDuration(v.data.duration);
                    const month = new Intl.DateTimeFormat('en', {month: 'short', year: 'numeric'}).format(new Date(v.data.publishDate)).toUpperCase();
                    return (
                        <a href={`/videos/${v.id}/`} class="sp-about-talk">
                            <div class="sp-about-talk-thumb">
                                <div class="play">&#9654;</div>
                                {dur && <div class="dur">{dur}</div>}
                            </div>
                            <div class="sp-about-talk-meta">{month}</div>
                            <h4>{v.data.title}</h4>
                        </a>
                    );
                })}
            </div>
            <div class="sp-about-speaking-foot">
                <a href="/videos/">See all videos in the archive &rarr;</a>
            </div>
        </section>

        <section class="sp-about-build">
            <div class="sp-about-build-grid">
                <div>
                    <div class="kicker">§ 04 · Code</div>
                    <h2>What I build.</h2>
                    <p>
                        From WordPress plugins to SaaS products, I'm always working on something.
                        The workshop page has the current list &mdash; npm packages, plugins, and a
                        featured project or two.
                    </p>
                </div>
                <div class="sp-about-build-cta">
                    <a href="/code/" class="primary">See my code &rarr;</a>
                    <a href="/blog/" class="ghost">Read the blog &rarr;</a>
                </div>
            </div>
        </section>

        <SpFooter />
    </div>
</BaseLayout>
