<script is:inline>
// htmlLegendPlugin - custom plugin for clickable legends
const htmlLegendPlugin = {
    id: 'htmlLegend',
    afterUpdate(chart, args, options) {
        const container = document.getElementById(options.containerID);
        if (!container) return;

        // Remove old legend items
        while (container.firstChild) {
            container.firstChild.remove();
        }

        const ul = document.createElement('ul');
        ul.style.display = 'flex';
        ul.style.flexWrap = 'wrap';
        ul.style.gap = '8px';
        ul.style.listStyle = 'none';
        ul.style.padding = '10px 0';
        ul.style.margin = '0';

        const items = chart.options.plugins.legend.labels.generateLabels
            ? chart.options.plugins.legend.labels.generateLabels(chart)
            : chart.legend?.legendItems || [];

        // For pie charts, generate from data labels
        let legendItems;
        if (chart.config.type === 'pie') {
            legendItems = chart.data.labels.map(function(label, i) {
                var meta = chart.getDatasetMeta(0);
                var hidden = meta.data[i] ? meta.data[i].hidden : false;
                return {
                    text: label,
                    fillStyle: chart.data.datasets[0].backgroundColor[i],
                    hidden: hidden,
                    index: i
                };
            });
        } else {
            legendItems = chart.data.datasets.map(function(dataset, i) {
                return {
                    text: dataset.label,
                    fillStyle: dataset.backgroundColor,
                    hidden: !chart.isDatasetVisible(i),
                    datasetIndex: i
                };
            });
        }

        legendItems.forEach(function(item) {
            var li = document.createElement('li');
            li.style.display = 'flex';
            li.style.alignItems = 'center';
            li.style.gap = '4px';
            li.style.cursor = 'pointer';
            li.style.fontSize = '13px';
            li.style.opacity = item.hidden ? '0.4' : '1';

            li.addEventListener('click', function() {
                if (chart.config.type === 'pie') {
                    var meta = chart.getDatasetMeta(0);
                    meta.data[item.index].hidden = !meta.data[item.index].hidden;
                } else {
                    chart.setDatasetVisibility(item.datasetIndex, !chart.isDatasetVisible(item.datasetIndex));
                }
                chart.update();
            });

            var colorBox = document.createElement('span');
            colorBox.style.display = 'inline-block';
            colorBox.style.width = '12px';
            colorBox.style.height = '12px';
            colorBox.style.borderRadius = '50%';
            colorBox.style.backgroundColor = item.fillStyle;
            colorBox.style.flexShrink = '0';

            var label = document.createElement('span');
            label.style.textDecoration = item.hidden ? 'line-through' : 'none';
            label.textContent = item.text;

            li.appendChild(colorBox);
            li.appendChild(label);
            ul.appendChild(li);
        });

        container.appendChild(ul);
    }
};

