---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import SchemaGraph from '../components/SchemaGraph.astro';
import type { SchemaPageContext } from '../utils/schema';
import { canonicalUrl } from '../utils/schema/constants';

const title = 'CMS Market Share';
const description = 'Monthly CMS market share data based on the HTTP Archive.';

const pageContext: SchemaPageContext = {
    pageType: 'page',
    canonicalUrl: canonicalUrl('/cms-market-share/'),
    title,
    description
};
---

<BaseLayout title={title} description={description}>
    <SchemaGraph pageContext={pageContext} />
    <div class="relative bg-gradient-to-br from-[#4a1525] via-[#3a1a28] to-[#2e1220] text-white" slot="header">
        <Header variant="dark" />
        <div class="h-[52px] sm:h-[56px]"></div>
        <section class="px-4 py-10 sm:px-8 sm:py-14">
            <div class="max-w-5xl mx-auto">
                <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl">{title}</h1>
            </div>
        </section>
    </div>

    <main class="grow" data-pagefind-body>
        <section class="px-4 py-10 sm:px-8 sm:py-14 bg-surface dark:bg-[#1e1b19]/50 border-b border-slate-200 dark:border-[#2a2623]">
            <div class="max-w-5xl mx-auto">
                <span class="text-xs font-bold uppercase tracking-widest text-primary dark:text-accent">Data Report</span>
                <h2 class="mt-2 text-2xl font-extrabold text-slate-950 dark:text-slate-100">HTTP Archive CMS Data</h2>
                <p class="mt-3 text-base sm:text-lg leading-relaxed text-slate-700 dark:text-slate-300">Based on data from the <a href="https://httparchive.org/" class="text-primary hover:text-secondary dark:text-accent dark:hover:text-white transition duration-300 underline underline-offset-2 decoration-1">HTTP Archive</a>, this report focuses on the CMS market share of the most popular CMSes and related important web (and WordPress) technologies.</p>
                <p class="mt-3 text-base leading-relaxed text-slate-600 dark:text-slate-400">This report does not contain commentary on these numbers. The commentary can be found in posts on my blog in the <a href="/category/market-share-analysis/" class="text-primary hover:text-secondary dark:text-accent dark:hover:text-white transition duration-300 underline underline-offset-2 decoration-1">market share analysis</a> category.</p>
            </div>
        </section>

        <article class="max-w-5xl mx-auto px-4 py-10 sm:px-8 sm:py-14">
            <!-- Section: Most popular CMSes -->
            <section class="mb-16">
                <div class="not-prose mb-6">
                    <span class="text-xs font-bold uppercase tracking-widest text-primary dark:text-accent">Current Data</span>
                    <h2 class="mt-2 text-2xl font-extrabold text-slate-950 dark:text-slate-100" id="most-popular-cmses">Most popular CMSes</h2>
                </div>
                <p class="text-base text-slate-700 dark:text-slate-300 mb-2">Here, you can see the market share of the 20 most popular CMSes as of last month.</p>
                <p class="text-sm text-slate-500 dark:text-slate-400 mb-6">Note: click on names in the legend to remove or re-add them.</p>

                <div class="chart-container pie-chart max-w-[70%] mx-auto">
                    <canvas id="pie_chart_1"></canvas>
                </div>
                <div class="chart-legend" id="legend_container_chart_1"></div>

                <!-- Most popular CMSes over time -->
                <div class="not-prose mt-12 mb-6">
                    <h3 class="text-xl font-extrabold text-slate-950 dark:text-slate-100" id="most-popular-cmses-over-time">Most popular CMSes over time</h3>
                </div>
                <p class="text-base text-slate-700 dark:text-slate-300 mb-2">This shows how the top 10 progressed over the last few years.</p>
                <p class="text-sm text-slate-500 dark:text-slate-400 mb-6">Note: click on the labels of the CMSes to remove them from the chart.</p>

                <div style="height: 400px;">
                    <canvas id="historic_line_chart_2"></canvas>
                </div>
                <div class="chart-legend" id="legend_container_chart_2"></div>

                <!-- Growth rates for the top 10 CMSes -->
                <div class="not-prose mt-12 mb-6">
                    <h3 class="text-xl font-extrabold text-slate-950 dark:text-slate-100" id="cms-growth-rates">Growth rates for the top 10 CMSes</h3>
                </div>
                <p class="text-base text-slate-700 dark:text-slate-300 mb-6">These are the CMS systems that have increased their market share the most over the last 12 months.</p>

                <div class="rounded-xl border border-slate-200 dark:border-[#2a2623] overflow-hidden mb-10">
                    <table class="w-full text-left">
                        <thead class="bg-slate-50 dark:bg-[#2a2623]/50">
                            <tr>
                                <th class="px-4 py-3 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Rank</th>
                                <th class="px-4 py-3 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Technology</th>
                                <th class="px-4 py-3 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Market share</th>
                                <th class="px-4 py-3 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Growth rate YoY</th>
                                <th class="px-4 py-3 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">MoM</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-700/50">
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30 transition-colors"><td class="px-4 py-3 text-sm">1</td><td class="px-4 py-3 text-sm">WordPress</td><td class="px-4 py-3 text-sm">35.45%</td><td class="px-4 py-3 text-sm text-emerald-600 dark:text-emerald-400">1.40%</td><td class="px-4 py-3 text-sm">0.00%</td></tr>
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30 transition-colors"><td class="px-4 py-3 text-sm">2</td><td class="px-4 py-3 text-sm">Shopify</td><td class="px-4 py-3 text-sm">4.03%</td><td class="px-4 py-3 text-sm text-emerald-600 dark:text-emerald-400">5.22%</td><td class="px-4 py-3 text-sm">0.00%</td></tr>
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30 transition-colors"><td class="px-4 py-3 text-sm">3</td><td class="px-4 py-3 text-sm">Wix</td><td class="px-4 py-3 text-sm">2.51%</td><td class="px-4 py-3 text-sm text-emerald-600 dark:text-emerald-400">7.73%</td><td class="px-4 py-3 text-sm">0.00%</td></tr>
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30 transition-colors"><td class="px-4 py-3 text-sm">4</td><td class="px-4 py-3 text-sm">Squarespace</td><td class="px-4 py-3 text-sm">1.81%</td><td class="px-4 py-3 text-sm text-emerald-600 dark:text-emerald-400">5.85%</td><td class="px-4 py-3 text-sm">0.00%</td></tr>
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30 transition-colors"><td class="px-4 py-3 text-sm">5</td><td class="px-4 py-3 text-sm">Drupal</td><td class="px-4 py-3 text-sm">1.32%</td><td class="px-4 py-3 text-sm text-red-500 dark:text-red-400">-7.04%</td><td class="px-4 py-3 text-sm">0.00%</td></tr>
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30 transition-colors"><td class="px-4 py-3 text-sm">6</td><td class="px-4 py-3 text-sm">Joomla</td><td class="px-4 py-3 text-sm">1.28%</td><td class="px-4 py-3 text-sm text-red-500 dark:text-red-400">-11.72%</td><td class="px-4 py-3 text-sm">0.00%</td></tr>
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30 transition-colors"><td class="px-4 py-3 text-sm">7</td><td class="px-4 py-3 text-sm">PrestaShop</td><td class="px-4 py-3 text-sm">0.68%</td><td class="px-4 py-3 text-sm text-red-500 dark:text-red-400">-10.53%</td><td class="px-4 py-3 text-sm">0.00%</td></tr>
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30 transition-colors"><td class="px-4 py-3 text-sm">8</td><td class="px-4 py-3 text-sm">Webflow</td><td class="px-4 py-3 text-sm">0.65%</td><td class="px-4 py-3 text-sm text-emerald-600 dark:text-emerald-400">18.18%</td><td class="px-4 py-3 text-sm">0.00%</td></tr>
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30 transition-colors"><td class="px-4 py-3 text-sm">9</td><td class="px-4 py-3 text-sm">Tistory</td><td class="px-4 py-3 text-sm">0.55%</td><td class="px-4 py-3 text-sm text-red-500 dark:text-red-400">-11.29%</td><td class="px-4 py-3 text-sm">0.00%</td></tr>
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30 transition-colors"><td class="px-4 py-3 text-sm">10</td><td class="px-4 py-3 text-sm">Weebly</td><td class="px-4 py-3 text-sm">0.46%</td><td class="px-4 py-3 text-sm text-red-500 dark:text-red-400">-8.00%</td><td class="px-4 py-3 text-sm">0.00%</td></tr>
                        </tbody>
                    </table>
                </div>

                <!-- Top 10 fastest growing CMSes -->
                <div class="not-prose mt-12 mb-6">
                    <h3 class="text-xl font-extrabold text-slate-950 dark:text-slate-100" id="fastest-growing-cmses">Top 10 fastest growing CMSes</h3>
                </div>
                <p class="text-base text-slate-700 dark:text-slate-300 mb-6">These are not necessarily the biggest, but they are the fastest growing CMSes:</p>

                <div class="rounded-xl border border-slate-200 dark:border-[#2a2623] overflow-hidden">
                    <table class="w-full text-left">
                        <thead class="bg-slate-50 dark:bg-[#2a2623]/50">
                            <tr>
                                <th class="px-4 py-3 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Rank</th>
                                <th class="px-4 py-3 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Technology</th>
                                <th class="px-4 py-3 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Market share</th>
                                <th class="px-4 py-3 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Growth rate YoY</th>
                                <th class="px-4 py-3 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">MoM</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-700/50">
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30 transition-colors"><td class="px-4 py-3 text-sm">1</td><td class="px-4 py-3 text-sm">Framer Sites</td><td class="px-4 py-3 text-sm">0.06%</td><td class="px-4 py-3 text-sm text-emerald-600 dark:text-emerald-400">200.00%</td><td class="px-4 py-3 text-sm">0.00%</td></tr>
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30 transition-colors"><td class="px-4 py-3 text-sm">2</td><td class="px-4 py-3 text-sm">Fourthwall</td><td class="px-4 py-3 text-sm">0.14%</td><td class="px-4 py-3 text-sm text-emerald-600 dark:text-emerald-400">180.00%</td><td class="px-4 py-3 text-sm">0.00%</td></tr>
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30 transition-colors"><td class="px-4 py-3 text-sm">3</td><td class="px-4 py-3 text-sm">Ecwid</td><td class="px-4 py-3 text-sm">0.05%</td><td class="px-4 py-3 text-sm text-emerald-600 dark:text-emerald-400">66.67%</td><td class="px-4 py-3 text-sm">0.00%</td></tr>
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30 transition-colors"><td class="px-4 py-3 text-sm">4</td><td class="px-4 py-3 text-sm">Amazon Webstore</td><td class="px-4 py-3 text-sm">0.06%</td><td class="px-4 py-3 text-sm text-emerald-600 dark:text-emerald-400">50.00%</td><td class="px-4 py-3 text-sm">0.00%</td></tr>
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30 transition-colors"><td class="px-4 py-3 text-sm">5</td><td class="px-4 py-3 text-sm">Storyblok</td><td class="px-4 py-3 text-sm">0.03%</td><td class="px-4 py-3 text-sm text-emerald-600 dark:text-emerald-400">50.00%</td><td class="px-4 py-3 text-sm">0.00%</td></tr>
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30 transition-colors"><td class="px-4 py-3 text-sm">6</td><td class="px-4 py-3 text-sm">WebNode</td><td class="px-4 py-3 text-sm">0.08%</td><td class="px-4 py-3 text-sm text-emerald-600 dark:text-emerald-400">33.33%</td><td class="px-4 py-3 text-sm">0.00%</td></tr>
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30 transition-colors"><td class="px-4 py-3 text-sm">7</td><td class="px-4 py-3 text-sm">Salla</td><td class="px-4 py-3 text-sm">0.04%</td><td class="px-4 py-3 text-sm text-emerald-600 dark:text-emerald-400">33.33%</td><td class="px-4 py-3 text-sm">0.00%</td></tr>
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30 transition-colors"><td class="px-4 py-3 text-sm">8</td><td class="px-4 py-3 text-sm">JouwWeb</td><td class="px-4 py-3 text-sm">0.04%</td><td class="px-4 py-3 text-sm text-emerald-600 dark:text-emerald-400">33.33%</td><td class="px-4 py-3 text-sm">0.00%</td></tr>
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30 transition-colors"><td class="px-4 py-3 text-sm">9</td><td class="px-4 py-3 text-sm">Tiendanube</td><td class="px-4 py-3 text-sm">0.13%</td><td class="px-4 py-3 text-sm text-emerald-600 dark:text-emerald-400">30.00%</td><td class="px-4 py-3 text-sm">0.00%</td></tr>
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30 transition-colors"><td class="px-4 py-3 text-sm">10</td><td class="px-4 py-3 text-sm">Odoo</td><td class="px-4 py-3 text-sm">0.09%</td><td class="px-4 py-3 text-sm text-emerald-600 dark:text-emerald-400">28.57%</td><td class="px-4 py-3 text-sm">0.00%</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- Section: Most popular eCommerce systems -->
            <section class="mb-16">
                <div class="not-prose mb-6">
                    <span class="text-xs font-bold uppercase tracking-widest text-primary dark:text-accent">eCommerce</span>
                    <h2 class="mt-2 text-2xl font-extrabold text-slate-950 dark:text-slate-100" id="most-popular-ecommerce-systems">Most popular eCommerce systems</h2>
                </div>
                <p class="text-base text-slate-700 dark:text-slate-300 mb-2">Within the CMS world, there is a highly important (and lucrative) "sub" group of eCommerce systems. Some of these systems are CMSes themselves. Others, like WooCommerce, are built on top of a CMS. In the case of WooCommerce, that CMS is WordPress.</p>
                <p class="text-base text-slate-700 dark:text-slate-300 mb-2"><strong>Explanation of the data:</strong> This pie chart takes the entire "web" as its base. So the slice "Not eCommerce" is the portion of the web that is not an eCommerce site. One of the other biggest slices is "Cart functionality". Here, the HTTP Archive <em>has</em> detected that there is some sort of shop on the site, but it didn't recognize the system in use.</p>
                <p class="text-sm text-slate-500 dark:text-slate-400 mb-6">Note: click on names in the legend to remove or re-add them.</p>

                <div class="chart-container pie-chart max-w-[70%] mx-auto">
                    <canvas id="pie_chart_3"></canvas>
                </div>
                <div class="chart-legend" id="legend_container_chart_3"></div>

                <!-- Most popular eCommerce systems over time -->
                <div class="not-prose mt-12 mb-6">
                    <h3 class="text-xl font-extrabold text-slate-950 dark:text-slate-100" id="most-popular-ecommerce-over-time">Most popular eCommerce systems over time</h3>
                </div>
                <p class="text-sm text-slate-500 dark:text-slate-400 mb-6">Note: click on the label of an eCommerce system to remove it from the chart.</p>

                <div style="height: 400px;">
                    <canvas id="historic_line_chart_4"></canvas>
                </div>
                <div class="chart-legend" id="legend_container_chart_4"></div>

                <!-- Growth rates for the top 10 eCommerce systems -->
                <div class="not-prose mt-12 mb-6">
                    <h3 class="text-xl font-extrabold text-slate-950 dark:text-slate-100" id="ecommerce-growth-rates">Growth rates for the top 10 eCommerce systems</h3>
                </div>

                <div class="rounded-xl border border-slate-200 dark:border-[#2a2623] overflow-hidden">
                    <table class="w-full text-left">
                        <thead class="bg-slate-50 dark:bg-[#2a2623]/50">
                            <tr>
                                <th class="px-4 py-3 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Rank</th>
                                <th class="px-4 py-3 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Technology</th>
                                <th class="px-4 py-3 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Market share</th>
                                <th class="px-4 py-3 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Growth rate YoY</th>
                                <th class="px-4 py-3 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">MoM</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-700/50">
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30 transition-colors"><td class="px-4 py-3 text-sm">1</td><td class="px-4 py-3 text-sm">WooCommerce</td><td class="px-4 py-3 text-sm">7.14%</td><td class="px-4 py-3 text-sm text-emerald-600 dark:text-emerald-400">1.56%</td><td class="px-4 py-3 text-sm">0.00%</td></tr>
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30 transition-colors"><td class="px-4 py-3 text-sm">2</td><td class="px-4 py-3 text-sm">Shopify</td><td class="px-4 py-3 text-sm">4.03%</td><td class="px-4 py-3 text-sm text-emerald-600 dark:text-emerald-400">5.22%</td><td class="px-4 py-3 text-sm">0.00%</td></tr>
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30 transition-colors"><td class="px-4 py-3 text-sm">3</td><td class="px-4 py-3 text-sm">Squarespace Commerce</td><td class="px-4 py-3 text-sm">1.81%</td><td class="px-4 py-3 text-sm text-emerald-600 dark:text-emerald-400">5.85%</td><td class="px-4 py-3 text-sm">0.00%</td></tr>
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30 transition-colors"><td class="px-4 py-3 text-sm">4</td><td class="px-4 py-3 text-sm">Wix eCommerce</td><td class="px-4 py-3 text-sm">1.45%</td><td class="px-4 py-3 text-sm text-emerald-600 dark:text-emerald-400">18.85%</td><td class="px-4 py-3 text-sm">0.00%</td></tr>
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30 transition-colors"><td class="px-4 py-3 text-sm">5</td><td class="px-4 py-3 text-sm">PrestaShop</td><td class="px-4 py-3 text-sm">0.68%</td><td class="px-4 py-3 text-sm text-red-500 dark:text-red-400">-10.53%</td><td class="px-4 py-3 text-sm">0.00%</td></tr>
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30 transition-colors"><td class="px-4 py-3 text-sm">6</td><td class="px-4 py-3 text-sm">Magento</td><td class="px-4 py-3 text-sm">0.43%</td><td class="px-4 py-3 text-sm text-red-500 dark:text-red-400">-12.24%</td><td class="px-4 py-3 text-sm">0.00%</td></tr>
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30 transition-colors"><td class="px-4 py-3 text-sm">7</td><td class="px-4 py-3 text-sm">1C-Bitrix</td><td class="px-4 py-3 text-sm">0.27%</td><td class="px-4 py-3 text-sm text-red-500 dark:text-red-400">-49.06%</td><td class="px-4 py-3 text-sm">0.00%</td></tr>
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30 transition-colors"><td class="px-4 py-3 text-sm">8</td><td class="px-4 py-3 text-sm">OpenCart</td><td class="px-4 py-3 text-sm">0.22%</td><td class="px-4 py-3 text-sm">0.00%</td><td class="px-4 py-3 text-sm">0.00%</td></tr>
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30 transition-colors"><td class="px-4 py-3 text-sm">9</td><td class="px-4 py-3 text-sm">Fourthwall</td><td class="px-4 py-3 text-sm">0.14%</td><td class="px-4 py-3 text-sm text-emerald-600 dark:text-emerald-400">180.00%</td><td class="px-4 py-3 text-sm">0.00%</td></tr>
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30 transition-colors"><td class="px-4 py-3 text-sm">10</td><td class="px-4 py-3 text-sm">Webflow Ecommerce</td><td class="px-4 py-3 text-sm">0.13%</td><td class="px-4 py-3 text-sm text-emerald-600 dark:text-emerald-400">30.00%</td><td class="px-4 py-3 text-sm">0.00%</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- Section: Most popular WordPress page builders -->
            <section class="mb-16">
                <div class="not-prose mb-6">
                    <span class="text-xs font-bold uppercase tracking-widest text-primary dark:text-accent">WordPress</span>
                    <h2 class="mt-2 text-2xl font-extrabold text-slate-950 dark:text-slate-100" id="most-popular-wordpress-page-builders">Most popular WordPress page builders</h2>
                </div>
                <p class="text-base text-slate-700 dark:text-slate-300 mb-2">Another big group, within the WordPress world specifically, is the world of page builders. Some of these page builders transform the entire WordPress experience.</p>
                <p class="text-base text-slate-700 dark:text-slate-300 mb-2"><strong>Explanation of the data:</strong> This pie chart takes the entire "web" as its base. So, the slice "No page builder" is the portion of the web that does not use a WordPress page builder.</p>
                <p class="text-sm text-slate-500 dark:text-slate-400 mb-6">Note: click on names in the legend to remove or re-add them.</p>

                <div class="chart-container pie-chart max-w-[70%] mx-auto">
