---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import SchemaGraph from '../../components/SchemaGraph.astro';
import type { SchemaPageContext } from '../../utils/schema';
import { canonicalUrl } from '../../utils/schema/constants';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';

export async function getStaticPaths() {
    const pages = await getCollection('pages');
    return pages
        .filter((page) => page.data.section === 'code')
        .map((page) => ({
            params: { slug: page.id },
            props: { entry: page }
        }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'pages'> };
const { Content, headings } = await render(entry);
const { data } = entry;

const seoTitle = data.seo?.title ?? data.title;
const seoDescription = data.seo?.description;

const pageCanonicalUrl = canonicalUrl(Astro.url.pathname);

const pageContext: SchemaPageContext = {
    pageType: 'page',
    canonicalUrl: pageCanonicalUrl,
    title: data.title,
    description: seoDescription ?? ''
};

const hasToc = !!data.toc && headings.some((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout title={seoTitle} description={seoDescription}>
    <SchemaGraph pageContext={pageContext} />
    <div class="sp-root sp-blocks sp-post" data-pagefind-body>
        <section class="sp-post-hero">
            <div class="sp-section-inner">
                <nav class="sp-post-crumbs" aria-label="Breadcrumb">
                    <a href="/">Home</a>
                    <span class="sep">/</span>
                    <a href="/code/">Code</a>
                    <span class="sep">/</span>
                </nav>
                <h1 class="sp-post-title" set:html={data.title} />
            </div>
        </section>
        <section class="sp-post-body">
            <div class:list={['sp-post-grid', { 'sp-no-toc': !hasToc }]}>
                {hasToc && <TableOfContents headings={headings} />}
                <article class="sp-prose">
                    <Content />
                </article>
            </div>
        </section>
    </div>
</BaseLayout>
