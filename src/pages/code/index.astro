---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SpChrome from '../../components/SpChrome.astro';
import SpFooter from '../../components/SpFooter.astro';
import SchemaGraph from '../../components/SchemaGraph.astro';
import { canonicalUrl } from '../../utils/schema/constants';
import type { SchemaPageContext } from '../../utils/schema';

const currentYear = new Date().getFullYear();
const yearsShipping = currentYear - 2007;

const npmPackages = [
    {
        n: '01',
        scope: '@jdevalk/',
        name: 'seo-graph-core',
        tagline: 'Pure TypeScript schema.org JSON-LD graph builder.',
        desc: 'Typed piece builders, ID factory, graph assembler with deduplication. Framework-agnostic — works anywhere you can run Node.',
        npm: 'https://www.npmjs.com/package/@jdevalk/seo-graph-core',
        github: 'https://github.com/jdevalk/seo-graph/tree/main/packages/seo-graph-core',
    },
    {
        n: '02',
        scope: '@jdevalk/',
        name: 'astro-seo-graph',
        tagline: 'Astro integration for seo-graph-core.',
        desc: 'Ships a <Seo> component, schema endpoint factories, a schema map for agent discovery, hreflang alternates, and Zod content helpers.',
        npm: 'https://www.npmjs.com/package/@jdevalk/astro-seo-graph',
        github: 'https://github.com/jdevalk/seo-graph/tree/main/packages/astro-seo-graph',
    },
    {
        n: '03',
        scope: '@jdevalk/',
        name: 'emdash-plugin-seo',
        tagline: 'SEO plugin for EmDash CMS.',
        desc: 'Uses seo-graph-core for JSON-LD graph generation, with EmDash-specific piece builders and metadata hooks.',
        npm: 'https://www.npmjs.com/package/@jdevalk/emdash-plugin-seo',
        github: 'https://github.com/jdevalk/emdash-plugin-seo',
    },
];

const plugins = [
    {
        n: '01',
        name: 'Progress Planner',
        desc: 'My current main focus. A WordPress plugin that helps you plan and track your content and site maintenance progress.',
        url: 'https://progressplanner.com/',
        image: '/images/plugins/progress-planner.webp',
        github: 'https://github.com/ProgressPlanner/progress-planner',
    },
    {
        n: '02',
        name: 'AAA Option Optimizer',
        desc: 'Tracks autoloaded options usage and allows the user to optimize them — faster admin, faster frontend.',
        url: 'https://progressplanner.com/plugins/aaa-option-optimizer/',
        image: '/images/plugins/aaa-option-optimizer.webp',
        github: 'https://github.com/ProgressPlanner/aaa-option-optimizer',
    },
    {
        n: '03',
        name: 'Brand Assets',
        desc: 'Stop chasing down requests for your logo and color codes by creating a Brand Assets page on your site.',
        url: 'https://progressplanner.com/plugins/brand-assets/',
        image: '/images/plugins/brand-assets.webp',
        github: 'https://github.com/ProgressPlanner/brand-assets',
    },
    {
        n: '04',
        name: 'Comment Experience',
        desc: "WordPress' comment system is incomplete. This plugin adds the little tricks that make comments actually manageable.",
        url: 'https://progressplanner.com/plugins/comment-experience/',
        image: '/images/plugins/comment-experience.webp',
        github: 'https://github.com/ProgressPlanner/comment-experience',
    },
    {
        n: '05',
        name: 'Comment Free Zone',
        desc: "For sites that don't need comments, this plugin removes every default entry point cleanly.",
        url: 'https://progressplanner.com/plugins/comment-free-zone/',
        image: '/images/plugins/comment-free-zone.webp',
        github: 'https://github.com/ProgressPlanner/comment-free-zone',
    },
    {
        n: '06',
        name: 'Fewer Tags',
        desc: 'Make sure tags are only live on your site when they actually add value — more than a few posts in them.',
        url: 'https://progressplanner.com/plugins/fewer-tags/',
        image: '/images/plugins/fewer-tags.png',
        github: 'https://github.com/ProgressPlanner/fewer-tags',
    },
    {
        n: '07',
        name: 'Glossary',
        desc: 'Clear definitions that show up exactly when and where readers need them, without breaking reading flow.',
        url: 'https://progressplanner.com/plugins/glossary/',
        image: '/images/plugins/glossary.webp',
        github: 'https://github.com/ProgressPlanner/flavor-glossary',
    },
    {
        n: '08',
        name: 'XML Sitemaps for PDFs',
        desc: 'If your site has a lot of PDFs, this Yoast SEO add-on is what you need to get them indexed.',
        url: 'https://progressplanner.com/plugins/xml-sitemap-for-pdfs/',
        image: '/images/plugins/xml-sitemaps-pdfs.webp',
        github: 'https://github.com/ProgressPlanner/xml-sitemap-for-pdfs',
    },
];

const pageContext: SchemaPageContext = {
    pageType: 'page',
    canonicalUrl: canonicalUrl('/code/'),
    title: 'The Workshop — Code & Projects',
    description: 'Code projects, WordPress plugins, npm packages, and other software built and maintained by Joost de Valk.',
};
---

<BaseLayout
    title="Code"
    description="Code projects, WordPress plugins, and other software I've built and maintain."
>
    <SchemaGraph pageContext={pageContext} />
    <div slot="header" />
    <div slot="footer" />

    <div class="sp-root sp-blocks sp-code" data-pagefind-body>
        <SpChrome issue={`THE WORKSHOP · ${currentYear}`} />

        <section class="sp-code-hero">
            <div class="sp-code-kicker">
                <span>SECTION III</span>
                <span class="rule"></span>
                <span>OPEN SOURCE · PLUGINS · PACKAGES</span>
                <span class="rule"></span>
                <span>MIT &amp; GPL</span>
            </div>
            <h1 class="sp-code-title">The <em>Workshop</em>.</h1>
            <p class="sp-code-lede">
                Building tools that make the web &amp; the world better — from WordPress and EmDash plugins to Astro integrations, Schema infrastructure
                and club management software.
            </p>
            <div class="sp-code-stats">
                <div class="sp-code-stat">
                    <div class="n">{plugins.length + npmPackages.length + 1}</div>
                    <div class="lbl">projects</div>
                </div>
                <div class="sp-code-stat">
                    <div class="n">{npmPackages.length}</div>
                    <div class="lbl">npm packages</div>
                </div>
                <div class="sp-code-stat">
                    <div class="n">{plugins.length}</div>
                    <div class="lbl">WP plugins</div>
                </div>
                <div class="sp-code-stat">
                    <div class="n">{yearsShipping}yr</div>
                    <div class="lbl">shipping</div>
                </div>
            </div>
        </section>

        <section class="sp-featured">
            <div class="meta">
                <span class="badge">№ FEATURED</span>
                <span>SaaS · Club management</span>
                <span>In production</span>
            </div>
            <div class="sp-featured-grid">
                <div>
                    <h2>Rondo.</h2>
                    <p class="desc">
                        From member management and dues to invoicing, VOG, and membership passes —
                        <a href="https://rondo.club" target="_blank" rel="noopener noreferrer"> Rondo</a> automates
                        your club processes and keeps everything in sync.
                    </p>
                    <div class="cta">
                        <a href="https://rondo.club" class="primary" target="_blank" rel="noopener noreferrer">Visit rondo.club →</a>
                        <a href="https://github.com/rondoclubmanager" class="ghost" target="_blank" rel="noopener noreferrer">View on GitHub</a>
                    </div>
                </div>
                <div class="sp-featured-shot">
                    <img src="/images/rondo-screenshot.webp" alt="Rondo committee overview" loading="eager" decoding="async" width="560" height="420" />
                </div>
            </div>
        </section>

        <section class="sp-code-section-head">
            <div class="kicker">§ 01 · npm packages</div>
            <h3>SEO &amp; Schema.org.</h3>
            <p class="intro">
                Agent-ready SEO tools for the modern web. A shared schema.org JSON-LD graph engine,
                an Astro integration, and an EmDash CMS plugin — all open source.
            </p>
        </section>
        <section class="sp-pkg-list">
            {npmPackages.map(pkg => (
                <article class="sp-pkg">
                    <div class="n">{pkg.n}</div>
                    <div>
                        <div class="name"><span class="at">{pkg.scope}</span>{pkg.name}</div>
                        <h4 class="tagline">{pkg.tagline}</h4>
                        <p class="desc">{pkg.desc}</p>
                    </div>
                    <div class="links">
                        <a href={pkg.npm} target="_blank" rel="noopener noreferrer">npm →</a>
                        <a href={pkg.github} target="_blank" rel="noopener noreferrer">GitHub →</a>
                    </div>
                </article>
            ))}
        </section>

        <section class="sp-code-section-head" style="border-top: 1px solid #1a1410">
            <div class="kicker">§ 02 · WordPress</div>
            <h3>Plugins.</h3>
            <p class="intro">
                I was the original author of Yoast SEO and most of its add-ons, and never really
                stopped coding on WordPress plugins.
            </p>
        </section>
        <section class="sp-plugins">
            <div class="sp-plugin-grid">
                {plugins.map(plugin => (
                    <div class="sp-plugin">
                        <div class="icon">
                            {plugin.image
                                ? <img src={plugin.image} alt={plugin.name} loading="lazy" decoding="async" width="72" height="72" />
                                : plugin.name.charAt(0)
                            }
                        </div>
                        <div>
                            <div class="n">№ {plugin.n}</div>
                            <h4>{plugin.name}</h4>
                            <p>{plugin.desc}</p>
                            <div class="plugin-links">
                                <a href={plugin.url} target="_blank" rel="noopener noreferrer">Plugin page →</a>
                                &nbsp;&nbsp;·&nbsp;&nbsp;
                                <a href={plugin.github} target="_blank" rel="noopener noreferrer">GitHub →</a>
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </section>

        <section class="sp-other">
            <div class="kicker">§ 03 · Elsewhere</div>
            <h3>Other projects.</h3>
            <p>
                I actively contribute to <a href="https://github.com/emdash-cms/emdash" target="_blank" rel="noopener noreferrer">EmDash core</a>, including per-collection sitemaps,
                breadcrumb support, and OG image handling. I also contribute to the software of some
                of the companies in our investment portfolio — read more about that on my
                <a href="/about-me/"> about page</a>, or at <a href="https://emilia.capital/" target="_blank" rel="noopener noreferrer">Emilia Capital</a>.
            </p>
        </section>

        <SpFooter />
    </div>
</BaseLayout>
