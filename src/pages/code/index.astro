---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchemaGraph from '../../components/SchemaGraph.astro';
import { canonicalUrl } from '../../utils/schema/constants';
import type { SchemaPageContext } from '../../utils/schema';

const npmPackages = [
    {
        scope: '@jdevalk/',
        name: 'seo-graph-core',
        title: 'Pure TypeScript schema.org JSON-LD graph builder',
        desc: 'Typed piece builders, ID factory, graph assembler with deduplication. Framework-agnostic.',
        url: 'https://www.npmjs.com/package/@jdevalk/seo-graph-core'
    },
    {
        scope: '@jdevalk/',
        name: 'astro-seo-graph',
        title: 'Astro integration for seo-graph-core',
        desc: 'A <Seo> component, schema endpoints, agent-discoverable schema map, hreflang alternates.',
        url: 'https://www.npmjs.com/package/@jdevalk/astro-seo-graph'
    },
    {
        scope: '@jdevalk/',
        name: 'astro-markdown-alternate',
        title: 'Markdown alternate links for Astro',
        desc: 'Injects rel="alternate" markdown links so raw source is discoverable by agents and crawlers.',
        url: 'https://www.npmjs.com/package/@jdevalk/astro-markdown-alternate'
    },
    {
        scope: '@jdevalk/',
        name: 'emdash-plugin-seo',
        title: 'SEO plugin for EmDash CMS',
        desc: 'JSON-LD graph generation via seo-graph-core, with EmDash-native piece builders and hooks.',
        url: 'https://www.npmjs.com/package/@jdevalk/emdash-plugin-seo'
    },
    {
        scope: '@jdevalk/',
        name: 'emdash-plugin-lettermint',
        title: 'Lettermint email provider for EmDash',
        desc: 'Connects EmDash to Lettermint for transactional email, with EmDash-native sending hooks.',
        url: 'https://www.npmjs.com/package/@jdevalk/emdash-plugin-lettermint'
    }
];

const plugins = [
    {
        name: 'Progress Planner',
        desc: 'My main focus. Plan and track your content and site-maintenance progress.',
        url: 'https://progressplanner.com/',
        image: '/images/plugins/progress-planner.svg'
    },
    {
        name: 'AAA Option Optimizer',
        desc: 'Tracks autoloaded options usage and helps you optimize them — faster admin, faster frontend.',
        url: 'https://progressplanner.com/plugins/aaa-option-optimizer/',
        image: '/images/plugins/aaa-option-optimizer.svg'
    },
    {
        name: 'Brand Assets',
        desc: 'Stop chasing requests for your logo and colors — publish a Brand Assets page on your site.',
        url: 'https://progressplanner.com/plugins/brand-assets/',
        image: '/images/plugins/brand-assets.svg'
    },
    {
        name: 'Comment Experience',
        desc: 'WordPress’ comment system is incomplete. This adds the tricks that make comments manageable.',
        url: 'https://progressplanner.com/plugins/comment-experience/',
        image: '/images/plugins/comment-experience.svg'
    },
    {
        name: 'Fewer Tags',
        desc: 'Keep tags live only when they add value — more than a few posts in them — for cleaner archives.',
        url: 'https://progressplanner.com/plugins/fewer-tags/',
        image: '/images/plugins/fewer-tags.svg'
    },
    {
        name: 'Glossary',
        desc: 'Clear definitions that show up exactly when and where readers need them, without breaking flow.',
        url: 'https://progressplanner.com/plugins/glossary/',
        image: '/images/plugins/glossary.svg'
    },
    {
        name: 'Comment Free Zone',
        desc: 'For sites that don’t need comments, this removes every default entry point cleanly.',
        url: 'https://progressplanner.com/plugins/comment-free-zone/',
        image: '/images/plugins/comment-free-zone.svg'
    },
    {
        name: 'XML Sitemaps for PDFs',
        desc: 'A Yoast SEO add-on that gets all the PDFs on your site properly indexed.',
        url: 'https://progressplanner.com/plugins/xml-sitemap-for-pdfs/',
        image: '/images/plugins/xml-sitemap-for-pdfs.svg'
    }
];

const pageContext: SchemaPageContext = {
    pageType: 'page',
    canonicalUrl: canonicalUrl('/code/'),
    title: 'Code — open-source packages & WordPress plugins',
    description: 'Open-source npm packages and WordPress plugins built and maintained by Joost de Valk.'
};
---

<BaseLayout title="Code" description="Open-source npm packages and WordPress plugins that Joost de Valk builds and actively maintains.">
    <SchemaGraph pageContext={pageContext} />

    <div class="sp-root sp-code" data-pagefind-body>
        <section class="code-hero">
            <div>
                <h1 class="sp-display">Code</h1>
                <p class="sp-section-lede">
                    Open-source packages and WordPress plugins I build and maintain — most of it on
                    <a href="https://github.com/jdevalk" target="_blank" rel="noopener noreferrer">GitHub</a> and
                    <a href="https://www.npmjs.com/~jdevalk" target="_blank" rel="noopener noreferrer">npm</a>.
                </p>
            </div>
            <div class="code-whoami">
                <div class="lbl">whoami</div>
                <div><span class="p">$</span> shipping since <span class="v">2007</span></div>
                <div><span class="p">$</span> npm scope <span class="v">@jdevalk</span></div>
                <div><span class="p">$</span> gh <span class="v">/jdevalk</span></div>
            </div>
        </section>

        <section class="code-section">
            <div class="sp-section-head">
                <h2>npm packages</h2>
                <span class="sp-section-meta">TypeScript · Astro &amp; EmDash</span>
            </div>
            <div class="code-npm-grid">
                {
                    npmPackages.map((pkg) => (
                        <a href={pkg.url} class="code-npm" target="_blank" rel="noopener noreferrer">
                            <div class="name">
                                <span class="scope">{pkg.scope}</span>
                                {pkg.name}
                            </div>
                            <div class="title">{pkg.title}</div>
                            <div class="desc">{pkg.desc}</div>
                        </a>
                    ))
                }
            </div>
        </section>

        <section class="code-section">
            <div class="sp-section-head">
                <h2>WordPress plugins</h2>
                <span class="sp-section-meta">mostly under Progress Planner</span>
            </div>
            <div class="code-plugin-grid">
                {
                    plugins.map((p) => (
                        <a href={p.url} class="code-plugin" target="_blank" rel="noopener noreferrer">
                            <img src={p.image} alt={p.name} width="40" height="40" loading="lazy" decoding="async" />
                            <div class="name">{p.name}</div>
                            <div class="desc">{p.desc}</div>
                            <div class="link">view plugin →</div>
                        </a>
                    ))
                }
            </div>
            <p class="code-closing">
                I was the original author of <a href="https://yoast.com/wordpress/plugins/seo/" target="_blank" rel="noopener noreferrer">Yoast SEO</a> and still
                occasionally contribute, and I actively contribute to other projects across the
                <a href="https://emilia.capital/" target="_blank" rel="noopener noreferrer">Emilia Capital</a> portfolio — including
                <a href="https://rondo.club" target="_blank" rel="noopener noreferrer">Rondo</a>, open-source club-management software, and
                <a href="https://github.com/emdash-cms/emdash" target="_blank" rel="noopener noreferrer">EmDash core</a>.
            </p>
        </section>
    </div>
</BaseLayout>

<style>
    .code-hero {
        display: grid;
        grid-template-columns: 1.5fr 1fr;
        gap: 48px;
        align-items: end;
        padding: 60px 0 38px;
    }
    .code-whoami {
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--accent);
        line-height: 1.9;
        border: 1px solid rgba(95, 117, 96, 0.4);
        padding: 18px 22px;
        background: rgba(95, 117, 96, 0.08);
        border-radius: 2px;
    }
    .code-whoami .lbl {
        color: var(--faint);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-size: 10.5px;
        margin-bottom: 8px;
    }
    .code-whoami .p,
    .code-whoami .v {
        color: var(--ink);
    }

    .code-section {
        padding: 8px 0 16px;
    }
    .code-section + .code-section {
        padding-top: 34px;
    }
    .code-npm-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
    }
    .code-npm {
        text-decoration: none;
        padding: 22px 26px 22px 0;
        border-bottom: 1px solid var(--hair);
        transition: background 0.15s;
    }
    .code-npm:nth-child(odd) {
        border-right: 1px solid var(--hair);
    }
    .code-npm:nth-child(even) {
        padding: 22px 0 22px 26px;
    }
    .code-npm:hover {
        background: rgba(31, 37, 48, 0.035);
    }
    .code-npm .name {
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--accent);
    }
    .code-npm .scope {
        color: var(--faint);
    }
    .code-npm .title {
        font-family: var(--font-text);
        font-size: 19px;
        color: var(--ink);
        margin-top: 8px;
    }
    .code-npm .desc {
        font-family: var(--font-text);
        font-size: 15px;
        color: var(--muted);
        margin-top: 6px;
        line-height: 1.45;
    }

    .code-plugin-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 20px;
        padding-top: 24px;
    }
    .code-plugin {
        text-decoration: none;
        background: var(--card);
        border: 1px solid rgba(31, 37, 48, 0.12);
        padding: 22px;
        display: block;
        transition: border-color 0.15s;
    }
    .code-plugin:hover {
        border-color: var(--accent);
    }
    .code-plugin img {
        width: 40px;
        height: 40px;
        display: block;
    }
    .code-plugin .name {
        font-family: var(--font-display);
        font-weight: 500;
        font-size: 20px;
        color: var(--ink);
        margin-top: 16px;
    }
    .code-plugin .desc {
        font-family: var(--font-text);
        font-size: 15px;
        color: var(--muted);
        margin-top: 6px;
        line-height: 1.45;
    }
    .code-plugin .link {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--accent);
        margin-top: 14px;
    }
    .code-closing {
        font-family: var(--font-text);
        font-size: 16px;
        color: var(--muted);
        margin: 26px 0 0;
        max-width: 64ch;
        line-height: 1.55;
    }
    .code-closing a {
        color: var(--ink);
        text-decoration: none;
        border-bottom: 1px solid var(--accent-soft-strong);
    }

    @media (max-width: 820px) {
        .code-hero {
            grid-template-columns: 1fr;
            gap: 28px;
            align-items: start;
        }
        .code-plugin-grid {
            grid-template-columns: 1fr 1fr;
        }
    }
    @media (max-width: 560px) {
        .code-npm-grid,
        .code-plugin-grid {
            grid-template-columns: 1fr;
        }
        .code-npm,
        .code-npm:nth-child(odd) {
            border-right: none;
        }
        .code-npm:nth-child(even) {
            padding: 22px 26px 22px 0;
        }
    }
</style>
