---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import SchemaGraph from '../components/SchemaGraph.astro';
import type { SchemaPageContext } from '../utils/schema';
import { canonicalUrl } from '../utils/schema/constants';
import BaseLayout from '../layouts/BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { sortPostsByDateDesc, slugify, getReadingTime, getRelatedPosts } from '../utils/post-utils';
import { gitLastmod } from '../utils/sitemap';
import fs from 'node:fs';

function resolvePostPath(entryId: string): string | null {
    const md = `src/content/blog/${entryId}/index.md`;
    const mdx = `src/content/blog/${entryId}/index.mdx`;
    if (fs.existsSync(md)) return md;
    if (fs.existsSync(mdx)) return mdx;
    return null;
}

function computeUpdatedDate(entryId: string, manual: Date | undefined, publishDate: Date): Date | null {
    if (manual) return manual;
    const fp = resolvePostPath(entryId);
    if (!fp) return null;
    const last = gitLastmod(fp);
    if (!last) return null;
    return last.getTime() - publishDate.getTime() > 24 * 60 * 60 * 1000 ? last : null;
}

export async function getStaticPaths() {
    const posts = (await getCollection('blog')).sort(sortPostsByDateDesc);
    const pages = await getCollection('pages');

    const blogPaths = posts.map((post) => ({
        params: { slug: post.id },
        props: {
            entry: post,
            type: 'blog' as const,
            relatedPosts: getRelatedPosts(post, posts),
            readingTime: getReadingTime(post.body ?? '')
        }
    }));

    const pagePaths = pages
        .filter((page) => page.id !== 'videos' && page.id !== 'clicky' && page.id !== 'about-me' && page.id !== 'contact-me' && page.id !== 'cms-market-share' && page.data.section !== 'code')
        .map((page) => ({
            params: { slug: page.id },
            props: {
                entry: page,
                type: 'page' as const
            }
        }));

    return [...blogPaths, ...pagePaths];
}

const { entry, type, relatedPosts, readingTime } = Astro.props;
const { Content, headings } = await render(entry);
const { href } = Astro.url;

const isBlog = type === 'blog';
const blogData = isBlog ? (entry as CollectionEntry<'blog'>).data : null;
const pageData = !isBlog ? (entry as CollectionEntry<'pages'>).data : null;

const effectiveUpdatedDate = isBlog
    ? computeUpdatedDate(entry.id, blogData!.updatedDate, blogData!.publishDate)
    : null;

function stripHtml(s: string): string { return s.replace(/<[^>]+>/g, ''); }

const seoTitle = isBlog
    ? (blogData!.seo?.title ?? stripHtml(blogData!.title))
    : (pageData!.seo?.title ?? stripHtml(pageData!.title));
const seoDescription = isBlog
    ? (blogData!.seo?.description ?? blogData!.excerpt)
    : pageData!.seo?.description;

const pageCanonicalUrl = canonicalUrl(Astro.url.pathname);

const pageContext: SchemaPageContext = isBlog ? {
    pageType: 'blogPost',
    canonicalUrl: pageCanonicalUrl,
    title: stripHtml(blogData!.title),
    description: blogData!.excerpt ?? blogData!.seo?.description ?? '',
    publishDate: blogData!.publishDate,
    updatedDate: effectiveUpdatedDate ?? undefined,
    featureImageUrl: canonicalUrl(`/og/${entry.id}.webp`),
    categories: blogData!.categories,
    wordCount: (entry.body ?? '').split(/\s+/).length
} : {
    pageType: entry.id === 'about-me' ? 'about' : 'page',
    canonicalUrl: pageCanonicalUrl,
    title: pageData!.title,
    description: pageData!.seo?.description ?? ''
};

// Blog post — TOC and computed values
const hasToc = !!(isBlog ? blogData!.toc : pageData!.toc) && headings.some(h => h.depth === 2 || h.depth === 3);

// Category label
const primaryCategory = blogData?.categories?.[0] ?? null;
---

{isBlog ? (
<BaseLayout title={seoTitle} description={seoDescription} pageType="article" publishDate={blogData!.publishDate} updatedDate={effectiveUpdatedDate ?? undefined} categories={blogData!.categories} noindex={!!blogData!.draft}>
    <SchemaGraph pageContext={pageContext} />
    <div class="sp-root sp-blocks sp-post">

        <section class="sp-post-hero" data-pagefind-body>
            <div class="sp-section-inner">
            <nav class="sp-post-crumbs" aria-label="Breadcrumb">
                <a href="/">Home</a>
                <span class="sep">/</span>
                <a href="/blog/">Blog</a>
                {primaryCategory && (
                    <>
                        <span class="sep">/</span>
                        <a href={`/category/${slugify(primaryCategory)}/`}>{primaryCategory}</a>
                    </>
                )}
                <span class="sep">/</span>
            </nav>

            <h1 class="sp-post-title" set:html={blogData!.title.replace(/\*([^*]+)\*/g, '<em>$1</em>')} />

            <div class="sp-post-meta-row">
                <span>Published · <strong><FormattedDate date={blogData!.publishDate} /></strong></span>
                {effectiveUpdatedDate && (
                    <span>Updated · <strong><FormattedDate date={effectiveUpdatedDate} /></strong></span>
                )}
                {readingTime && (
                    <span><strong>{readingTime} min</strong> read</span>
                )}
                <span>By <strong>Joost de Valk</strong></span>
            </div>
            </div>
        </section>

        <section class="sp-post-body" data-pagefind-body>
            <div class:list={['sp-post-grid', { 'sp-no-toc': !hasToc }]}>

                {hasToc && <TableOfContents headings={headings} />}

                <article class="sp-prose">
                    <Content />

                    <div class="sp-share" data-pagefind-ignore="all">
                        <span>Reply on</span>
                        <a href={`https://bsky.app/intent/compose?text=${encodeURIComponent(stripHtml(blogData!.title) + ' ' + href)}`} target="_blank" rel="noopener noreferrer">Bluesky</a>
                        <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(href)}&summary=${encodeURIComponent(stripHtml(blogData!.title))}`} target="_blank" rel="noopener noreferrer">LinkedIn</a>
                        <span class="sp-share-spacer">Share →</span>
                    </div>
                </article>

                <aside class="sp-post-margin" data-pagefind-ignore="all">
                    {blogData!.categories && blogData!.categories.length > 0 && (
                        <div class="m-block">
                            <div class="m-lbl">Filed under</div>
                            <ul>
                                {blogData!.categories.map(cat => (
                                    <li><a href={`/category/${slugify(cat)}/`} class="m-body">{cat}</a></li>
                                ))}
                            </ul>
                        </div>
                    )}
                </aside>

            </div>
        </section>

        {relatedPosts && relatedPosts.length > 0 && (
            <section class="sp-related" data-pagefind-ignore="all">
                <div class="sp-section-inner">
                <div class="rel-head">
                    <h3>Related writing</h3>
                    <div class="meta">From the archive</div>
                </div>
                <div class="sp-related-grid">
                    {relatedPosts.slice(0, 3).map(relPost => (
                        <a href={`/${relPost.id}/`} class="sp-related-card">
                            <div class="date">
                                <FormattedDate date={relPost.data.publishDate} />
                                {getReadingTime(relPost.body ?? '') && ` · ${getReadingTime(relPost.body ?? '')} min`}
                            </div>
                            <h4 set:html={relPost.data.title} />
                            {relPost.data.excerpt && <p>{relPost.data.excerpt}</p>}
                        </a>
                    ))}
                </div>
                </div>
            </section>
        )}

    </div>
</BaseLayout>

<script>
    function initToc() {
        const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
        if (links.length === 0) return;

        const headingIds = Array.from(links).map(l => l.hash.slice(1));
        const headings = headingIds
            .map(id => document.getElementById(id))
            .filter((el): el is HTMLElement => el !== null);

        if (headings.length === 0) return;

        const observer = new IntersectionObserver(
            () => {
                let active = headings[0]!.id;
                for (const heading of headings) {
                    if (heading.getBoundingClientRect().top <= 120) {
                        active = heading.id;
                    }
                }
                let activeLink: HTMLAnchorElement | null = null;
                links.forEach(link => {
                    const isActive = link.hash === `#${active}`;
                    link.classList.toggle('active', isActive);
                    if (isActive) activeLink = link;
                });
                if (activeLink) {
                    const toc = (activeLink as HTMLAnchorElement).closest('.sp-post-toc') as HTMLElement | null;
                    if (toc) {
                        const tocRect = toc.getBoundingClientRect();
                        const linkRect = (activeLink as HTMLAnchorElement).getBoundingClientRect();
                        const padding = 16;
                        if (linkRect.top < tocRect.top + padding) {
                            toc.scrollBy({ top: linkRect.top - tocRect.top - padding, behavior: 'smooth' });
                        } else if (linkRect.bottom > tocRect.bottom - padding) {
                            toc.scrollBy({ top: linkRect.bottom - tocRect.bottom + padding, behavior: 'smooth' });
                        }
                    }
                }
            },
            { rootMargin: '-80px 0px -70% 0px', threshold: 0 },
        );

        headings.forEach(h => observer.observe(h));
    }

    initToc();
</script>
) : (
<BaseLayout title={seoTitle} description={seoDescription}>
    <SchemaGraph pageContext={pageContext} />
    <div class="sp-root sp-blocks sp-post" data-pagefind-body>
        <section class="sp-post-hero">
            <div class="sp-section-inner">
                <h1 class="sp-post-title">{pageData!.title}</h1>
            </div>
        </section>
        <section class="sp-post-body">
            <div class:list={['sp-post-grid', { 'sp-no-toc': !hasToc }]}>
                {hasToc && <TableOfContents headings={headings} />}
                <article class="sp-prose">
                    <Content />
                </article>
            </div>
        </section>
    </div>
</BaseLayout>
)}
