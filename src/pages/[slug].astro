---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import avatar from '../assets/images/joost-headshot.jpg';
import FormattedDate from '../components/FormattedDate.astro';
import SchemaGraph from '../components/SchemaGraph.astro';
import type { SchemaPageContext } from '../utils/schema';
import { canonicalUrl } from '../utils/schema/constants';
import BaseLayout from '../layouts/BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { sortPostsByDateDesc, slugify, getReadingTime, getRelatedPosts } from '../utils/post-utils';
import { gitLastmod } from '../utils/sitemap';
import fs from 'node:fs';

function resolvePostPath(entryId: string): string | null {
    const md = `src/content/blog/${entryId}/index.md`;
    const mdx = `src/content/blog/${entryId}/index.mdx`;
    if (fs.existsSync(md)) return md;
    if (fs.existsSync(mdx)) return mdx;
    return null;
}

function computeUpdatedDate(entryId: string, manual: Date | undefined, publishDate: Date): Date | null {
    if (manual) return manual;
    const fp = resolvePostPath(entryId);
    if (!fp) return null;
    const last = gitLastmod(fp);
    if (!last) return null;
    return last.getTime() - publishDate.getTime() > 24 * 60 * 60 * 1000 ? last : null;
}

function stripTitle(s: string): string {
    return s.replace(/\*([^*]+)\*/g, '$1');
}
function emTitle(s: string): string {
    return s.replace(/\*([^*]+)\*/g, '<em>$1</em>');
}

export async function getStaticPaths() {
    const posts = (await getCollection('blog')).sort(sortPostsByDateDesc);
    const pages = await getCollection('pages');

    const blogPaths = posts.map((post, i) => ({
        params: { slug: post.id },
        props: {
            entry: post,
            type: 'blog' as const,
            readingTime: getReadingTime(post.body ?? ''),
            relatedPosts: getRelatedPosts(post, posts),
            // posts sorted newest-first: i-1 is newer ("Next"), i+1 is older ("Previous")
            newer: i > 0 ? { id: posts[i - 1].id, title: posts[i - 1].data.title } : null,
            older: i < posts.length - 1 ? { id: posts[i + 1].id, title: posts[i + 1].data.title } : null
        }
    }));

    const pagePaths = pages
        .filter(
            (page) =>
                page.id !== 'videos' &&
                page.id !== 'clicky' &&
                page.id !== 'about-me' &&
                page.id !== 'contact-me' &&
                page.id !== 'cms-market-share' &&
                page.data.section !== 'code'
        )
        .map((page) => ({
            params: { slug: page.id },
            props: { entry: page, type: 'page' as const, readingTime: 0, relatedPosts: [], newer: null, older: null }
        }));

    return [...blogPaths, ...pagePaths];
}

const { entry, type, readingTime, relatedPosts, newer, older } = Astro.props;
const { Content, headings } = await render(entry);

const isBlog = type === 'blog';
const blogData = isBlog ? (entry as CollectionEntry<'blog'>).data : null;
const pageData = !isBlog ? (entry as CollectionEntry<'pages'>).data : null;

const effectiveUpdatedDate = isBlog ? computeUpdatedDate(entry.id, blogData!.updatedDate, blogData!.publishDate) : null;

function stripHtml(s: string): string {
    return s.replace(/<[^>]+>/g, '');
}

const seoTitle = isBlog ? (blogData!.seo?.title ?? stripHtml(stripTitle(blogData!.title))) : (pageData!.seo?.title ?? stripHtml(pageData!.title));
const seoDescription = isBlog ? (blogData!.seo?.description ?? blogData!.excerpt) : pageData!.seo?.description;

const pageCanonicalUrl = canonicalUrl(Astro.url.pathname);

const pageContext: SchemaPageContext = isBlog
    ? {
          pageType: 'blogPost',
          canonicalUrl: pageCanonicalUrl,
          title: stripHtml(stripTitle(blogData!.title)),
          description: blogData!.excerpt ?? blogData!.seo?.description ?? '',
          publishDate: blogData!.publishDate,
          updatedDate: effectiveUpdatedDate ?? undefined,
          featureImageUrl: canonicalUrl(`/og/${entry.id}.webp`),
          categories: blogData!.categories,
          wordCount: (entry.body ?? '').split(/\s+/).length
      }
    : {
          pageType: entry.id === 'about-me' ? 'about' : 'page',
          canonicalUrl: pageCanonicalUrl,
          title: pageData!.title,
          description: pageData!.seo?.description ?? ''
      };

const categories = blogData?.categories ?? [];
const primaryCategory = categories[0] ?? null;

const hasToc = !!(isBlog ? blogData!.toc : pageData!.toc) && headings.some((h) => h.depth === 2 || h.depth === 3);
---

{
    isBlog ? (
        <BaseLayout
            title={seoTitle}
            description={seoDescription}
            pageType="article"
            publishDate={blogData!.publishDate}
            updatedDate={effectiveUpdatedDate ?? undefined}
            categories={blogData!.categories}
            noindex={!!blogData!.draft}
        >
            <SchemaGraph pageContext={pageContext} />
            <div class="sp-root sp-post">
                <article class="post-article" data-pagefind-body>
                    <a href="/blog/" class="post-back">
                        ← all writing
                    </a>

                    <div class="post-meta">
                        {primaryCategory && (
                            <a class="post-cat-pill" href={`/category/${slugify(primaryCategory)}/`}>
                                {primaryCategory}
                            </a>
                        )}
                        <span>
                            <FormattedDate date={blogData!.publishDate} />
                        </span>
                        {readingTime > 0 && (
                            <>
                                <span>·</span>
                                <span>{readingTime} min read</span>
                            </>
                        )}
                    </div>

                    <h1 class="post-title" set:html={emTitle(blogData!.title)} />

                    {blogData!.excerpt && <p class="post-standfirst">{blogData!.excerpt}</p>}

                    <div class="post-author">
                        <Image src={avatar} alt="Joost de Valk" width={84} loading="eager" />
                        <div class="name">Joost de Valk</div>
                    </div>

                    {hasToc && <TableOfContents headings={headings} />}

                    <div class="sp-prose sp-prose--dropcap">
                        <Content />
                    </div>

                    {categories.length > 0 && (
                        <div class="post-tags">
                            <span class="post-tags-label">Filed under</span>
                            {categories.map((cat) => (
                                <a href={`/category/${slugify(cat)}/`} class="post-tag">
                                    {cat}
                                </a>
                            ))}
                        </div>
                    )}
                </article>

                {(newer || older) && (
                    <nav class="post-nav" aria-label="More writing">
                        {older ? (
                            <a href={`/${older.id}/`} class="post-nav-cell">
                                <div class="lbl">← Previous</div>
                                <div class="ttl" set:html={emTitle(older.title)} />
                            </a>
                        ) : (
                            <span class="post-nav-cell post-nav-empty" />
                        )}
                        {newer ? (
                            <a href={`/${newer.id}/`} class="post-nav-cell post-nav-next">
                                <div class="lbl">Next →</div>
                                <div class="ttl" set:html={emTitle(newer.title)} />
                            </a>
                        ) : (
                            <span class="post-nav-cell post-nav-empty" />
                        )}
                    </nav>
                )}

                {relatedPosts && relatedPosts.length > 0 && (
                    <section class="post-related" data-pagefind-ignore="all">
                        <div class="sp-section-head">
                            <h2>Related writing</h2>
                            <span class="sp-section-meta">From the archive</span>
                        </div>
                        <div class="post-related-grid">
                            {relatedPosts.slice(0, 3).map((rel) => (
                                <a href={`/${rel.id}/`} class="post-related-card">
                                    <div class="date">
                                        <FormattedDate date={rel.data.publishDate} />
                                        {` · ${getReadingTime(rel.body ?? '')} min`}
                                    </div>
                                    <h3 set:html={emTitle(rel.data.title)} />
                                    {rel.data.excerpt && <p>{rel.data.excerpt}</p>}
                                </a>
                            ))}
                        </div>
                    </section>
                )}
            </div>
        </BaseLayout>
    ) : (
        <BaseLayout title={seoTitle} description={seoDescription}>
            <SchemaGraph pageContext={pageContext} />
            <div class="sp-root sp-post" data-pagefind-body>
                <section class="sp-post-hero">
                    <div class="sp-section-inner">
                        <h1 class="sp-post-title">{pageData!.title}</h1>
                    </div>
                </section>
                <section class="sp-post-body">
                    <div class="sp-prose">
                        <Content />
                    </div>
                </section>
            </div>
        </BaseLayout>
    )
}

<style>
    .post-article {
        max-width: var(--measure);
        margin: 0 auto;
        padding: 56px 0 24px;
    }
    .post-back {
        font-family: var(--font-mono);
        font-size: 12px;
        letter-spacing: 0.04em;
        color: var(--accent);
        text-decoration: none;
    }
    .post-back:hover {
        opacity: 0.7;
    }
    .post-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 14px;
        margin: 26px 0 18px;
        font-family: var(--font-mono);
        font-size: 11.5px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--faint);
    }
    .post-cat-pill {
        color: var(--accent);
        background: rgba(95, 117, 96, 0.16);
        padding: 4px 9px;
        text-decoration: none;
    }
    .post-cat-pill:hover {
        background: var(--accent-soft);
    }
    .post-title {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: clamp(40px, 5vw, 60px);
        line-height: 1.02;
        letter-spacing: -0.02em;
        color: var(--ink);
        margin: 0;
    }
    .post-title :global(em) {
        font-style: italic;
        font-weight: 500;
    }
    .post-standfirst {
        font-family: var(--font-text);
        font-weight: 300;
        font-style: italic;
        font-size: 23px;
        line-height: 1.5;
        color: var(--secondary);
        margin: 24px 0 0;
    }
    .post-author {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 30px 0 40px;
        padding-top: 24px;
        border-top: 1px solid rgba(31, 37, 48, 0.14);
    }
    .post-author :global(img) {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        object-fit: cover;
    }
    .post-author .name {
        font-family: var(--font-text);
        font-size: 16px;
        color: var(--ink);
        line-height: 1.3;
    }
    .post-author .sub {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--faint);
    }
    .post-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin: 44px 0 0;
        padding-top: 26px;
        border-top: 1px solid rgba(31, 37, 48, 0.14);
    }
    .post-tags-label {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.06em;
        color: var(--faint);
        text-transform: uppercase;
        align-self: center;
    }
    .post-tag {
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--accent);
        text-decoration: none;
        border: 1px solid rgba(95, 117, 96, 0.4);
        padding: 5px 11px;
    }
    .post-tag:hover {
        background: rgba(95, 117, 96, 0.12);
    }
    .post-nav {
        max-width: var(--measure);
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
        padding: 8px 0 16px;
    }
    .post-nav-cell {
        text-decoration: none;
        padding: 20px 0;
        border-top: 2px solid var(--rule);
    }
    .post-nav-cell.post-nav-next {
        text-align: right;
    }
    .post-nav-empty {
        border-top: none;
    }
    .post-nav-cell .lbl {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.06em;
        color: var(--faint);
        text-transform: uppercase;
    }
    .post-nav-cell .ttl {
        font-family: var(--font-text);
        font-size: 19px;
        color: var(--ink);
        margin-top: 8px;
    }
    .post-nav-cell:hover {
        opacity: 0.7;
    }

    .post-related {
        max-width: 960px;
        margin: 24px auto 0;
        padding: 8px 0 48px;
    }
    .post-related .sp-section-head {
        margin-bottom: 0;
    }
    .post-related-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 24px;
        padding-top: 26px;
    }
    .post-related-card {
        text-decoration: none;
        background: var(--card);
        border: 1px solid rgba(31, 37, 48, 0.12);
        padding: 22px;
        display: block;
        transition: border-color 0.15s;
    }
    .post-related-card:hover {
        border-color: var(--accent);
    }
    .post-related-card .date {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--faint);
    }
    .post-related-card h3 {
        font-family: var(--font-display);
        font-weight: 500;
        font-size: 20px;
        line-height: 1.2;
        color: var(--ink);
        margin: 12px 0 0;
    }
    .post-related-card h3 :global(em) {
        font-style: italic;
    }
    .post-related-card p {
        font-family: var(--font-text);
        font-size: 14.5px;
        line-height: 1.5;
        color: var(--muted);
        margin: 8px 0 0;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    @media (max-width: 720px) {
        .post-related-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<script>
    function initToc() {
        const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
        if (links.length === 0) return;

        const headings = links
            .map((l) => document.getElementById(l.hash.slice(1)))
            .filter((el): el is HTMLElement => el !== null);
        if (headings.length === 0) return;

        const setActive = (id: string | null) => {
            links.forEach((link) => link.classList.toggle('active', id !== null && link.hash === `#${id}`));
        };

        const observer = new IntersectionObserver(
            () => {
                let active: string | null = null;
                for (const heading of headings) {
                    if (heading.getBoundingClientRect().top <= 160) active = heading.id;
                }
                setActive(active);
            },
            { rootMargin: '-140px 0px -70% 0px', threshold: 0 }
        );
        headings.forEach((h) => observer.observe(h));
    }

    initToc();
</script>
