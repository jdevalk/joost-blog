---
import BaseLayout from '../layouts/BaseLayout.astro';
import Search from 'astro-pagefind/components/Search';
---

<BaseLayout title="Search" description="Search all blog posts, videos, and pages on Joost.blog — covering SEO, WordPress, open source, AI, and the open web.">
    <div class="sp-root">
        <section class="sp-hero search-hero">
            <h1 class="sp-display">Search</h1>
            <p class="sp-section-lede">Find anything across the writing, talks, and research.</p>
        </section>
        <div class="search-box" data-pagefind-ignore="all">
            <Search
                id="search"
                className="pagefind-ui"
                uiOptions={{ showSubResults: true, showImages: true, showEmptyFilters: false, pageSize: 10, resetStyles: true }}
            />
        </div>
    </div>
</BaseLayout>

<style>
    .search-hero {
        padding: 60px 0 24px;
    }
    .search-box {
        padding: 0 0 64px;
    }
</style>

<style is:global>
    :root {
        --pagefind-ui-scale: 1;
        --pagefind-ui-primary: #5f7560;
        --pagefind-ui-text: #1b2028;
        --pagefind-ui-background: #eceae3;
        --pagefind-ui-border: rgba(31, 37, 48, 0.2);
        --pagefind-ui-tag: #e0e3da;
        --pagefind-ui-border-width: 1px;
        --pagefind-ui-border-radius: 2px;
        --pagefind-ui-image-border-radius: 2px;
        --pagefind-ui-image-box-ratio: 3 / 2;
        --pagefind-ui-font: var(--font-text);
    }
    .pagefind-ui__result-title,
    .pagefind-ui__result-link {
        font-family: var(--font-display);
    }
</style>

<script>
    function syncSearchInputFromUrl() {
        const input = document.querySelector<HTMLInputElement>('.pagefind-ui__search-input');
        if (!input) return;

        const query = new URLSearchParams(window.location.search).get('q') || '';
        if (input.value !== query) {
            input.value = query;
            input.dispatchEvent(new Event('input', { bubbles: true }));
        }
    }

    function initSearch() {
        // Wait for Pagefind UI to render its input, then sync query and wire URL sync once.
        const observer = new MutationObserver(() => {
            const input = document.querySelector<HTMLInputElement>('.pagefind-ui__search-input');
            if (!input) return;
            observer.disconnect();

            syncSearchInputFromUrl();

            if (input.dataset.urlSyncBound === 'true') return;
            input.dataset.urlSyncBound = 'true';

            input.addEventListener('input', () => {
                const url = new URL(window.location.href);
                if (input.value) {
                    url.searchParams.set('q', input.value);
                } else {
                    url.searchParams.delete('q');
                }
                history.replaceState(null, '', url.toString());
            });
        });

        observer.observe(document.body, { childList: true, subtree: true });
    }

    initSearch();
    window.addEventListener('pageshow', syncSearchInputFromUrl);
    window.addEventListener('popstate', syncSearchInputFromUrl);
</script>
