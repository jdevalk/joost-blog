---
import BaseLayout from '../layouts/BaseLayout.astro';
import cmsData from '../../cms_usage_stats.json';

// Pre-process data at build time
const allMonths = [...new Set(cmsData.flatMap((item: any) => Object.keys(item.stats)))].sort();
const latestMonth = allMonths[allMonths.length - 1];
const latestMonthLabel = new Date(latestMonth + '-01').toLocaleDateString('en-US', { month: 'long', year: 'numeric' });

// Compute total sites with a detected CMS per month
const monthTotals: Record<string, number> = {};
for (const item of cmsData) {
    for (const [month, count] of Object.entries(item.stats as Record<string, number>)) {
        monthTotals[month] = (monthTotals[month] || 0) + count;
    }
}
const latestTotal = monthTotals[latestMonth];
const totalSitesInDataset = 96_862_182; // Total sites in DomainCrawler dataset (queried March 2026)

// Estimate total dataset size per month by scaling proportionally:
// we know the current ratio of CMS sites to total sites, apply it historically
const cmsToTotalRatio = latestTotal / totalSitesInDataset;
const estimatedTotalByMonth: Record<string, number> = {};
for (const [month, cmsTotal] of Object.entries(monthTotals)) {
    estimatedTotalByMonth[month] = cmsTotal / cmsToTotalRatio;
}

// Build ranked list with latest value, market share, YoY change, and sparkline data
const processed = cmsData
    .map((item: any) => {
        const entries = Object.entries(item.stats as Record<string, number>).sort(([a], [b]) => a.localeCompare(b));
        if (entries.length === 0) return null;

        const latest = entries[entries.length - 1][1];
        const share = latest / totalSitesInDataset;

        // Find value from roughly 12 months before the latest
        const latestDate = new Date(entries[entries.length - 1][0] + '-01');
        const yearAgoTarget = new Date(latestDate);
        yearAgoTarget.setFullYear(yearAgoTarget.getFullYear() - 1);
        const yearAgoKey = yearAgoTarget.toISOString().slice(0, 7);

        let prevValue: number | null = null;
        let prevMonth: string | null = null;
        for (const [month, val] of entries) {
            if (month <= yearAgoKey) { prevValue = val; prevMonth = month; }
        }

        // YoY change based on market share, not raw count
        let changePct: number | null = null;
        if (prevValue && prevValue > 0 && prevMonth && estimatedTotalByMonth[prevMonth]) {
            const prevShare = prevValue / estimatedTotalByMonth[prevMonth];
            changePct = Math.round(((share - prevShare) / prevShare) * 1000) / 10;
        }

        // Sparkline: last 12 data points as market share %
        const sparkData = entries.slice(-12).map(([m, v]) => {
            const total = estimatedTotalByMonth[m];
            return total ? (v / total) * 100 : 0;
        });

        return {
            name: item.technology,
            latest,
            share,
            changePct,
            sparkData,
            timeline: Object.fromEntries(entries),
        };
    })
    .filter(Boolean)
    .sort((a: any, b: any) => b.latest - a.latest);

const wpShare = processed[0].share;

// Prepare chart data for top 10 — show market share % over time
const top10 = processed.slice(0, 10);
const chartMonths = allMonths;

// Serialize for client-side use
const clientData = JSON.stringify({
    items: processed.map((item: any) => ({
        name: item.name,
        latest: item.latest,
        share: item.share,
        changePct: item.changePct,
        sparkData: item.sparkData,
    })),
    top10Timeline: top10.map((item: any) => ({
        name: item.name,
        data: chartMonths.map((m: string) => {
            const val = item.timeline[m];
            if (val == null || !estimatedTotalByMonth[m]) return null;
            return (val / estimatedTotalByMonth[m]) * 100;
        }),
    })),
    months: chartMonths,
});
---

<BaseLayout
    title="CMS Usage Statistics"
    description="Monthly usage statistics for 343 content management systems, tracking millions of websites worldwide."
    noindex={true}
>
    <main class="px-4 py-12 grow sm:px-8 sm:py-16" data-pagefind-body>
        <div class="max-w-6xl mx-auto">
            <header class="max-w-3xl mx-auto mb-12">
                <h1 class="text-4xl font-bold text-slate-900 dark:text-slate-100 sm:text-5xl">CMS Usage Statistics</h1>
                <p class="mt-4 text-lg text-slate-600 dark:text-slate-400">
                    Tracking <strong class="text-slate-900 dark:text-slate-100">{processed.length}</strong> content management systems across
                    <strong class="text-slate-900 dark:text-slate-100">{latestTotal.toLocaleString('en-US')}</strong> websites with a detected CMS.
                    Market share is calculated per month based on all CMS-identified sites in that period.
                    Data sourced from <a href="https://domaincrawler.com/" class="text-primary dark:text-accent underline decoration-1 underline-offset-2 hover:no-underline">DomainCrawler</a>, as of {latestMonthLabel}.
                </p>
            </header>

            <!-- Key stats cards -->
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 mb-12">
                <div class="rounded-xl border border-slate-200 dark:border-[#2a2623] bg-white dark:bg-[#1e1b19]/50 p-6">
                    <p class="text-sm font-medium text-slate-500 dark:text-slate-400">Total Sites in Dataset</p>
                    <p class="mt-1 text-3xl font-bold text-slate-900 dark:text-slate-100">{(totalSitesInDataset / 1_000_000).toFixed(1)}M</p>
                    <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">domains tracked</p>
                </div>
                <div class="rounded-xl border border-slate-200 dark:border-[#2a2623] bg-white dark:bg-[#1e1b19]/50 p-6">
                    <p class="text-sm font-medium text-slate-500 dark:text-slate-400">Sites with Detected CMS</p>
                    <p class="mt-1 text-3xl font-bold text-slate-900 dark:text-slate-100">{(latestTotal / 1_000_000).toFixed(1)}M</p>
                    <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{((latestTotal / totalSitesInDataset) * 100).toFixed(1)}% of all sites</p>
                </div>
                <div class="rounded-xl border border-slate-200 dark:border-[#2a2623] bg-white dark:bg-[#1e1b19]/50 p-6">
                    <p class="text-sm font-medium text-slate-500 dark:text-slate-400">Market Leader</p>
                    <p class="mt-1 text-3xl font-bold text-primary dark:text-accent">WordPress</p>
                    <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{(wpShare * 100).toFixed(1)}% of all sites</p>
                </div>
                <div class="rounded-xl border border-slate-200 dark:border-[#2a2623] bg-white dark:bg-[#1e1b19]/50 p-6">
                    <p class="text-sm font-medium text-slate-500 dark:text-slate-400">CMSes Tracked</p>
                    <p class="mt-1 text-3xl font-bold text-slate-900 dark:text-slate-100">{processed.length}</p>
                    <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">from {allMonths[0]} to {latestMonth}</p>
                </div>
            </div>

            <!-- Top 10 chart -->
            <section class="mb-12">
                <h2 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mb-6">Top 10 CMS Market Share Over Time</h2>
                <div class="rounded-xl border border-slate-200 dark:border-[#2a2623] bg-white dark:bg-[#1e1b19]/50 p-4 sm:p-6">
                    <canvas id="trendChart" class="w-full" style="height: 400px;"></canvas>
                    <div id="chartLegend" class="mt-4 flex flex-wrap gap-3 text-sm"></div>
                </div>
            </section>

            <!-- Search and table -->
            <section>
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                    <h2 class="text-2xl font-bold text-slate-900 dark:text-slate-100">All CMS Rankings</h2>
                    <div class="relative">
                        <input
                            type="text"
                            id="cmsSearch"
                            placeholder="Search CMSes..."
                            class="w-full sm:w-64 px-4 py-2 pl-10 rounded-lg border border-slate-200 dark:border-[#2a2623] bg-white dark:bg-[#1e1b19] text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-primary dark:focus:ring-accent"
                        />
                        <svg class="absolute left-3 top-2.5 h-5 w-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                    </div>
                </div>

                <div class="rounded-xl border border-slate-200 dark:border-[#2a2623] overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="w-full text-left">
                            <thead class="bg-slate-50 dark:bg-[#2a2623]/50">
                                <tr>
                                    <th class="px-4 py-3 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider w-12">#</th>
                                    <th class="px-4 py-3 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">CMS</th>
                                    <th class="px-4 py-3 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider text-right">Sites</th>
                                    <th class="px-4 py-3 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider text-right">Share</th>
                                    <th class="px-4 py-3 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider text-right">YoY</th>
                                    <th class="px-4 py-3 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider text-right w-24">Trend</th>
                                </tr>
                            </thead>
                            <tbody id="cmsTableBody" class="divide-y divide-slate-100 dark:divide-slate-700/50">
                                {processed.map((item: any, index: number) => (
                                    <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30 transition-colors cms-row" data-name={item.name.toLowerCase()}>
                                        <td class="px-4 py-3 text-sm text-slate-400 dark:text-slate-500 font-mono">{index + 1}</td>
                                        <td class="px-4 py-3 text-sm font-medium text-slate-900 dark:text-slate-100">{item.name}</td>
                                        <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-300 text-right font-mono">
                                            {item.latest >= 1_000_000
                                                ? (item.latest / 1_000_000).toFixed(1) + 'M'
                                                : item.latest >= 1_000
                                                  ? (item.latest / 1_000).toFixed(1) + 'K'
                                                  : item.latest.toLocaleString('en-US')}
                                        </td>
                                        <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-300 text-right font-mono">
                                            {(item.share * 100).toFixed(2)}%
                                        </td>
                                        <td class={`px-4 py-3 text-sm text-right font-mono ${
                                            item.changePct === null
                                                ? 'text-slate-400'
                                                : item.changePct > 0
                                                  ? 'text-emerald-600 dark:text-emerald-400'
                                                  : item.changePct < 0
                                                    ? 'text-red-500 dark:text-red-400'
                                                    : 'text-slate-400'
                                        }`}>
                                            {item.changePct === null ? '—' : (item.changePct > 0 ? '+' : '') + item.changePct + '%'}
                                        </td>
                                        <td class="px-4 py-3">
                                            <svg class="sparkline w-20 h-6 ml-auto" data-values={item.sparkData.join(',')} viewBox="0 0 80 24"></svg>
                                        </td>
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    </div>
                </div>
                <p id="noResults" class="hidden mt-4 text-center text-slate-500 dark:text-slate-400 py-8">No CMSes found matching your search.</p>
            </section>
        </div>
    </main>

    <script is:inline define:vars={{ clientData }}>
        const data = JSON.parse(clientData);

        // Draw sparklines
        document.querySelectorAll('.sparkline').forEach((svg) => {
            const values = svg.dataset.values.split(',').map(Number);
            if (values.length < 2) return;

            const min = Math.min(...values);
            const max = Math.max(...values);
            const range = max - min || 1;

            const points = values.map((v, i) => {
                const x = (i / (values.length - 1)) * 80;
                const y = 22 - ((v - min) / range) * 20;
                return `${x},${y}`;
            });

            const trending = values[values.length - 1] >= values[0];
            const color = trending ? '#10b981' : '#ef4444';

            svg.innerHTML = `<polyline points="${points.join(' ')}" fill="none" stroke="${color}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>`;
        });

        // Search filter
        const searchInput = document.getElementById('cmsSearch');
        const rows = document.querySelectorAll('.cms-row');
        const noResults = document.getElementById('noResults');

        searchInput.addEventListener('input', (e) => {
            const query = e.target.value.toLowerCase().trim();
            let visible = 0;
            rows.forEach((row) => {
                const match = !query || row.dataset.name.includes(query);
                row.style.display = match ? '' : 'none';
                if (match) visible++;
            });
            noResults.classList.toggle('hidden', visible > 0);
        });

        // Chart
        const canvas = document.getElementById('trendChart');
        const ctx = canvas.getContext('2d');
        const dpr = window.devicePixelRatio || 1;

        const COLORS = [
            '#2563eb', '#dc2626', '#16a34a', '#d97706', '#7c3aed',
            '#0891b2', '#db2777', '#65a30d', '#ea580c', '#6366f1'
        ];

        function drawChart() {
            const rect = canvas.getBoundingClientRect();
            canvas.width = rect.width * dpr;
            canvas.height = rect.height * dpr;
            ctx.scale(dpr, dpr);

            const w = rect.width;
            const h = rect.height;
            const pad = { top: 20, right: 20, bottom: 40, left: 70 };
            const plotW = w - pad.left - pad.right;
            const plotH = h - pad.top - pad.bottom;

            ctx.clearRect(0, 0, w, h);

            const months = data.months;
            const series = data.top10Timeline;

            // Find global max (excluding WordPress which would squash everything)
            // Data is now in market share % (e.g. 10.5 = 10.5%)
            let globalMax = 0;
            for (const s of series.slice(1)) {
                for (const v of s.data) {
                    if (v !== null && v > globalMax) globalMax = v;
                }
            }
            globalMax = Math.ceil(globalMax * 1.1);

            const isDark = document.documentElement.classList.contains('dark');
            const textColor = isDark ? '#94a3b8' : '#64748b';
            const gridColor = isDark ? 'rgba(148,163,184,0.1)' : 'rgba(100,116,139,0.08)';

            // Grid lines
            ctx.strokeStyle = gridColor;
            ctx.lineWidth = 1;
            const yTicks = 5;
            ctx.font = '11px system-ui, sans-serif';
            ctx.fillStyle = textColor;
            ctx.textAlign = 'right';
            ctx.textBaseline = 'middle';

            for (let i = 0; i <= yTicks; i++) {
                const y = pad.top + (plotH / yTicks) * i;
                const val = globalMax - (globalMax / yTicks) * i;
                ctx.beginPath();
                ctx.moveTo(pad.left, y);
                ctx.lineTo(w - pad.right, y);
                ctx.stroke();

                const label = val.toFixed(1) + '%';
                ctx.fillText(label, pad.left - 8, y);
            }

            // X labels (every 6 months)
            ctx.textAlign = 'center';
            ctx.textBaseline = 'top';
            for (let i = 0; i < months.length; i += 6) {
                const x = pad.left + (i / (months.length - 1)) * plotW;
                ctx.fillText(months[i], x, h - pad.bottom + 8);
            }

            // Draw series (skip WordPress = index 0, draw it separately or note it)
            for (let si = series.length - 1; si >= 1; si--) {
                const s = series[si];
                ctx.strokeStyle = COLORS[si];
                ctx.lineWidth = 2;
                ctx.beginPath();
                let started = false;
                for (let i = 0; i < s.data.length; i++) {
                    if (s.data[i] === null) continue;
                    const x = pad.left + (i / (months.length - 1)) * plotW;
                    const y = pad.top + plotH - (s.data[i] / globalMax) * plotH;
                    if (!started) {
                        ctx.moveTo(x, y);
                        started = true;
                    } else {
                        ctx.lineTo(x, y);
                    }
                }
                ctx.stroke();
            }

            // Legend
            const legend = document.getElementById('chartLegend');
            legend.innerHTML = series.slice(1).map((s, i) =>
                `<span class="inline-flex items-center gap-1.5"><span class="w-3 h-3 rounded-full inline-block" style="background:${COLORS[i + 1]}"></span><span class="text-slate-600 dark:text-slate-400">${s.name}</span></span>`
            ).join('');

            // Add WordPress note
            const wpLatest = series[0].data.filter(v => v !== null).pop();
            legend.innerHTML = `<span class="inline-flex items-center gap-1.5 text-slate-500 dark:text-slate-400 italic">WordPress (${wpLatest.toFixed(1)}%) omitted for scale</span>` + legend.innerHTML;
        }

        drawChart();
        window.addEventListener('resize', drawChart);

        // Redraw on theme change
        const observer = new MutationObserver(() => drawChart());
        observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
    </script>
</BaseLayout>
