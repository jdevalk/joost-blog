---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const isDev = import.meta.env.DEV;

const drafts = isDev
    ? (await getCollection('blog'))
          .filter((post) => post.data.draft)
          .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())
    : [];

function fmtDate(date: Date): string {
    return date.toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'short',
        day: 'numeric'
    });
}
---

<BaseLayout title="Drafts" description="Local-only listing of draft posts." noindex={true}>
    <main class="drafts-main">
        <div class="drafts-inner">
            {
                !isDev && (
                    <>
                        <h1>Drafts</h1>
                        <p>This page is only available when running the dev server locally.</p>
                    </>
                )
            }

            {
                isDev && (
                    <>
                        <h1>
                            Drafts <span class="drafts-count">({drafts.length})</span>
                        </h1>
                        <p class="drafts-note">
                            Local dev only. Posts with <code>draft: true</code>. A<code>password</code> field means the production middleware gates the post.
                        </p>

                        {drafts.length === 0 && <p>No drafts.</p>}

                        {drafts.length > 0 && (
                            <table class="drafts-table">
                                <thead>
                                    <tr>
                                        <th>Title</th>
                                        <th>Slug</th>
                                        <th>Date</th>
                                        <th>Password</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {drafts.map((post) => (
                                        <tr>
                                            <td>
                                                <a href={`/${post.id}/`} set:html={post.data.title} />
                                            </td>
                                            <td>
                                                <code>{post.id}</code>
                                            </td>
                                            <td>{fmtDate(new Date(post.data.publishDate))}</td>
                                            <td>{post.data.password ? <code>{post.data.password}</code> : <span class="drafts-muted">unlisted</span>}</td>
                                        </tr>
                                    ))}
                                </tbody>
                            </table>
                        )}
                    </>
                )
            }
        </div>
    </main>
</BaseLayout>

<style>
    .drafts-main {
        padding: 64px 64px 80px;
    }
    .drafts-inner {
        max-width: 1100px;
        margin: 0 auto;
    }
    .drafts-inner h1 {
        font-family: var(--font-display);
        font-weight: var(--weight-display);
        font-size: clamp(36px, 5vw, 56px);
        margin: 0 0 12px;
    }
    .drafts-count {
        font-family: var(--font-mono);
        font-size: 0.45em;
        color: var(--ink-soft);
        vertical-align: middle;
    }
    .drafts-note {
        color: var(--ink-soft);
        margin: 0 0 32px;
    }
    .drafts-note code {
        font-family: var(--font-mono);
        font-size: 0.9em;
    }
    .drafts-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }
    .drafts-table th,
    .drafts-table td {
        text-align: left;
        padding: 10px 12px;
        border-bottom: 1px solid color-mix(in srgb, var(--ink) 15%, transparent);
        vertical-align: top;
    }
    .drafts-table th {
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--ink-soft);
        border-bottom: 1px solid var(--ink);
    }
    .drafts-table code {
        font-family: var(--font-mono);
        font-size: 12px;
    }
    .drafts-table a {
        color: var(--ink);
        text-decoration: none;
        border-bottom: 1px solid color-mix(in srgb, var(--ink) 30%, transparent);
    }
    .drafts-table a:hover {
        color: var(--ox);
        border-bottom-color: var(--ox);
    }
    .drafts-muted {
        color: var(--ink-soft);
        font-style: italic;
    }
    @media (max-width: 768px) {
        .drafts-main {
            padding: 40px 24px 60px;
        }
    }
</style>
