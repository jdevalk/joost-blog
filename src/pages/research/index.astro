---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchemaGraph from '../../components/SchemaGraph.astro';
import type { SchemaPageContext } from '../../utils/schema';
import { canonicalUrl } from '../../utils/schema/constants';

const title = 'Research';
const description = 'Data reports and web-technology studies — measured properly, updated over time, and free for anyone to use.';

const pageContext: SchemaPageContext = {
    pageType: 'page',
    canonicalUrl: canonicalUrl('/research/'),
    title,
    description
};

// Representative shares; the live figures live on /cms-market-share/.
const cms = [
    { name: 'WordPress', pct: 43.5 },
    { name: 'Shopify', pct: 4.4 },
    { name: 'Wix', pct: 3.7 },
    { name: 'Squarespace', pct: 3.0 },
    { name: 'Joomla', pct: 1.7 },
    { name: 'Drupal', pct: 1.1 }
];
const maxPct = Math.max(...cms.map((c) => c.pct));
function barWidth(pct: number): number {
    return Math.round((pct / maxPct) * 1000) / 10;
}
function barColor(pct: number): string {
    if (pct >= 30) return '#7c9a7e';
    if (pct >= 2) return '#5f7560';
    return '#4d6050';
}
---

<BaseLayout title={title} description={description}>
    <SchemaGraph pageContext={pageContext} />

    <div class="sp-root sp-research" data-pagefind-body>
        <section class="research-hero">
            <h1 class="sp-display">Research</h1>
            <p class="sp-section-lede">Data reports and web-technology studies — measured properly, updated over time, and free for anyone to use.</p>
        </section>

        <a href="/cms-market-share/" class="research-featured">
            <div class="body">
                <span class="eyebrow">Flagship report · monthly</span>
                <h2>CMS Market Share</h2>
                <p>Monthly CMS market share based on the HTTP Archive — WordPress, Shopify, Wix, Squarespace and more, tracked over time.</p>
                <span class="explore">explore the data →</span>
            </div>
            <div class="chart">
                <div class="chart-label">Share of all websites · {new Date().getFullYear()}</div>
                {
                    cms.map((c) => (
                        <div class="bar-row">
                            <span class="bar-name">{c.name}</span>
                            <span class="bar-track">
                                <span class="bar-fill" style={`width:${barWidth(c.pct)}%;background:${barColor(c.pct)}`} />
                            </span>
                            <span class="bar-pct">{c.pct}%</span>
                        </div>
                    ))
                }
            </div>
        </a>

        <section class="research-cards">
            <a href="/research/plugin-stats/" class="research-card">
                <span class="lbl">Live dataset</span>
                <h2>Plugin Stats</h2>
                <p>Active installs and download numbers for WordPress plugins, pulled from the WordPress.org directory and visualized over time.</p>
                <div class="spark">
                    <span style="height:38%"></span><span style="height:52%"></span><span style="height:46%"></span><span style="height:64%"></span>
                    <span style="height:71%"></span><span style="height:83%"></span><span style="height:100%"></span>
                </div>
                <span class="more">view the report →</span>
            </a>
            <a href="/use-avif-webp-share-images/" class="research-card">
                <span class="lbl">Compatibility study</span>
                <h2>Can I safely use AVIF or WebP share images?</h2>
                <p>Which social platforms actually render next-gen image formats in link previews — tested across every major network, with the results.</p>
                <div class="status-chips">
                    <span>WebP ✓ widely</span>
                    <span>AVIF ✗ patchy</span>
                </div>
                <span class="more">read the findings →</span>
            </a>
        </section>

        <p class="research-closing">
            All reports are built on open data and published free. If you cite them, a link back is appreciated — and if you&rsquo;d like a custom cut of the
            data, <a href="/contact-me/">get in touch</a>.
        </p>
    </div>
</BaseLayout>

<style>
    .research-hero {
        padding: 60px 0 36px;
        max-width: 52ch;
    }

    .research-featured {
        text-decoration: none;
        display: grid;
        grid-template-columns: 1fr 1.15fr;
        background: var(--dark);
        border-radius: 3px;
        overflow: hidden;
        margin-bottom: 28px;
        transition: opacity 0.15s;
    }
    .research-featured:hover {
        opacity: 0.98;
    }
    .research-featured .body {
        padding: 40px 38px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }
    .research-featured .eyebrow {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.1em;
        color: var(--dark-fg-accent);
        text-transform: uppercase;
    }
    .research-featured h2 {
        font-family: var(--font-display);
        font-weight: 500;
        font-size: 36px;
        line-height: 1.06;
        color: var(--paper-white);
        margin: 14px 0 0;
    }
    .research-featured p {
        font-family: var(--font-text);
        font-size: 17px;
        line-height: 1.55;
        color: var(--dark-fg-soft);
        margin: 14px 0 0;
    }
    .research-featured .explore {
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--dark-fg-accent);
        margin-top: 22px;
    }
    .chart {
        background: var(--dark-panel);
        padding: 38px 36px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 13px;
    }
    .chart-label {
        font-family: var(--font-mono);
        font-size: 10.5px;
        letter-spacing: 0.08em;
        color: var(--dark-fg-accent);
        text-transform: uppercase;
        margin-bottom: 4px;
    }
    .bar-row {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .bar-name {
        font-family: var(--font-mono);
        font-size: 12px;
        color: #cdd2d9;
        width: 88px;
        flex: none;
    }
    .bar-track {
        flex: 1;
        height: 14px;
        background: rgba(255, 255, 255, 0.08);
        border-radius: 1px;
        overflow: hidden;
    }
    .bar-fill {
        display: block;
        height: 100%;
    }
    .bar-pct {
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--paper-white);
        width: 42px;
        text-align: right;
        flex: none;
    }

    .research-cards {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
        padding-bottom: 8px;
    }
    .research-card {
        text-decoration: none;
        background: var(--card);
        border: 1px solid rgba(31, 37, 48, 0.12);
        padding: 30px 30px 26px;
        display: block;
        transition: border-color 0.15s;
    }
    .research-card:hover {
        border-color: var(--accent);
    }
    .research-card .lbl {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.08em;
        color: var(--accent);
        text-transform: uppercase;
    }
    .research-card h2 {
        font-family: var(--font-display);
        font-weight: 500;
        font-size: 25px;
        color: var(--ink);
        margin: 12px 0 0;
    }
    .research-card p {
        font-family: var(--font-text);
        font-size: 16px;
        line-height: 1.5;
        color: var(--muted);
        margin: 10px 0 0;
    }
    .spark {
        display: flex;
        align-items: flex-end;
        gap: 5px;
        height: 46px;
        margin-top: 20px;
    }
    .spark span {
        flex: 1;
        background: var(--accent);
    }
    .spark span:nth-child(1) {
        background: #cdd3c8;
    }
    .spark span:nth-child(2) {
        background: #bcc6b6;
    }
    .spark span:nth-child(3) {
        background: #a7b4a0;
    }
    .spark span:nth-child(4) {
        background: #93a38c;
    }
    .spark span:nth-child(5) {
        background: #7f9279;
    }
    .spark span:nth-child(6) {
        background: #6e8470;
    }
    .status-chips {
        display: flex;
        gap: 8px;
        margin-top: 20px;
        flex-wrap: wrap;
    }
    .status-chips span {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--secondary);
        background: rgba(95, 117, 96, 0.16);
        padding: 5px 9px;
    }
    .research-card .more {
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--accent);
        display: inline-block;
        margin-top: 18px;
    }
    .research-closing {
        font-family: var(--font-text);
        font-size: 16px;
        color: var(--muted);
        margin: 26px 0 0;
        max-width: 64ch;
        line-height: 1.55;
    }
    .research-closing a {
        color: var(--ink);
        text-decoration: none;
        border-bottom: 1px solid var(--accent-soft-strong);
    }

    @media (max-width: 820px) {
        .research-featured {
            grid-template-columns: 1fr;
        }
        .research-cards {
            grid-template-columns: 1fr;
        }
    }
</style>
