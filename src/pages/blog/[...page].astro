---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchemaGraph from '../../components/SchemaGraph.astro';
import type { SchemaPageContext } from '../../utils/schema';
import { canonicalUrl } from '../../utils/schema/constants';
import { getPublishedPosts, getReadingTime } from '../../utils/post-utils';

export async function getStaticPaths() {
    return [{ params: { page: undefined } }];
}

const allPosts = getPublishedPosts(await getCollection('blog'));
const totalPosts = allPosts.length;

// Categories ordered by frequency (most-used first) for the filter chips.
const catCounts = new Map<string, number>();
for (const post of allPosts) {
    for (const cat of post.data.categories ?? []) {
        catCounts.set(cat, (catCounts.get(cat) ?? 0) + 1);
    }
}
const categories = [...catCounts.entries()].sort((a, b) => b[1] - a[1]).map(([cat]) => cat);

function fmtDate(date: Date): string {
    return date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
}

const rows = allPosts.map((post) => ({
    id: post.id,
    title: post.data.title.replace(/\*([^*]+)\*/g, '<em>$1</em>'),
    date: fmtDate(new Date(post.data.publishDate)),
    cats: post.data.categories ?? [],
    primaryCat: post.data.categories?.[0] ?? '',
    mins: getReadingTime(post.body ?? '')
}));

const pageContext: SchemaPageContext = {
    pageType: 'blogListing',
    canonicalUrl: canonicalUrl('/blog/'),
    title: 'Blog',
    description: 'Articles, essays, and opinions by Joost de Valk on WordPress, SEO, open source, AI, and the future of the open web.'
};
---

<BaseLayout title="Blog" description="Notes by Joost de Valk on WordPress, the open web, and what AI is doing to publishing and software.">
    <SchemaGraph pageContext={pageContext} />

    <div class="sp-root sp-blog">
        <section class="sp-hero blog-hero">
            <h1 class="sp-display">Writing</h1>
            <p class="sp-section-lede">Notes on WordPress, the open web, and what AI is doing to publishing. Strong opinions, loosely held — mostly.</p>
        </section>

        <div class="sp-filter-row" id="blog-filters">
            <button class="sp-filter is-active" data-filter="All" type="button">All</button>
            {
                categories.map((cat) => (
                    <button class="sp-filter" data-filter={cat} type="button">
                        {cat}
                    </button>
                ))
            }
        </div>

        <div class="sp-filter-meta">
            <span class="active-name" id="blog-active">All</span>
            <span id="blog-count">showing {totalPosts} of {totalPosts}</span>
        </div>

        <section class="blog-list">
            {
                rows.map((row) => (
                    <a href={`/${row.id}/`} class="sp-archive-row blog-row" data-cats={row.cats.join('|')}>
                        <span class="sp-row-left">
                            <span class="sp-row-date">{row.date}</span>
                            <span class="sp-row-title" set:html={row.title} />
                        </span>
                        <span class="sp-row-right">
                            <span class="sp-row-cat">{row.primaryCat}</span>
                            <span class="sp-row-read blog-row-read">{row.mins} min</span>
                        </span>
                    </a>
                ))
            }
        </section>
    </div>
</BaseLayout>

<style>
    .blog-hero {
        padding: 60px 0 30px;
    }
    .blog-list {
        padding: 0 0 30px;
    }
    .blog-row-read {
        width: 46px;
    }
</style>

<script>
    const filters = document.querySelectorAll<HTMLButtonElement>('#blog-filters .sp-filter');
    const rows = document.querySelectorAll<HTMLElement>('.blog-row');
    const activeLabel = document.getElementById('blog-active');
    const countLabel = document.getElementById('blog-count');
    const total = rows.length;

    function apply(filter: string) {
        let showing = 0;
        rows.forEach((row) => {
            const cats = (row.dataset.cats ?? '').split('|');
            const visible = filter === 'All' || cats.includes(filter);
            row.style.display = visible ? '' : 'none';
            if (visible) showing++;
        });
        if (activeLabel) activeLabel.textContent = filter;
        if (countLabel) countLabel.textContent = `showing ${showing} of ${total}`;
    }

    filters.forEach((btn) => {
        btn.addEventListener('click', () => {
            filters.forEach((b) => b.classList.toggle('is-active', b === btn));
            apply(btn.dataset.filter ?? 'All');
        });
    });
</script>
