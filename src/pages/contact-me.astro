---
import BaseLayout from '../layouts/BaseLayout.astro';
import SchemaGraph from '../components/SchemaGraph.astro';
import type { SchemaPageContext } from '../utils/schema';
import { canonicalUrl } from '../utils/schema/constants';

const title = 'Contact';
const description = 'Get in touch with Joost de Valk — via the contact form, Slack, social media, or postal mail.';

const pageContext: SchemaPageContext = {
    pageType: 'page',
    canonicalUrl: canonicalUrl('/contact-me/'),
    title,
    description
};
---

<BaseLayout title={title} description={description}>
    <SchemaGraph pageContext={pageContext} />

    <div class="sp-root sp-blocks sp-contact">
        <section class="sp-hero sp-contact-hero">
            <div class="sp-section-inner">
                <div class="sp-code-kicker">
                    <span>SECTION VI</span><span class="rule"></span><span>GET IN TOUCH</span>
                </div>
                <h1 class="sp-contact-title">
                    I'd <em>love</em> to hear from you.
                </h1>
                <p class="sp-contact-lede">
                    Use the form below, or one of the other ways to reach me. I read everything, even if it takes me a little while to reply.
                </p>
            </div>
        </section>

        <section class="sp-contact-callouts">
            <div class="sp-contact-callout-grid">
                <div class="sp-callout">
                    <div class="lbl">AI-powered answers</div>
                    <h4>Got a question? Ask Joost's AI.</h4>
                    <p>
                        Questions about SEO, Astro, EmDash, WordPress, open source, or building on the web? Get answers grounded in 18 years of writing —
                        powered by AI.
                        <a href="/ask-joost/">Ask Joost's AI &rarr;</a>
                    </p>
                </div>
                <div class="sp-callout">
                    <div class="lbl">Looking for investment?</div>
                    <h4>Use the Emilia Capital contact form.</h4>
                    <p>
                        Marieke and I invest through <a href="https://emilia.capital/">Emilia Capital</a>. Pitches and intros go through that contact form so
                        nothing gets lost in my inbox. <a href="https://emilia.capital/contact/">emilia.capital/contact &rarr;</a>
                    </p>
                </div>
            </div>
        </section>

        <section class="sp-contact-body">
            <div class="sp-contact-grid">
                <form id="contact-form" class="sp-contact-form" novalidate>
                    <input type="text" name="website" autocomplete="off" tabindex="-1" aria-hidden="true" style="position:absolute;left:-9999px;top:-9999px" />
                    <input type="hidden" name="_gotcha" value="" />
                    <input type="hidden" name="_timestamp" />

                    <div class="kicker">§ 01 · Contact form</div>
                    <h2>Send a message.</h2>

                    <div class="sp-field-row">
                        <label class="sp-field">
                            <span>Name <em>*</em></span>
                            <input type="text" id="name" name="name" required placeholder="Your full name" />
                        </label>
                        <label class="sp-field">
                            <span>Email <em>*</em></span>
                            <input type="email" id="email" name="email" required placeholder="you@example.com" />
                        </label>
                    </div>
                    <label class="sp-field">
                        <span>Subject</span>
                        <input type="text" id="subject" name="subject" placeholder="What's this about?" />
                    </label>
                    <label class="sp-field">
                        <span>Message <em>*</em></span>
                        <textarea id="message" name="message" required rows="8" placeholder="Write as much as you want…"></textarea>
                    </label>

                    <div
                        id="form-status"
                        role="status"
                        aria-live="polite"
                        style="display:none;margin-bottom:16px;padding:12px 16px;font-family:var(--font-mono);font-size:12px;letter-spacing:0.1em"
                    >
                    </div>

                    <div class="sp-form-foot">
                        <span class="note">¶ Required fields marked with *</span>
                        <button type="submit" class="sp-submit" id="submit-btn">
                            <span id="submit-text">Send message &rarr;</span>
                        </button>
                    </div>
                </form>

                <aside class="sp-contact-margin">
                    <div class="m-block">
                        <div class="m-lbl">Slack</div>
                        <div class="m-body">
                            <strong>@joostdevalk</strong> on the<br /><a href="https://make.wordpress.org/chat/">official WordPress Slack</a>
                        </div>
                        <div class="m-body" style="margin-top:10px">
                            <strong>@jdevalk</strong> on the<br /><a href="https://poststatus.com/">Post Status Slack</a>
                        </div>
                    </div>
                    <div class="m-block">
                        <div class="m-lbl">Postal address</div>
                        <div class="m-body sp-postal">
                            Emilia Capital<br />
                            Att. Joost de Valk<br />
                            Emilia van Nassaustraat 20<br />
                            6602 GW Wijchen<br />
                            The Netherlands
                        </div>
                    </div>
                    <div class="m-block">
                        <div class="m-lbl">Social media</div>
                        <ul class="sp-contact-social">
                            <li><a href="https://gravatar.com/joostdevalk">Gravatar</a></li>
                            <li><a href="https://github.com/jdevalk">GitHub</a></li>
                            <li><a href="https://www.linkedin.com/in/jdevalk/">LinkedIn</a></li>
                            <li><a href="https://bsky.app/profile/joost.blog">Bluesky</a></li>
                            <li><a href="https://www.threads.net/@joostdevalk">Threads</a></li>
                            <li><a href="https://profiles.wordpress.org/joostdevalk">WordPress.org</a></li>
                            <li><a href="https://www.instagram.com/joostdevalk">Instagram</a></li>
                            <li><a href="https://joost.net/@joost" rel="me">Mastodon</a></li>
                        </ul>
                    </div>
                </aside>
            </div>
        </section>
    </div>
</BaseLayout>

<script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const submitText = document.getElementById('submit-text')!;
    const statusDiv = document.getElementById('form-status') as HTMLElement;
    const timestampInput = form?.querySelector('input[name="_timestamp"]') as HTMLInputElement;

    if (form && timestampInput) {
        timestampInput.value = Date.now().toString();

        form.addEventListener('submit', async (e) => {
            e.preventDefault();

            const name = (form.querySelector('#name') as HTMLInputElement).value.trim();
            const email = (form.querySelector('#email') as HTMLInputElement).value.trim();
            const message = (form.querySelector('#message') as HTMLTextAreaElement).value.trim();

            if (!name || !email || !message) {
                showStatus('Please fill in all required fields.', 'error');
                return;
            }

            if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
                showStatus('Please enter a valid email address.', 'error');
                return;
            }

            submitBtn.disabled = true;
            submitText.textContent = 'Sending…';
            statusDiv.style.display = 'none';

            try {
                const formData = new FormData(form);
                const response = await fetch('/api/contact', { method: 'POST', body: formData });
                const result = await response.json();

                if (response.ok) {
                    showStatus("Message sent! I'll get back to you soon.", 'success');
                    form.reset();
                    timestampInput.value = Date.now().toString();
                } else {
                    showStatus(result.error || 'Something went wrong. Please try again.', 'error');
                }
            } catch {
                showStatus('Failed to send message. Please try again later.', 'error');
            } finally {
                submitBtn.disabled = false;
                submitText.textContent = 'Send message →';
            }
        });
    }

    function showStatus(message: string, type: 'success' | 'error') {
        statusDiv.textContent = message;
        statusDiv.style.display = 'block';
        statusDiv.style.color = type === 'success' ? '#1f2530' : '#4a6480';
        statusDiv.style.borderTop = type === 'success' ? '1px solid #1f2530' : '1px solid #4a6480';
    }
</script>
