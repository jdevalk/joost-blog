---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ContactForm from '../components/ContactForm.astro';
import SchemaGraph from '../components/SchemaGraph.astro';
import type { SchemaPageContext } from '../utils/schema';
import { canonicalUrl } from '../utils/schema/constants';

const title = 'Contact';
const description = 'Get in touch with Joost de Valk — via the contact form, Slack, social media, or postal mail.';

const pageContext: SchemaPageContext = {
    pageType: 'page',
    canonicalUrl: canonicalUrl('/contact-me/'),
    title,
    description
};
---

<BaseLayout title={title} description={description}>
    <SchemaGraph pageContext={pageContext} />
    <div class="relative bg-gradient-to-br from-[#4a1525] via-[#3a1a28] to-[#2e1220] text-white" slot="header">
        <Header variant="dark" />
        <div class="h-[52px] sm:h-[56px]"></div>
        <section class="px-4 py-10 sm:px-8 sm:py-14">
            <div class="max-w-5xl mx-auto">
                <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl">{title}</h1>
            </div>
        </section>
    </div>

    <main class="grow" data-pagefind-body>
        <section class="px-4 py-10 sm:px-8 sm:py-14 bg-surface dark:bg-[#1e1b19]/50 border-b border-slate-200 dark:border-[#2a2623]">
            <div class="max-w-5xl mx-auto grid md:grid-cols-[1fr_250px] gap-8 items-center">
                <div>
                    <span class="text-xs font-bold uppercase tracking-widest text-primary dark:text-accent">Get in touch</span>
                    <h2 class="mt-2 text-2xl font-extrabold text-slate-950 dark:text-slate-100">I'd love to hear from you</h2>
                    <p class="mt-3 text-base sm:text-lg leading-relaxed text-slate-700 dark:text-slate-300">I love hearing from people, seriously. Use the form below or one of the other ways to reach me. I usually reply within a few days. Note that if you're looking for investment, it's better to use the <a href="https://emilia.capital/contact/" class="text-primary hover:text-secondary dark:text-accent dark:hover:text-white transition duration-300 underline underline-offset-2 decoration-1">contact form at Emilia Capital</a>.</p>
                </div>
                <img src="/images/cropped-joost-de-valk-profile-picture-web.jpg" alt="Joost de Valk" class="hidden md:block rounded-lg w-full shadow-card-hover" />
            </div>
        </section>

        <article class="max-w-6xl mx-auto px-4 py-10 sm:px-8 sm:py-14">
            <div class="max-w-3xl mx-auto">
                <div class="prose prose-slate sm:prose-lg max-w-none">
                    <h2>Contact form</h2>
                    <ContactForm />

                    <h2>Slack</h2>
                    <p>I'm @joostdevalk on the <a href="https://make.wordpress.org/chat/">official WordPress Slack</a> and @jdevalk on the <a href="https://poststatus.com/">Post Status Slack</a>.</p>

                    <h2>Postal Address</h2>
                    <p>Emilia Capital<br />
                    Att Joost de Valk<br />
                    Emilia van Nassaustraat 20<br />
                    6602 GW Wijchen<br />
                    The Netherlands</p>

                    <h2>Across Social Media</h2>
                    <div class="not-prose flex flex-wrap gap-2">
                        <a href="https://gravatar.com/joostdevalk" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-full text-sm font-semibold bg-primary/10 text-primary hover:bg-primary hover:text-white dark:bg-accent/10 dark:text-accent dark:hover:bg-accent dark:hover:text-white transition-colors duration-200">
