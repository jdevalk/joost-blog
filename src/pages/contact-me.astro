---
import BaseLayout from '../layouts/BaseLayout.astro';
import SchemaGraph from '../components/SchemaGraph.astro';
import type { SchemaPageContext } from '../utils/schema';
import { canonicalUrl } from '../utils/schema/constants';

const title = 'Contact';
const description = 'Get in touch with Joost de Valk — via the contact form, Slack, social media, or postal mail.';

const pageContext: SchemaPageContext = {
    pageType: 'page',
    canonicalUrl: canonicalUrl('/contact-me/'),
    title,
    description
};
---

<BaseLayout title={title} description={description}>
    <SchemaGraph pageContext={pageContext} />

    <div class="sp-root sp-contact">
        <section class="contact-hero">
            <h1 class="sp-display">Say hello</h1>
            <p class="sp-section-lede">I love hearing from people, seriously. Use the form or any of the channels below — I usually reply within a few days.</p>
        </section>

        <section class="contact-grid">
            <div class="contact-form-col">
                <form id="contact-form" class="contact-form" novalidate>
                    <input type="text" name="website" autocomplete="off" tabindex="-1" aria-hidden="true" class="contact-honeypot" />
                    <input type="hidden" name="_gotcha" value="" />
                    <input type="hidden" name="_timestamp" />

                    <div class="contact-row">
                        <label>
                            <span>Name</span>
                            <input type="text" id="name" name="name" placeholder="Your name" />
                        </label>
                        <label>
                            <span>Email</span>
                            <input type="email" id="email" name="email" placeholder="you@example.com" />
                        </label>
                    </div>
                    <label>
                        <span>Subject</span>
                        <input type="text" id="subject" name="subject" placeholder="What’s this about?" />
                    </label>
                    <label>
                        <span>Message</span>
                        <textarea id="message" name="message" rows="6" placeholder="Tell me everything…"></textarea>
                    </label>
                    <div class="contact-foot">
                        <button type="submit" id="submit-btn">Send message →</button>
                        <span class="contact-hint" id="contact-hint">I read every message myself.</span>
                    </div>
                </form>

                <div class="contact-success" id="contact-success" hidden>
                    <div class="check">✓</div>
                    <h2 id="success-title">Thanks!</h2>
                    <p>Your message is on its way. I usually reply within a few days — keep an eye on your inbox.</p>
                    <button type="button" id="send-another">send another →</button>
                </div>
            </div>

            <aside class="contact-channels">
                <div>
                    <div class="ch-label">Slack</div>
                    <p>
                        <strong>@joostdevalk</strong> on the <a href="https://make.wordpress.org/chat/">WordPress Slack</a>,
                        <strong>@jdevalk</strong> on the <a href="https://poststatus.com/">Post Status Slack</a>.
                    </p>
                </div>
                <div>
                    <div class="ch-label">Postal address</div>
                    <p>Emilia Capital<br />Att. Joost de Valk<br />Emilia van Nassaustraat 20<br />6602 GW Wijchen<br />The Netherlands</p>
                </div>
                <div class="ch-note">
                    <div class="ch-label">Looking for investment?</div>
                    <p>
                        Better to use the <a href="https://emilia.capital/contact/">Emilia Capital contact form</a> — it asks the right questions and points you at
                        our investment philosophy.
                    </p>
                </div>
                <div>
                    <div class="ch-label">Across social</div>
                    <div class="sp-chip-row">
                        <a href="https://github.com/jdevalk" class="sp-chip">GitHub</a>
                        <a href="https://www.linkedin.com/in/jdevalk/" class="sp-chip">LinkedIn</a>
                        <a href="https://bsky.app/profile/joost.blog" class="sp-chip">Bluesky</a>
                        <a href="https://joost.net/@joost" class="sp-chip" rel="me">Mastodon</a>
                    </div>
                </div>
            </aside>
        </section>
    </div>
</BaseLayout>

<style>
    .contact-hero {
        padding: 60px 0 30px;
        max-width: 54ch;
    }
    .contact-grid {
        display: grid;
        grid-template-columns: 1.25fr 1fr;
        gap: 54px;
        align-items: start;
        padding: 14px 0 20px;
    }

    .contact-form {
        display: flex;
        flex-direction: column;
        gap: 18px;
    }
    .contact-honeypot {
        position: absolute;
        left: -9999px;
        top: -9999px;
    }
    .contact-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
    }
    .contact-form label {
        display: block;
    }
    .contact-form label span {
        font-family: var(--font-mono);
        font-size: 10.5px;
        letter-spacing: 0.1em;
        color: var(--faint);
        text-transform: uppercase;
        display: block;
        margin-bottom: 7px;
    }
    .contact-form input,
    .contact-form textarea {
        font-family: var(--font-text);
        font-size: 17px;
        color: var(--ink);
        background: var(--card);
        border: 1px solid rgba(31, 37, 48, 0.2);
        padding: 12px 14px;
        width: 100%;
        outline: none;
        border-radius: 2px;
    }
    .contact-form textarea {
        resize: vertical;
    }
    .contact-form input:focus,
    .contact-form textarea:focus {
        border-color: var(--accent);
        background: #f1efe8;
    }
    .contact-form input::placeholder,
    .contact-form textarea::placeholder {
        color: #a3a092;
    }
    .contact-form .invalid {
        border-color: var(--error);
    }
    .contact-foot {
        display: flex;
        align-items: center;
        gap: 18px;
        margin-top: 4px;
        flex-wrap: wrap;
    }
    .contact-foot button {
        font-family: var(--font-mono);
        font-size: 13px;
        letter-spacing: 0.04em;
        color: var(--paper-white);
        background: var(--accent);
        border: none;
        cursor: pointer;
        padding: 14px 26px;
        border-radius: 2px;
        transition: background 0.15s;
    }
    .contact-foot button:hover {
        background: var(--accent-hover);
    }
    .contact-hint {
        font-family: var(--font-mono);
        font-size: 11.5px;
        color: var(--faint);
    }
    .contact-hint.error {
        color: var(--error);
    }

    .contact-success {
        background: rgba(95, 117, 96, 0.14);
        border: 1px solid var(--accent);
        border-radius: 3px;
        padding: 38px 36px;
    }
    .contact-success .check {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        background: var(--accent);
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--font-mono);
        color: var(--paper-white);
        font-size: 22px;
    }
    .contact-success h2 {
        font-family: var(--font-display);
        font-weight: 500;
        font-size: 28px;
        color: var(--ink);
        margin: 18px 0 0;
    }
    .contact-success p {
        font-family: var(--font-text);
        font-size: 18px;
        line-height: 1.55;
        color: var(--secondary);
        margin: 10px 0 0;
    }
    .contact-success button {
        font-family: var(--font-mono);
        font-size: 12px;
        letter-spacing: 0.04em;
        color: var(--accent);
        background: none;
        border: none;
        cursor: pointer;
        padding: 0;
        margin-top: 20px;
        border-bottom: 1px solid rgba(95, 117, 96, 0.5);
    }

    /* Channels */
    .contact-channels {
        display: flex;
        flex-direction: column;
        gap: 26px;
    }
    .contact-channels .ch-label {
        font-family: var(--font-mono);
        font-size: 10.5px;
        letter-spacing: 0.1em;
        color: var(--accent);
        text-transform: uppercase;
    }
    .contact-channels p {
        font-family: var(--font-text);
        font-size: 16px;
        line-height: 1.55;
        color: var(--body);
        margin: 8px 0 0;
    }
    .contact-channels strong {
        font-weight: 700;
    }
    .contact-channels a {
        color: var(--ink);
        text-decoration: none;
        border-bottom: 1px solid rgba(95, 117, 96, 0.5);
    }
    .contact-channels .sp-chip {
        color: var(--accent);
        border-bottom: none;
    }
    .ch-note {
        background: rgba(95, 117, 96, 0.12);
        border: 1px solid rgba(95, 117, 96, 0.35);
        padding: 16px 18px;
        border-radius: 2px;
    }
    .ch-note p {
        font-size: 15.5px;
        color: var(--secondary);
    }

    @media (max-width: 820px) {
        .contact-grid {
            grid-template-columns: 1fr;
            gap: 40px;
        }
    }
    @media (max-width: 460px) {
        .contact-row {
            grid-template-columns: 1fr;
        }
    }
</style>

<script>
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const hint = document.getElementById('contact-hint');
    const successPanel = document.getElementById('contact-success');
    const successTitle = document.getElementById('success-title');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    const timestampInput = form?.querySelector('input[name="_timestamp"]') as HTMLInputElement | null;

    const fields = ['name', 'email', 'subject', 'message'] as const;

    function getEl(id: string) {
        return document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null;
    }

    if (form && timestampInput) {
        timestampInput.value = Date.now().toString();

        fields.forEach((f) => {
            getEl(f)?.addEventListener('input', () => getEl(f)?.classList.remove('invalid'));
        });

        function setHint(text: string, error: boolean) {
            if (!hint) return;
            hint.textContent = text;
            hint.classList.toggle('error', error);
        }

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const values: Record<string, string> = {};
            const errors: string[] = [];
            fields.forEach((f) => {
                const el = getEl(f);
                const v = (el?.value ?? '').trim();
                values[f] = v;
                let invalid = false;
                if (f === 'email') {
                    invalid = !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(v);
                } else {
                    invalid = v.length === 0;
                }
                el?.classList.toggle('invalid', invalid);
                if (invalid) errors.push(f);
            });

            if (errors.length) {
                setHint('Please fill in the highlighted fields.', true);
                return;
            }

            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.textContent = 'Sending…';
            }
            setHint('Sending…', false);

            try {
                const response = await fetch('/api/contact', { method: 'POST', body: new FormData(form) });
                const result = await response.json().catch(() => ({}));
                if (response.ok) {
                    if (successTitle) successTitle.textContent = `Thanks, ${values.name.split(' ')[0]}!`;
                    form.hidden = true;
                    if (successPanel) successPanel.hidden = false;
                } else {
                    setHint(result.error || 'Something went wrong. Please try again.', true);
                }
            } catch {
                setHint('Failed to send. Please try again later.', true);
            } finally {
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.textContent = 'Send message →';
                }
            }
        });

        document.getElementById('send-another')?.addEventListener('click', () => {
            form.reset();
            timestampInput.value = Date.now().toString();
            fields.forEach((f) => getEl(f)?.classList.remove('invalid'));
            setHint('I read every message myself.', false);
            if (successPanel) successPanel.hidden = true;
            form.hidden = false;
        });
    }
</script>
