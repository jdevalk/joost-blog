---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import tuscanyPic from '../assets/images/joost-tuscany.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import SchemaGraph from '../components/SchemaGraph.astro';
import siteConfig from '../data/site-config';
import { getPublishedPosts, getReadingTime } from '../utils/post-utils';
import { canonicalUrl } from '../utils/schema/constants';
import type { SchemaPageContext } from '../utils/schema';

const posts = getPublishedPosts(await getCollection('blog'));
const totalPosts = posts.length;
const latestPosts = posts.slice(0, 5);

function shortDate(date: Date): string {
    const month = date.toLocaleDateString('en-US', { month: 'short' }).toLowerCase();
    return `${month} ${String(date.getDate()).padStart(2, '0')}`;
}

const pageContext: SchemaPageContext = {
    pageType: 'homepage',
    canonicalUrl: canonicalUrl('/'),
    title: siteConfig.title,
    description: siteConfig.description
};
---

<BaseLayout title="Joost de Valk - Internet entrepreneur" description={siteConfig.description}>
    <SchemaGraph pageContext={pageContext} />

    <div class="sp-root">
        <section class="home-hero">
            <div class="home-hero-main">
                <h1 class="sp-display">Still betting on the <em>open</em> web.</h1>
                <p class="home-hero-lede">
                    I&rsquo;m an internet entrepreneur from the Netherlands. I lead AI &amp; growth at
                    <a href="https://your.online/" target="_blank" rel="noopener noreferrer">Your.Online</a>, invest in digital companies through
                    <a href="https://emilia.capital/" target="_blank" rel="noopener noreferrer">Emilia Capital</a>, and once founded
                    <a href="https://yoast.com/" target="_blank" rel="noopener noreferrer">Yoast</a>. This is where I think out loud about content management,
                    AI&rsquo;s effect on publishing, and the craft of shipping software people actually use.
                </p>
                <div class="home-hero-cta">
                    <a href="/blog/" class="sp-btn">Read the latest →</a>
                    <a href="/feed.xml" class="sp-link-dashed">or grab the RSS feed</a>
                </div>
            </div>
            <aside class="home-hero-aside">
                <div class="home-tab" aria-hidden="true"></div>
                <figure class="home-portrait">
                    <Image src={tuscanyPic} alt="Joost de Valk" width={480} loading="eager" />
                </figure>
                <figcaption class="home-portrait-cap">That&rsquo;s me in Tuscany</figcaption>
                <div class="home-note">
                    <div class="home-note-label">Currently</div>
                    <ul>
                        <li>Building Progress Planner</li>
                        <li>Coaching kids&rsquo; soccer at AWC</li>
                        <li>Writing about AI &amp; the open web</li>
                    </ul>
                </div>
            </aside>
        </section>

        <section class="home-blog">
            <div class="sp-section-head">
                <h2>From the blog</h2>
                <span class="sp-section-meta">{totalPosts} entries &amp; counting</span>
            </div>
            <div class="sp-archive-list">
                {
                    latestPosts.map((post) => (
                        <a href={`/${post.id}/`} class="sp-archive-row">
                            <span class="sp-row-left">
                                <span class="sp-row-title" set:html={post.data.title.replace(/\*([^*]+)\*/g, '<em>$1</em>')} />
                            </span>
                            <span class="sp-row-read" style="white-space:nowrap">
                                {shortDate(new Date(post.data.publishDate))} · {getReadingTime(post.body ?? '')} min
                            </span>
                        </a>
                    ))
                }
            </div>
            <a href="/blog/" class="sp-link-arrow home-blog-more">→ flip through all {totalPosts} entries</a>
        </section>
    </div>
</BaseLayout>

<style>
    .home-hero {
        display: grid;
        grid-template-columns: 1.62fr 1fr;
        gap: 48px;
        align-items: start;
        padding: 60px 0 56px;
    }
    .home-hero-lede {
        font-family: var(--font-text);
        font-weight: 300;
        font-size: 20px;
        line-height: 1.6;
        color: var(--secondary);
        max-width: 54ch;
        margin: 32px 0 0;
    }
    .home-hero-lede a {
        color: var(--ink);
        text-decoration: none;
        background: linear-gradient(transparent 62%, var(--accent-soft) 62%);
    }
    .home-hero-cta {
        display: flex;
        gap: 20px;
        margin-top: 34px;
        align-items: center;
        flex-wrap: wrap;
    }

    .home-hero-aside {
        position: relative;
        padding-top: 8px;
    }
    .home-tab {
        position: absolute;
        top: -2px;
        right: 58px;
        width: 120px;
        height: 22px;
        background: var(--accent-soft);
        transform: rotate(-3deg);
    }
    .home-portrait {
        margin: 0 0 0 auto;
        border: 6px solid var(--paper-white);
        box-shadow: 0 8px 26px rgba(31, 37, 48, 0.18);
        transform: rotate(2.2deg);
        width: 240px;
        line-height: 0;
    }
    .home-portrait :global(img) {
        display: block;
        width: 100%;
        height: auto;
        filter: saturate(0.92);
    }
    .home-portrait-cap {
        font-family: var(--font-mono);
        font-style: italic;
        font-size: 12px;
        color: var(--faint);
        text-align: right;
        margin-top: 14px;
        transform: rotate(2deg);
    }
    .home-note {
        margin: 30px 0 0;
        background: var(--accent-soft);
        border: 1px solid var(--accent);
        padding: 18px 20px;
        transform: rotate(-1.3deg);
        box-shadow: 0 5px 16px rgba(31, 37, 48, 0.1);
        border-radius: 2px;
    }
    .home-note-label {
        font-family: var(--font-mono);
        font-size: 10.5px;
        letter-spacing: 0.12em;
        color: var(--accent);
        text-transform: uppercase;
    }
    .home-note ul {
        margin: 11px 0 0;
        padding: 0 0 0 18px;
        list-style: disc;
        font-family: var(--font-text);
        font-size: 16px;
        line-height: 1.55;
        color: var(--body);
    }
    .home-note li {
        margin: 0 0 2px;
        list-style: inherit;
    }
    .home-note li::marker {
        color: var(--accent);
    }

    .home-blog {
        padding: 8px 0 40px;
    }
    .home-blog-more {
        margin-top: 22px;
    }

    @media (max-width: 820px) {
        .home-hero {
            grid-template-columns: 1fr;
            gap: 40px;
        }
        .home-hero-aside {
            max-width: 320px;
        }
        .home-portrait {
            margin-left: 0;
        }
    }
</style>
