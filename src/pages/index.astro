---
import { getCollection } from 'astro:content';
import FeaturedPostPreview from '../components/FeaturedPostPreview.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import PostPreview from '../components/PostPreview.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Subscribe from '../components/Subscribe.astro';
import siteConfig from '../data/site-config';
import BaseLayout from '../layouts/BaseLayout.astro';
import SchemaGraph from '../components/SchemaGraph.astro';
import type { SchemaPageContext } from '../utils/schema';
import { canonicalUrl } from '../utils/schema/constants';
import { sortPostsByDateDesc } from '../utils/post-utils';

const posts = (await getCollection('blog')).sort(sortPostsByDateDesc);

const pageContext: SchemaPageContext = {
    pageType: 'homepage',
    canonicalUrl: canonicalUrl('/'),
    title: siteConfig.title,
    description: siteConfig.description
};
const featuredPosts = posts.filter(({ data }) => data.isFeatured).slice(0, 2);
const latestPosts = posts.filter(({ data }) => !data.isFeatured).slice(0, 6);
---

<BaseLayout description={siteConfig.description}>
    <SchemaGraph pageContext={pageContext} />
    <div class="relative bg-gradient-to-br from-[#4a1525] via-[#3a1a28] to-[#2e1220] text-white" slot="header">
        <Header variant="dark" />
        <div class="h-[52px] sm:h-[56px]"></div>
        <Hero {...siteConfig.hero} socialLinks={siteConfig.socialLinks} variant="dark" />
    </div>
    <main class="grow" data-pagefind-ignore="all">
        {/* Currently working on */}
        <section class="px-4 py-10 sm:px-8 sm:py-14 bg-surface dark:bg-[#1e1b19]/50 border-b border-slate-200 dark:border-[#2a2623]">
            <div class="max-w-5xl mx-auto">
                <h2 class="mb-6 text-xs font-bold uppercase tracking-widest text-primary dark:text-accent">Currently working on</h2>
                <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    <ProjectCard
                        title="Progress Planner"
                        description="A WordPress plugin that helps site owners build consistent content habits and track their website progress."
                        href="https://progressplanner.com/"
                        label="Product"
                    />
                    <ProjectCard
                        title="Emilia Capital"
                        description="Investing in and building digital companies, with a focus on open source and the WordPress ecosystem."
                        href="https://emilia.capital/"
                        label="Investment"
                    />
                    <ProjectCard
                        title="Open Source"
                        description="Contributing to WordPress core, building tools, and sharing code on GitHub."
                        href="/code"
                        label="Code"
                    />
                </div>
            </div>
        </section>

        {/* Featured posts */}
        {featuredPosts?.length > 0 && (
            <section class="px-4 py-12 sm:px-8 sm:py-16">
                <div class="max-w-5xl mx-auto">
                    <h2 class="mb-8 text-xs font-bold uppercase tracking-widest text-primary dark:text-accent">Featured</h2>
                    {featuredPosts.map((post) => (
                        <FeaturedPostPreview post={post} />
                    ))}
                </div>
            </section>
        )}

        {/* Latest articles grid */}
        {latestPosts?.length > 0 && (
            <section class="px-4 pb-12 sm:px-8 sm:pb-16">
                <div class="max-w-5xl mx-auto">
                    <div class="flex items-center justify-between mb-8">
                        <h2 class="text-xs font-bold uppercase tracking-widest text-primary dark:text-accent">Latest Articles</h2>
                        <a
                            class="text-sm font-bold text-primary hover:text-secondary dark:text-accent dark:hover:text-white transition-colors duration-300"
                            href="/blog"
                        >
                            View all &rarr;
                        </a>
                    </div>
                    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                        {latestPosts.map((post) => (
                            <PostPreview post={post} />
                        ))}
                    </div>
                </div>
            </section>
        )}

        {/* Newsletter */}
        <section class="px-4 pb-16 sm:px-8 sm:pb-20">
            <Subscribe />
        </section>
    </main>
</BaseLayout>
