---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import profilePic from '../assets/images/joost-profile.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import SchemaGraph from '../components/SchemaGraph.astro';
import siteConfig from '../data/site-config';
import { getPublishedPosts, getReadingTime } from '../utils/post-utils';
import { canonicalUrl } from '../utils/schema/constants';
import type { SchemaPageContext } from '../utils/schema';

const posts = getPublishedPosts(await getCollection('blog'));
const totalPosts = posts.length;
const featuredPost = posts.find(p => p.data.isFeatured) ?? posts[0];
const archivePosts = posts.slice(0, 6);
const latestPost = posts[0];

// Article number = sequential position sorted oldest-first
const allPostsSorted = [...posts].sort(
    (a, b) => new Date(a.data.publishDate).getTime() - new Date(b.data.publishDate).getTime()
);
const featuredArticleNumber = allPostsSorted.findIndex(p => p.id === featuredPost.id) + 1;

// Editorial metadata
const currentYear = new Date().getFullYear();
const volumeNum = 15;
const ROMAN: Record<number, string> = {
    1:'I',2:'II',3:'III',4:'IV',5:'V',6:'VI',7:'VII',
    8:'VIII',9:'IX',10:'X',11:'XI',12:'XII',13:'XIII',14:'XIV',15:'XV'
};
const volumeRoman = ROMAN[volumeNum] ?? String(volumeNum);
const month = new Date().getMonth() + 1;
const season = month <= 2 || month === 12 ? 'Winter'
    : month <= 5 ? 'Spring'
    : month <= 8 ? 'Summer'
    : 'Autumn';

function dotDate(date: Date): string {
    return `${date.getFullYear()}·${String(date.getMonth()+1).padStart(2,'0')}·${String(date.getDate()).padStart(2,'0')}`;
}

function catLabel(post: typeof posts[0]): string {
    return post.data.categories?.[0] ?? 'Article';
}

const pageContext: SchemaPageContext = {
    pageType: 'homepage',
    canonicalUrl: canonicalUrl('/'),
    title: siteConfig.title,
    description: siteConfig.description
};

const featuredReadTime = getReadingTime(featuredPost.body ?? '');
const featuredDate = dotDate(new Date(featuredPost.data.publishDate));
---

<BaseLayout title="Joost de Valk - Internet entrepreneur" description={siteConfig.description}>
    <SchemaGraph pageContext={pageContext} />

    <div class="sp-root sp-blocks">

        <section class="sp-hero sp-hero-home">
            <div class="sp-hero-kicker">
                <span>VOL.&nbsp;{volumeRoman}</span>
                <span class="sp-rule" />
                <span>Builder. Investor. Web obsessive.</span>
                <span class="sp-rule" />
                <span>WIJCHEN, NL</span>
            </div>
            <h1 class="sp-display">Joost<span class="sp-amp"> de </span>Valk</h1>
            <div class="sp-hero-grid">
                <div class="sp-hero-lede">
                    <p class="sp-drop">
                        <span class="sp-dropcap">I</span>nternet entrepreneur from the
                        Netherlands. Founder of Yoast — the WordPress SEO plugin. These days I
                        invest in and build digital companies through <a href="https://emilia.capital/" target="_blank" rel="noopener noreferrer"><em>Emilia Capital</em></a>,
                        and I'm working on <a href="https://progressplanner.com/" target="_blank" rel="noopener noreferrer"><em>Progress Planner</em></a> and <a href="https://rondo.club/" target="_blank" rel="noopener noreferrer"><em>Rondo</em></a>.
                    </p>
                    <p class="sp-drop-body">
                        This blog is where I think out loud about the open web, content
                        management, AI's effect on publishing, and the craft of shipping
                        software that people actually use.
                    </p>
                    <div class="sp-cta">
                        <a class="sp-cta-primary" href={`/${latestPost.id}/`}>Read the latest article →</a>
                        <a class="sp-cta-ghost" href="/feed.xml">RSS / Atom feed</a>
                    </div>
                </div>
                <aside class="sp-margin">
                    <div class="sp-margin-block">
                        <div class="sp-margin-label">On my desk</div>
                        <ul>
                            <li><a href="https://progressplanner.com/" target="_blank" rel="noopener noreferrer"><strong>Progress Planner</strong></a> — improve your WordPress site, one step at a time.</li>
                            <li><a href="https://emilia.capital/" target="_blank" rel="noopener noreferrer"><strong>Emilia Capital</strong></a> — investing in open-source.</li>
                            <li><a href="https://rondo.club/" target="_blank" rel="noopener noreferrer"><strong>Rondo</strong></a> — building quietly.</li>
                        </ul>
                    </div>
                    <div class="sp-margin-block">
                        <div class="sp-margin-label">Elsewhere</div>
                        <ul class="sp-margin-links">
                            <li>→ <a href="https://bsky.app/profile/joost.blog">bsky · joost.blog</a></li>
                            <li>→ <a href="https://github.com/jdevalk">github.com/jdevalk</a></li>
                            <li>→ <a href="https://www.linkedin.com/in/jdevalk/">linkedin · jdevalk</a></li>
                            <li>→ <a href="https://x.com/jdevalk">x.com/jdevalk</a></li>
                        </ul>
                    </div>
                </aside>
                <figure class="sp-portrait">
                    <div class="sp-portrait-frame">
                        <Image
                            src={profilePic}
                            alt="Joost de Valk"
                            width={800}
                            loading="lazy"
                            decoding="async"
                        />
                    </div>
                    <figcaption>fig. 1 — the author, Aquilea, 2026</figcaption>
                </figure>
            </div>
        </section>

        <section class="sp-feature">
            <div class="sp-feature-inner">
            <div class="sp-feature-meta">
                <span class="sp-feature-num">№ {String(featuredArticleNumber).padStart(2, '0')}</span>
                <span class="sp-feature-cat">FEATURED ARTICLE</span>
                <span class="sp-feature-date">{featuredDate} · {featuredReadTime} min</span>
            </div>
            <h2 class="sp-feature-title" set:html={featuredPost.data.title} />
            <div class="sp-feature-cols">
                <p class="sp-feature-lede">{featuredPost.data.excerpt}</p>
                <div>
                    <p class="sp-feature-body">{featuredPost.data.categories?.join(' · ')}</p>
                    <div class="sp-feature-cta">
                        <a href={`/${featuredPost.id}/`}>Continue reading →</a>
                    </div>
                </div>
            </div>
            </div>
        </section>

        <section class="sp-archive">
            <div class="sp-section-head">
                <h3>Recent articles</h3>
                <div class="sp-section-meta">{totalPosts} articles · indexed by date</div>
            </div>
            <div class="sp-archive-list">
                {archivePosts.map((post, i) => (
                    <a href={`/${post.id}/`} class="sp-archive-row">
                        <span class="sp-col-n">{String(totalPosts - i).padStart(2, '0')}</span>
                        <span class="sp-col-date">{dotDate(new Date(post.data.publishDate))}</span>
                        <span class="sp-col-cat">{catLabel(post)}</span>
                        <span class="sp-col-title" set:html={post.data.title} />
                        <span class="sp-col-read">{getReadingTime(post.body ?? '')} min</span>
                    </a>
                ))}
            </div>
            <a class="sp-archive-more" href="/blog/">See all {totalPosts} articles in the Archive →</a>
        </section>


    </div>
</BaseLayout>

