---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchemaGraph from '../../components/SchemaGraph.astro';
import type { SchemaPageContext } from '../../utils/schema';
import { canonicalUrl } from '../../utils/schema/constants';
import { slugify, sortPostsByDateDesc, getPublishedPosts, getReadingTime } from '../../utils/post-utils';

export async function getStaticPaths() {
    const allPosts = getPublishedPosts(await getCollection('blog'));
    const categoryMap = new Map<string, { name: string; posts: CollectionEntry<'blog'>[] }>();

    for (const post of allPosts) {
        const categories = post.data.categories ?? [];
        for (const category of categories) {
            const slug = slugify(category);
            if (!categoryMap.has(slug)) {
                categoryMap.set(slug, { name: category, posts: [] });
            }
            categoryMap.get(slug)!.posts.push(post);
        }
    }

    return Array.from(categoryMap.entries()).map(([slug, { name, posts }]) => ({
        params: { slug },
        props: {
            categoryName: name,
            posts: posts.sort(sortPostsByDateDesc)
        }
    }));
}

const { categoryName, posts } = Astro.props;

const description = `Articles by Joost de Valk in the ${categoryName} category — SEO, WordPress, open source, AI, and the open web.`;

const pageContext: SchemaPageContext = {
    pageType: 'category',
    canonicalUrl: canonicalUrl(Astro.url.pathname),
    title: categoryName,
    description,
    categoryName
};

function fmtDate(date: Date): string {
    return date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
}
---

<BaseLayout title={categoryName} description={description}>
    <SchemaGraph pageContext={pageContext} />

    <div class="sp-root sp-blog" data-pagefind-ignore="all">
        <section class="sp-hero cat-hero">
            <a href="/blog/" class="cat-back">← all writing</a>
            <h1 class="sp-display">{categoryName}</h1>
            <p class="sp-section-lede">
                {posts.length}
                {posts.length === 1 ? 'entry' : 'entries'} filed under {categoryName}.
            </p>
        </section>

        <section class="cat-list">
            {
                posts.map((post) => (
                    <a href={`/${post.id}/`} class="sp-archive-row">
                        <span class="sp-row-left">
                            <span class="sp-row-date">{fmtDate(new Date(post.data.publishDate))}</span>
                            <span class="sp-row-title" set:html={post.data.title.replace(/\*([^*]+)\*/g, '<em>$1</em>')} />
                        </span>
                        <span class="sp-row-right">
                            <span class="sp-row-read">{getReadingTime(post.body ?? '')} min</span>
                        </span>
                    </a>
                ))
            }
        </section>
    </div>
</BaseLayout>

<style>
    .cat-hero {
        padding: 60px 0 24px;
    }
    .cat-back {
        font-family: var(--font-mono);
        font-size: 12px;
        letter-spacing: 0.04em;
        color: var(--accent-ink);
        text-decoration: none;
        display: inline-block;
        margin-bottom: 24px;
    }
    .cat-back:hover {
        opacity: 0.7;
    }
    .cat-list {
        border-top: 2px solid var(--rule);
        margin-top: 14px;
        padding: 0 0 30px;
    }
</style>
