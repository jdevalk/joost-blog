---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchemaGraph from '../../components/SchemaGraph.astro';
import type { SchemaPageContext } from '../../utils/schema';
import { canonicalUrl } from '../../utils/schema/constants';
import { slugify, sortPostsByDateDesc, getPublishedPosts, getReadingTime } from '../../utils/post-utils';

export async function getStaticPaths() {
    const allPosts = getPublishedPosts(await getCollection('blog'));
    const categoryMap = new Map<string, { name: string; posts: CollectionEntry<'blog'>[] }>();

    for (const post of allPosts) {
        const categories = post.data.categories ?? [];
        for (const category of categories) {
            const slug = slugify(category);
            if (!categoryMap.has(slug)) {
                categoryMap.set(slug, { name: category, posts: [] });
            }
            categoryMap.get(slug)!.posts.push(post);
        }
    }

    return Array.from(categoryMap.entries()).map(([slug, { name, posts }]) => ({
        params: { slug },
        props: {
            categoryName: name,
            posts: posts.sort(sortPostsByDateDesc)
        }
    }));
}

const { categoryName, posts } = Astro.props;

// Global article numbers: oldest post across all published posts = #1
const allPosts = getPublishedPosts(await getCollection('blog'));
const postsAsc = [...allPosts].sort((a, b) => new Date(a.data.publishDate).getTime() - new Date(b.data.publishDate).getTime());
const articleNumberMap = new Map(postsAsc.map((p, i) => [p.id, i + 1]));

// Year groups for this category, newest first
type YearGroup = { year: number; posts: CollectionEntry<'blog'>[] };
const yearGroupMap = new Map<number, CollectionEntry<'blog'>[]>();
for (const post of posts) {
    const year = new Date(post.data.publishDate).getFullYear();
    if (!yearGroupMap.has(year)) yearGroupMap.set(year, []);
    yearGroupMap.get(year)!.push(post);
}
const yearGroups: YearGroup[] = [...yearGroupMap.entries()].sort((a, b) => b[0] - a[0]).map(([year, posts]) => ({ year, posts }));

const allYears = yearGroups.map((g) => g.year);
const oldestYear = allYears[allYears.length - 1] ?? new Date().getFullYear();
const newestYear = allYears[0] ?? new Date().getFullYear();
const totalReadingMins = posts.reduce((sum, p) => sum + getReadingTime(p.body ?? ''), 0);

const description = `Articles by Joost de Valk in the ${categoryName} category — SEO, WordPress, open source, AI, and the open web.`;

const pageContext: SchemaPageContext = {
    pageType: 'category',
    canonicalUrl: canonicalUrl(Astro.url.pathname),
    title: categoryName,
    description,
    categoryName
};

function fmtDate(date: Date): string {
    const m = String(date.getMonth() + 1).padStart(2, '0');
    const d = String(date.getDate()).padStart(2, '0');
    return `${m}·${d}`;
}
---

<BaseLayout title={categoryName} description={description}>
    <SchemaGraph pageContext={pageContext} />

    <div class="sp-root sp-blocks sp-archive">
        <section class="sp-hero arc-hero" data-pagefind-ignore="all">
            <div class="arc-hero-inner">
                <p class="arc-breadcrumb"><a href="/blog/">The Archive</a> &rsaquo; {categoryName}</p>
                <h1 class="sp-display"><em>{categoryName}</em>.</h1>
                <div class="arc-stats">
                    <span>{posts.length} {posts.length === 1 ? 'Article' : 'Articles'}</span>
                    {
                        allYears.length > 1 && (
                            <>
                                <>
                                    <span>&middot;</span>
                                    <span>
                                        {oldestYear}&ndash;{newestYear}
                                    </span>
                                </>
                            </>
                        )
                    }
                    <span>&middot;</span>
                    <span>~{Math.round(totalReadingMins / 60)}h Reading</span>
                </div>
            </div>
        </section>

        <main class="arc-main" data-pagefind-ignore="all">
            <div class="arc-inner">
                {
                    yearGroups.map(({ year, posts }) => (
                        <section class="arc-year-section">
                            <div class="arc-year-header">
                                <span class="arc-year-num">{year}</span>
                                <hr class="arc-year-rule" />
                                <span class="arc-year-count">
                                    {posts.length}&nbsp;{posts.length === 1 ? 'Article' : 'Articles'}
                                </span>
                            </div>
                            <div class="sp-archive-list">
                                {posts.map((post) => {
                                    const num = articleNumberMap.get(post.id) ?? 0;
                                    const date = new Date(post.data.publishDate);
                                    const readMins = getReadingTime(post.body ?? '');
                                    return (
                                        <a href={`/${post.id}/`} class="sp-archive-row">
                                            <span class="sp-col-n">{num}</span>
                                            <span class="sp-col-date">{fmtDate(date)}</span>
                                            <span class="sp-col-cat">{categoryName}</span>
                                            <span class="sp-col-title" set:html={post.data.title} />
                                            <span class="sp-col-read">{readMins}&nbsp;min</span>
                                        </a>
                                    );
                                })}
                            </div>
                        </section>
                    ))
                }
            </div>
        </main>
    </div>
</BaseLayout>

<style>
    .arc-hero {
    }
    .arc-hero-inner {
        max-width: 1280px;
        margin: 0 auto;
        padding: 64px 64px 56px;
    }
    .arc-breadcrumb {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: color-mix(in srgb, var(--hero-fg) 70%, transparent);
        margin: 0 0 24px;
    }
    .arc-breadcrumb a {
        color: inherit;
        text-decoration: none;
    }
    .arc-breadcrumb a:hover {
        color: var(--hero-fg);
    }

    .arc-stats {
        display: flex;
        flex-wrap: wrap;
        gap: 12px 20px;
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: color-mix(in srgb, var(--hero-fg) 60%, transparent);
        margin-top: 32px;
    }

    .arc-main {
        overflow-x: hidden;
    }
    .arc-inner {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 64px 80px;
    }

    .arc-year-section {
        margin-bottom: 48px;
    }
    .arc-year-header {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 4px;
        padding-top: 8px;
    }
    .arc-year-num {
        font-family: var(--font-display);
        font-weight: var(--weight-display);
        font-size: clamp(48px, 6vw, 80px);
        line-height: 1;
        color: var(--ox);
        flex-shrink: 0;
    }
    .arc-year-rule {
        flex: 1;
        border: none;
        border-top: 1px solid var(--ink);
    }
    .arc-year-count {
        font-family: var(--font-mono);
        font-size: 9px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--ink-soft);
        flex-shrink: 0;
    }

    .arc-inner .sp-archive-list {
        max-width: none;
    }

    @media (max-width: 768px) {
        .arc-hero-inner {
            padding: 40px 24px 36px;
        }
        .arc-inner {
            padding: 0 24px 60px;
        }
    }
</style>
