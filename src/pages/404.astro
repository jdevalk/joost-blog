---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FuzzyRedirect from '@jdevalk/astro-seo-graph/FuzzyRedirect.astro';
import { getPublishedPosts, getReadingTime } from '../utils/post-utils';

const allPosts = getPublishedPosts(await getCollection('blog'));
const featuredPosts = allPosts.filter((p) => p.data.isFeatured).slice(0, 4);
const displayPosts = featuredPosts.length >= 4 ? featuredPosts : allPosts.slice(0, 4);

function fmtDate(date: Date): string {
    return date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
}
---

<BaseLayout title="Page Not Found — Joost.blog">
    <div class="sp-root sp-404">
        <section class="nf-hero">
            <div class="nf-eyebrow">
                <span>§ Missing page</span>
                <span class="rule"></span>
                <span>HTTP 404 · not in this edition</span>
            </div>
            <h1 class="sp-display">A <em>misprint.</em></h1>
            <p class="nf-lede">
                The page you asked for isn&rsquo;t in the archive. Either it was unpublished, the URL was mistyped, or an older link rotted in the
                seventeen-year drawer this blog keeps.
            </p>

            <div class="nf-url">
                <div class="nf-url-label">You followed</div>
                <div class="nf-url-value"><span class="origin">joost.blog</span><span id="nf-url-path"></span></div>
            </div>

            <div class="nf-fuzzy empty:hidden"><FuzzyRedirect suggestionText="Did you mean" /></div>

            <div class="nf-actions">
                <a href="/blog/" class="sp-btn sp-btn--mono">Back to the archive →</a>
                <a href="/ask-joost/" class="sp-link-dashed">or ask Joost&rsquo;s AI</a>
            </div>
        </section>

        <section class="nf-while">
            <div class="sp-section-head">
                <h2>While you&rsquo;re here</h2>
                <span class="sp-section-meta">A few worth reading</span>
            </div>
            <div class="sp-archive-list">
                {
                    displayPosts.map((post) => (
                        <a href={`/${post.id}/`} class="sp-archive-row">
                            <span class="sp-row-left">
                                <span class="sp-row-date">{fmtDate(new Date(post.data.publishDate))}</span>
                                <span class="sp-row-title" set:html={post.data.title.replace(/\*([^*]+)\*/g, '<em>$1</em>')} />
                            </span>
                            <span class="sp-row-right">
                                <span class="sp-row-cat">{post.data.categories?.[0] ?? ''}</span>
                                <span class="sp-row-read">{getReadingTime(post.body ?? '')} min</span>
                            </span>
                        </a>
                    ))
                }
            </div>
            <a class="sp-link-arrow nf-more" href="/blog/">→ browse all {allPosts.length} entries</a>
        </section>
    </div>
</BaseLayout>

<style>
    .nf-hero {
        padding: 64px 0 40px;
    }
    .nf-eyebrow {
        display: flex;
        align-items: center;
        gap: 12px;
        font-family: var(--font-mono);
        font-size: 10.5px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--faint);
        margin-bottom: 22px;
    }
    .nf-eyebrow .rule {
        flex: 0 0 28px;
        height: 1px;
        background: var(--hair-strong);
    }
    .nf-lede {
        font-family: var(--font-text);
        font-weight: 300;
        font-size: 20px;
        line-height: 1.6;
        color: var(--secondary);
        max-width: 52ch;
        margin: 28px 0 0;
    }
    .nf-url {
        margin: 28px 0 0;
    }
    .nf-url-label {
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--faint);
        margin-bottom: 6px;
    }
    .nf-url-value {
        font-family: var(--font-mono);
        font-size: 13px;
        color: var(--accent);
        word-break: break-all;
        max-width: 48ch;
    }
    .nf-url-value .origin {
        color: var(--faint);
    }
    .nf-fuzzy {
        margin: 18px 0 0;
        font-family: var(--font-text);
        font-size: 15px;
    }
    .nf-actions {
        display: flex;
        align-items: center;
        gap: 20px;
        flex-wrap: wrap;
        margin-top: 30px;
    }
    .nf-actions .sp-btn {
        color: var(--paper-white);
    }
    .nf-while {
        padding: 24px 0 48px;
    }
    .nf-more {
        margin-top: 22px;
    }
</style>

<script>
    const urlPathEl = document.getElementById('nf-url-path');
    if (urlPathEl) {
        urlPathEl.textContent = window.location.pathname + window.location.search;
    }
    if ((window as any).plausible) {
        (window as any).plausible('404', { props: { path: document.location.pathname } });
    }
</script>
