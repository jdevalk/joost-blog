---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
---

<BaseLayout title="Ask" description="Ask a question about Joost de Valk's blog posts and get an AI-powered answer.">
    <div class="relative bg-gradient-to-br from-[#4a1525] via-[#3a1a28] to-[#2e1220] text-white" slot="header">
        <Header variant="dark" />
        <div class="h-[52px] sm:h-[56px]"></div>
        <section class="px-4 py-10 sm:px-8 sm:py-14">
            <div class="max-w-3xl mx-auto">
                <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl">Ask</h1>
                <p class="mt-3 text-lg text-white/70">Ask a question about anything I've written about.</p>
            </div>
        </section>
    </div>

    <main class="grow px-4 py-10 sm:px-8 sm:py-14" data-pagefind-ignore="all">
        <div class="max-w-3xl mx-auto">
            <form id="ask-form" class="flex gap-3">
                <input
                    type="text"
                    id="ask-input"
                    name="q"
                    placeholder="e.g. Do you think I need a CMS?"
                    autocomplete="off"
                    class="flex-1 rounded-lg border border-slate-300 bg-white px-4 py-3 text-slate-900 placeholder-slate-400 shadow-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 dark:border-[#2a2623] dark:bg-[#1e1b19] dark:text-slate-100 dark:placeholder-slate-500 dark:focus:border-accent dark:focus:ring-accent/20"
                />
                <button
                    type="submit"
                    id="ask-btn"
                    class="rounded-lg bg-primary px-6 py-3 font-semibold text-white shadow-sm transition-colors hover:bg-secondary dark:bg-accent dark:text-slate-900 dark:hover:bg-white"
                >
                    Ask
                </button>
            </form>

            <div id="answer-area" class="mt-8 hidden">
                <div id="loading" class="hidden py-8 text-center text-slate-500 dark:text-slate-400">
                    <svg class="mx-auto mb-3 h-8 w-8 animate-spin text-primary dark:text-accent" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                    </svg>
                    Thinking...
                </div>

                <div id="answer-content" class="hidden">
                    <div id="answer-text" class="prose prose-slate dark:prose-invert max-w-none rounded-lg border border-slate-200 bg-white p-6 shadow-sm dark:border-[#2a2623] dark:bg-[#1e1b19]/50"></div>

                    <div id="sources-area" class="mt-4 hidden">
                        <h2 class="mb-2 text-xs font-bold uppercase tracking-widest text-primary dark:text-accent">Sources</h2>
                        <ul id="sources-list" class="space-y-1"></ul>
                    </div>
                </div>

                <div id="error-content" class="hidden rounded-lg border border-red-200 bg-red-50 p-6 text-red-800 dark:border-red-900 dark:bg-red-950/30 dark:text-red-300">
                    Something went wrong. Please try again.
                </div>
            </div>

            <div class="mt-12 text-sm text-slate-500 dark:text-slate-400">
                <p>Answers are generated by AI based on my blog posts. They may not always be perfectly accurate.</p>
            </div>
        </div>
    </main>
</BaseLayout>

<script>
    document.addEventListener('astro:page-load', () => {
        const form = document.getElementById('ask-form');
        const input = document.getElementById('ask-input');
        const btn = document.getElementById('ask-btn');
        const answerArea = document.getElementById('answer-area');
        const loading = document.getElementById('loading');
        const answerContent = document.getElementById('answer-content');
        const answerText = document.getElementById('answer-text');
        const sourcesArea = document.getElementById('sources-area');
        const sourcesList = document.getElementById('sources-list');
        const errorContent = document.getElementById('error-content');

        if (!form) return;

        // Check URL for pre-filled query
        const params = new URLSearchParams(window.location.search);
        const prefilledQuery = params.get('q');
        if (prefilledQuery) {
            input.value = prefilledQuery;
            submitQuery(prefilledQuery);
        }

        form.addEventListener('submit', (e) => {
            e.preventDefault();
            const query = input.value.trim();
            if (!query) return;

            // Update URL without reload
            const url = new URL(window.location);
            url.searchParams.set('q', query);
            url.pathname = url.pathname.replace(/\/+$/, '');
            history.replaceState(null, '', url);

            submitQuery(query);
        });

        async function submitQuery(query) {
            answerArea.classList.remove('hidden');
            loading.classList.remove('hidden');
            answerContent.classList.add('hidden');
            errorContent.classList.add('hidden');
            btn.disabled = true;
            btn.textContent = 'Asking...';

            try {
                const apiBase = window.location.hostname === 'localhost' ? 'https://joost.blog' : '';
                const res = await fetch(`${apiBase}/ask?${new URLSearchParams({ q: query, mode: 'generate' })}`);
                const data = await res.json();

                if (!res.ok || data.error) throw new Error(data.error || 'Request failed');

                answerText.innerHTML = formatAnswer(data.answer || data.summary || 'No answer available.');

                if (data.sources && data.sources.length > 0) {
                    sourcesList.innerHTML = data.sources
                        .map((s) => `<li><a href="${s.url}" class="text-sm text-primary hover:text-secondary dark:text-accent dark:hover:text-white transition-colors">${s.title}</a></li>`)
                        .join('');
                    sourcesArea.classList.remove('hidden');
                } else {
                    sourcesArea.classList.add('hidden');
                }

                loading.classList.add('hidden');
                answerContent.classList.remove('hidden');
            } catch (err) {
                loading.classList.add('hidden');
                errorContent.classList.remove('hidden');
            }

            btn.disabled = false;
            btn.textContent = 'Ask';
        }

        function formatAnswer(text) {
            // Basic markdown-ish formatting
            return text
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/\n\n/g, '</p><p>')
                .replace(/\n/g, '<br>')
                .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
                .replace(/\*(.+?)\*/g, '<em>$1</em>')
                .replace(/`(.+?)`/g, '<code>$1</code>')
                .replace(/^/, '<p>')
                .replace(/$/, '</p>');
        }
    });
</script>
