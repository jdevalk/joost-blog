---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
---

<BaseLayout title="Ask" description="Ask a question about Joost de Valk's blog posts and get an AI-powered answer.">
    <div class="relative bg-gradient-to-br from-[#4a1525] via-[#3a1a28] to-[#2e1220] text-white" slot="header">
        <Header variant="dark" />
        <div class="h-[52px] sm:h-[56px]"></div>
        <section class="px-4 py-10 sm:px-8 sm:py-14">
            <div class="max-w-3xl mx-auto">
                <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl">Ask</h1>
                <p class="mt-3 text-lg text-white/70">Ask a question about anything I've written about.</p>
            </div>
        </section>
    </div>

    <main class="grow px-4 py-10 sm:px-8 sm:py-14" data-pagefind-ignore="all">
        <div class="max-w-3xl mx-auto">
            <form id="ask-form" class="flex gap-3">
                <input
                    type="text"
                    id="ask-input"
                    name="q"
                    placeholder="e.g. Do you think I need a CMS?"
                    autocomplete="off"
                    class="flex-1 rounded-lg border border-slate-300 bg-white px-4 py-3 text-slate-900 placeholder-slate-400 shadow-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 dark:border-[#2a2623] dark:bg-[#1e1b19] dark:text-slate-100 dark:placeholder-slate-500 dark:focus:border-accent dark:focus:ring-accent/20"
                />
                <button
                    type="submit"
                    id="ask-btn"
                    class="rounded-lg bg-primary px-6 py-3 font-semibold text-white shadow-sm transition-colors hover:bg-secondary dark:bg-accent dark:text-slate-900 dark:hover:bg-white"
                >
                    Ask
                </button>
            </form>

            <div id="conversation" class="mt-8 space-y-4"></div>

            <div id="loading" class="mt-8 hidden py-8 text-center text-slate-500 dark:text-slate-400">
                <svg class="mx-auto mb-3 h-8 w-8 animate-spin text-primary dark:text-accent" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                </svg>
                Thinking...
            </div>

            <div id="error-content" class="mt-8 hidden rounded-lg border border-red-200 bg-red-50 p-6 text-red-800 dark:border-red-900 dark:bg-red-950/30 dark:text-red-300">
                Something went wrong. Please try again.
            </div>

            <div class="mt-12 text-sm text-slate-500 dark:text-slate-400">
                <p>Answers are generated by AI based on my blog posts. They may not always be perfectly accurate.</p>
            </div>
        </div>
    </main>
</BaseLayout>

<script>
    document.addEventListener('astro:page-load', () => {
        const form = document.getElementById('ask-form');
        const input = document.getElementById('ask-input');
        const btn = document.getElementById('ask-btn');
        const conversation = document.getElementById('conversation');
        const loading = document.getElementById('loading');
        const errorContent = document.getElementById('error-content');

        if (!form) return;

        // Conversation history for follow-up context
        const exchanges = [];

        // Check URL for pre-filled query
        const params = new URLSearchParams(window.location.search);
        const prefilledQuery = params.get('q');
        if (prefilledQuery) {
            input.value = prefilledQuery;
            submitQuery(prefilledQuery);
        }

        form.addEventListener('submit', (e) => {
            e.preventDefault();
            const query = input.value.trim();
            if (!query) return;

            // Update URL without reload
            const url = new URL(window.location);
            url.searchParams.set('q', query);
            url.pathname = url.pathname.replace(/\/+$/, '');
            window.history.replaceState(null, '', url);

            submitQuery(query);
        });

        function addQuestionBubble(query) {
            const div = document.createElement('div');
            div.className = 'flex justify-end';
            div.innerHTML = `<div class="rounded-lg bg-primary/10 px-5 py-3 text-sm font-medium text-slate-900 dark:bg-accent/10 dark:text-slate-100 max-w-[80%]">${escapeHtml(query)}</div>`;
            conversation.appendChild(div);
        }

        function addAnswerBubble(answerHtml, sources) {
            const div = document.createElement('div');
            let sourcesHtml = '';
            if (sources && sources.length > 0) {
                const items = sources.map((s) =>
                    `<li><a href="${s.url}" class="text-primary hover:text-secondary dark:text-accent dark:hover:text-white transition-colors">${escapeHtml(s.title)}</a></li>`
                ).join('');
                sourcesHtml = `<div class="mt-3 pt-3 border-t border-slate-200 dark:border-[#2a2623]"><p class="text-xs font-bold uppercase tracking-widest text-primary dark:text-accent mb-1">Sources</p><ul class="space-y-0.5 text-sm">${items}</ul></div>`;
            }
            div.innerHTML = `<div class="prose prose-slate dark:prose-invert max-w-none rounded-lg border border-slate-200 bg-white p-5 shadow-sm dark:border-[#2a2623] dark:bg-[#1e1b19]/50">${answerHtml}${sourcesHtml}</div>`;
            conversation.appendChild(div);
        }

        async function submitQuery(query) {
            addQuestionBubble(query);
            input.value = '';
            loading.classList.remove('hidden');
            errorContent.classList.add('hidden');
            btn.disabled = true;
            btn.textContent = 'Asking...';

            try {
                const apiBase = window.location.hostname === 'localhost' ? 'https://joost.blog' : '';
                const fetchParams = { q: query, mode: 'generate' };
                if (history.length > 0) {
                    fetchParams.prev = JSON.stringify(history.slice(-3));
                }
                const res = await fetch(`${apiBase}/ask?${new URLSearchParams(fetchParams)}`);
                const data = await res.json();

                if (!res.ok || data.error) throw new Error(data.error || 'Request failed');

                const answer = data.answer || data.summary || 'No answer available.';
                addAnswerBubble(formatAnswer(answer), data.sources);

                // Store in history for follow-up context
                history.push({ query, answer });

                loading.classList.add('hidden');
            } catch (err) {
                loading.classList.add('hidden');
                errorContent.classList.remove('hidden');
            }

            btn.disabled = false;
            btn.textContent = 'Ask';
            conversation.scrollIntoView({ behavior: 'smooth', block: 'end' });
        }

        function escapeHtml(text) {
            return text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        }

        function formatAnswer(text) {
            // Extract markdown links first, replace with placeholders
            const links = [];
            text = text.replace(/\[([^\]]+)\]\((https?:\/\/[^)]+)\)/g, (_, label, url) => {
                links.push({ label, url });
                return `%%LINK${links.length - 1}%%`;
            });

            // Escape HTML
            text = text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

            // Markdown formatting
            text = text
                .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
                .replace(/\*(.+?)\*/g, '<em>$1</em>')
                .replace(/`(.+?)`/g, '<code>$1</code>')
                .replace(/^- (.+)$/gm, '<li>$1</li>')
                .replace(/(<li>.*<\/li>\n?)+/g, '<ul>$&</ul>')
                .replace(/\n\n/g, '</p><p>')
                .replace(/\n/g, '<br>');

            // Restore links
            for (let i = 0; i < links.length; i++) {
                const { label, url } = links[i];
                text = text.replace(`%%LINK${i}%%`, `<a href="${url}" class="text-primary hover:text-secondary dark:text-accent dark:hover:text-white underline">${label}</a>`);
            }

            return `<p>${text}</p>`;
        }
    });
</script>
