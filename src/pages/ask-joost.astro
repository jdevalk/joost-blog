---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
---

<BaseLayout title="Ask" description="Ask a question about SEO, WordPress, open source, or the web and get an AI-powered answer grounded in Joost de Valk's posts and videos.">
    <div class="relative bg-gradient-to-br from-[#4a1525] via-[#3a1a28] to-[#2e1220] text-white" slot="header">
        <Header variant="dark" />
        <div class="h-[52px] sm:h-[56px]"></div>
        <section class="px-4 py-10 sm:px-8 sm:py-14">
            <div class="max-w-3xl mx-auto">
                <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl">Ask</h1>
                <p class="mt-3 text-lg text-white/70">Ask a question about anything I've written about.</p>
            </div>
        </section>
    </div>

    <main class="grow px-4 py-10 sm:px-8 sm:py-14" data-pagefind-ignore="all">
        <div class="max-w-3xl mx-auto">
            <div id="starters" class="grid gap-3 sm:grid-cols-2">
                <button type="button" class="starter-btn rounded-lg border border-slate-200 bg-white px-4 py-3 text-left text-sm text-slate-700 shadow-sm transition-colors hover:border-primary hover:bg-primary/5 dark:border-[#2a2623] dark:bg-[#1e1b19]/50 dark:text-slate-300 dark:hover:border-accent dark:hover:bg-accent/5" data-query="What's your take on WordPress' market share?">What's your take on WordPress' market share?</button>
                <button type="button" class="starter-btn rounded-lg border border-slate-200 bg-white px-4 py-3 text-left text-sm text-slate-700 shadow-sm transition-colors hover:border-primary hover:bg-primary/5 dark:border-[#2a2623] dark:bg-[#1e1b19]/50 dark:text-slate-300 dark:hover:border-accent dark:hover:bg-accent/5" data-query="What is Emilia Capital?">What is Emilia Capital?</button>
                <button type="button" class="starter-btn rounded-lg border border-slate-200 bg-white px-4 py-3 text-left text-sm text-slate-700 shadow-sm transition-colors hover:border-primary hover:bg-primary/5 dark:border-[#2a2623] dark:bg-[#1e1b19]/50 dark:text-slate-300 dark:hover:border-accent dark:hover:bg-accent/5" data-query="How do you think AI will affect SEO?">How do you think AI will affect SEO?</button>
            </div>

            <div id="conversation" class="space-y-6"></div>

            <div id="loading" class="hidden py-6 text-center text-slate-500 dark:text-slate-400">
                <svg class="mx-auto mb-3 h-8 w-8 animate-spin text-primary dark:text-accent" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                </svg>
                Thinking...
            </div>

            <div id="error-content" class="hidden rounded-lg border border-red-200 bg-red-50 p-6 text-red-800 dark:border-red-900 dark:bg-red-950/30 dark:text-red-300">
                <p id="error-message">Something went wrong. Please try again.</p>
            </div>

            <form id="ask-form" class="mt-6 flex gap-3 sticky bottom-4">
                <input
                    type="text"
                    id="ask-input"
                    name="q"
                    placeholder="e.g. Do you think I need a CMS?"
                    autocomplete="off"
                    class="flex-1 rounded-lg border border-slate-300 bg-white px-4 py-3 text-slate-900 placeholder-slate-400 shadow-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 dark:border-[#2a2623] dark:bg-[#1e1b19] dark:text-slate-100 dark:placeholder-slate-500 dark:focus:border-accent dark:focus:ring-accent/20"
                />
                <button
                    type="submit"
                    id="ask-btn"
                    class="rounded-lg bg-primary px-6 py-3 font-semibold text-white shadow-sm transition-colors hover:bg-secondary dark:bg-accent dark:text-slate-900 dark:hover:bg-white"
                >
                    Ask
                </button>
            </form>

            <div class="mt-4 flex items-center justify-between text-sm text-slate-500 dark:text-slate-400">
                <p>Answers are generated by AI based on my blog posts. They may not always be perfectly accurate.</p>
                <button type="button" id="new-conversation" class="hidden shrink-0 ml-4 text-primary hover:text-secondary dark:text-accent dark:hover:text-white transition-colors" title="Start a new conversation">New conversation</button>
            </div>
        </div>
    </main>
</BaseLayout>

<script>
    document.addEventListener('astro:page-load', () => {
        const form = document.getElementById('ask-form');
        const input = document.getElementById('ask-input');
        const btn = document.getElementById('ask-btn');
        const conversation = document.getElementById('conversation');
        const loading = document.getElementById('loading');
        const errorContent = document.getElementById('error-content');
        const errorMessage = document.getElementById('error-message');
        const starters = document.getElementById('starters');
        const newConversationBtn = document.getElementById('new-conversation');

        if (!form) return;

        // Conversation history for follow-up context
        const exchanges = [];
        // Stable session ID for prompt caching across exchanges
        const sessionId = crypto.randomUUID();

        // Starter question buttons
        starters.addEventListener('click', (e) => {
            const btn = e.target.closest('.starter-btn');
            if (!btn) return;
            const query = btn.dataset.query;
            if (query) submitQuery(query);
        });

        // New conversation button
        newConversationBtn.addEventListener('click', () => {
            exchanges.length = 0;
            conversation.innerHTML = '';
            errorContent.classList.add('hidden');
            starters.classList.remove('hidden');
            newConversationBtn.classList.add('hidden');
            input.focus();
            const url = new URL(window.location);
            url.searchParams.delete('q');
            window.history.replaceState(null, '', url);
        });

        // Check URL for pre-filled query
        const params = new URLSearchParams(window.location.search);
        const prefilledQuery = params.get('q');
        if (prefilledQuery) {
            input.value = prefilledQuery;
            submitQuery(prefilledQuery);
        }

        form.addEventListener('submit', (e) => {
            e.preventDefault();
            const query = input.value.trim();
            if (!query) return;

            // Update URL without reload
            const url = new URL(window.location);
            url.searchParams.set('q', query);
            url.pathname = url.pathname.replace(/\/+$/, '');
            window.history.replaceState(null, '', url);

            submitQuery(query);
        });

        // Feedback handler (event delegation)
        conversation.addEventListener('click', (e) => {
            const fbBtn = e.target.closest('.feedback-btn');
            if (!fbBtn) return;
            const value = fbBtn.dataset.value;
            const index = parseInt(fbBtn.dataset.index, 10);
            const exchange = exchanges[index];

            // Visual confirmation — replace buttons with "Thanks!"
            const container = fbBtn.parentElement;
            container.innerHTML = `<span class="text-xs text-slate-400 dark:text-slate-500">${value === 'yes' ? 'Glad it helped!' : 'Thanks for the feedback.'}</span>`;

            // Log feedback (lightweight — just console for now, can be wired to analytics later)
            console.log('Ask feedback:', { query: exchange?.query, value, index });
        });

        function renderSourceItem(s) {
            const typeBadge = s.type ? `<span class="inline-block rounded bg-slate-100 px-1.5 py-0.5 text-xs text-slate-500 dark:bg-[#2a2623] dark:text-slate-400">${escapeHtml(s.type)}</span> ` : '';
            const date = s.datePublished ? `<span class="text-slate-400 dark:text-slate-500">${s.datePublished}</span>` : '';
            const meta = (typeBadge || date) ? ` <span class="ml-1 text-xs">${typeBadge}${date}</span>` : '';
            return `<li><a href="${s.url}" class="text-primary hover:text-secondary dark:text-accent dark:hover:text-white transition-colors">${escapeHtml(s.title)}</a>${meta}</li>`;
        }

        function renderSourcesBlock(sources) {
            if (!sources || sources.length === 0) return '';
            const items = sources.map(renderSourceItem).join('');
            return `<div class="mt-3 pt-3 border-t border-slate-200 dark:border-[#2a2623]"><p class="text-xs font-bold uppercase tracking-widest text-primary dark:text-accent mb-1">Sources</p><ul class="space-y-1 text-sm">${items}</ul></div>`;
        }

        function renderFeedback(index) {
            return `<div class="mt-3 pt-3 border-t border-slate-200 dark:border-[#2a2623] flex items-center gap-2">
                <span class="text-xs text-slate-400 dark:text-slate-500">Was this helpful?</span>
                <button type="button" class="feedback-btn text-slate-400 hover:text-green-600 dark:hover:text-green-400 transition-colors" data-index="${index}" data-value="yes" title="Yes">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 9V5a3 3 0 00-3-3l-4 9v11h11.28a2 2 0 002-1.7l1.38-9a2 2 0 00-2-2.3H14z M4 21H2V10h2"/></svg>
                </button>
                <button type="button" class="feedback-btn text-slate-400 hover:text-red-600 dark:hover:text-red-400 transition-colors" data-index="${index}" data-value="no" title="No">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 15v4a3 3 0 003 3l4-9V2H5.72a2 2 0 00-2 1.7l-1.38 9a2 2 0 002 2.3H10z M20 2h2v11h-2"/></svg>
                </button>
            </div>`;
        }

        function addExchange(query, answerHtml, sources) {
            const index = exchanges.length;
            const div = document.createElement('div');
            div.innerHTML = `<div class="rounded-lg border border-slate-200 bg-white shadow-sm dark:border-[#2a2623] dark:bg-[#1e1b19]/50">
                <div class="px-5 py-3 border-b border-slate-100 dark:border-[#2a2623]">
                    <p class="text-sm font-semibold text-slate-900 dark:text-slate-100">${escapeHtml(query)}</p>
                </div>
                <div class="prose prose-slate dark:prose-invert max-w-none p-5">${answerHtml}${renderSourcesBlock(sources)}${renderFeedback(index)}</div>
            </div>`;
            conversation.appendChild(div);
        }

        function addStreamingExchange(query) {
            const div = document.createElement('div');
            div.innerHTML = `<div class="rounded-lg border border-slate-200 bg-white shadow-sm dark:border-[#2a2623] dark:bg-[#1e1b19]/50">
                <div class="px-5 py-3 border-b border-slate-100 dark:border-[#2a2623]">
                    <p class="text-sm font-semibold text-slate-900 dark:text-slate-100">${escapeHtml(query)}</p>
                </div>
                <div class="prose prose-slate dark:prose-invert max-w-none p-5" data-stream-target></div>
            </div>`;
            conversation.appendChild(div);
            return div.querySelector('[data-stream-target]');
        }

        function appendSources(container, sources) {
            if (!sources || sources.length === 0) return;
            const items = sources.map(renderSourceItem).join('');
            const sourcesDiv = document.createElement('div');
            sourcesDiv.className = 'mt-3 pt-3 border-t border-slate-200 dark:border-[#2a2623]';
            sourcesDiv.innerHTML = `<p class="text-xs font-bold uppercase tracking-widest text-primary dark:text-accent mb-1">Sources</p><ul class="space-y-1 text-sm">${items}</ul>`;
            container.appendChild(sourcesDiv);
        }

        function appendFeedback(container, index) {
            const feedbackDiv = document.createElement('div');
            feedbackDiv.innerHTML = renderFeedback(index);
            container.appendChild(feedbackDiv.firstElementChild);
        }

        async function submitQuery(query) {
            input.value = '';
            starters.classList.add('hidden');
            newConversationBtn.classList.remove('hidden');
            loading.classList.remove('hidden');
            errorContent.classList.add('hidden');
            btn.disabled = true;
            btn.textContent = 'Asking...';

            if (window.plausible) window.plausible('Ask Question', { props: { query } });

            const apiBase = window.location.hostname === 'localhost' ? 'https://joost.blog' : '';
            const fetchParams = { q: query, mode: 'stream', query_id: sessionId };
            if (exchanges.length > 0) {
                fetchParams.prev = JSON.stringify(exchanges.slice(-3));
            }

            try {
                const res = await fetch(`${apiBase}/ask?${new URLSearchParams(fetchParams)}`);

                if (!res.ok && !res.headers.get('content-type')?.includes('text/event-stream')) {
                    let msg = 'Request failed';
                    try {
                        const data = await res.json();
                        msg = data.error || msg;
                    } catch { /* not JSON */ }
                    throw new Error(msg);
                }

                // Non-streaming fallback (JSON response)
                if (res.headers.get('content-type')?.includes('application/json')) {
                    const data = await res.json();
                    if (data.error) throw new Error(data.error);
                    const answer = data.answer || data.summary || 'No answer available.';
                    loading.classList.add('hidden');
                    addExchange(query, formatAnswer(answer), data.sources);
                    exchanges.push({ query, answer });
                } else {
                    // Streaming SSE response
                    loading.classList.add('hidden');
                    const target = addStreamingExchange(query);
                    let fullAnswer = '';
                    let sources = [];

                    const reader = res.body.getReader();
                    const decoder = new TextDecoder();
                    let buffer = '';

                    while (true) {
                        const { done, value } = await reader.read();
                        if (done) break;

                        buffer += decoder.decode(value, { stream: true });
                        const lines = buffer.split('\n');
                        buffer = lines.pop(); // Keep incomplete line in buffer

                        for (const line of lines) {
                            if (!line.startsWith('data: ')) continue;
                            try {
                                const data = JSON.parse(line.slice(6));
                                if (data.token) {
                                    fullAnswer += data.token;
                                    target.innerHTML = formatAnswer(fullAnswer);
                                }
                                if (data.error) {
                                    // Server-side error during streaming
                                    if (!fullAnswer) {
                                        target.innerHTML = `<p class="text-red-600 dark:text-red-400">${escapeHtml(data.error)}</p>`;
                                    }
                                }
                                if (data.fallback) {
                                    // LLM returned garbage, server sent deterministic fallback
                                    fullAnswer = data.fallback;
                                    target.innerHTML = formatAnswer(fullAnswer);
                                }
                                if (data.sources) {
                                    sources = data.sources;
                                }
                            } catch {
                                // Non-JSON line, skip
                            }
                        }
                    }

                    appendSources(target, sources);
                    appendFeedback(target, exchanges.length);
                    exchanges.push({ query, answer: fullAnswer });
                }
            } catch (err) {
                loading.classList.add('hidden');
                const msg = err.message === 'Failed to fetch'
                    ? 'Could not reach the server. Check your connection and try again.'
                    : err.message || 'Something went wrong. Please try again.';
                errorMessage.textContent = msg;
                errorContent.classList.remove('hidden');
            }

            btn.disabled = false;
            btn.textContent = 'Ask';
            input.focus();
            const lastExchange = conversation.lastElementChild;
            if (lastExchange) lastExchange.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        function escapeHtml(text) {
            return text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        }

        function formatAnswer(text) {
            // Extract markdown links first, replace with placeholders
            const links = [];
            text = text.replace(/\[([^\]]+)\]\((https?:\/\/[^)]+)\)/g, (_, label, url) => {
                links.push({ label, url });
                return `%%LINK${links.length - 1}%%`;
            });

            // Escape HTML
            text = text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

            // Markdown formatting
            text = text
                .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
                .replace(/\*(.+?)\*/g, '<em>$1</em>')
                .replace(/`(.+?)`/g, '<code>$1</code>')
                .replace(/^- (.+)$/gm, '<li>$1</li>')
                .replace(/(<li>.*<\/li>\n?)+/g, '<ul>$&</ul>')
                .replace(/\n\n/g, '</p><p>')
                .replace(/\n/g, '<br>');

            // Restore links
            for (let i = 0; i < links.length; i++) {
                const { label, url } = links[i];
                text = text.replace(`%%LINK${i}%%`, `<a href="${url}" class="text-primary hover:text-secondary dark:text-accent dark:hover:text-white underline">${label}</a>`);
            }

            return `<p>${text}</p>`;
        }
    });
</script>
