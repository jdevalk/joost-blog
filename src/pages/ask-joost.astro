---
import BaseLayout from '../layouts/BaseLayout.astro';
import SchemaGraph from '../components/SchemaGraph.astro';
import type { SchemaPageContext } from '../utils/schema';
import { canonicalUrl } from '../utils/schema/constants';

const pageContext: SchemaPageContext = {
    pageType: 'page',
    canonicalUrl: canonicalUrl('/ask-joost/'),
    title: "Ask Joost's AI",
    description: "Ask a question about SEO, WordPress, open source, or the web and get an AI-powered answer grounded in Joost de Valk's posts and videos."
};
---

<BaseLayout
    title="Ask Joost's AI"
    description="Ask a question about SEO, WordPress, open source, or the web and get an AI-powered answer grounded in Joost de Valk's posts and videos."
>
    <SchemaGraph pageContext={pageContext} />

    <div class="sp-root sp-blocks sp-ask">
        <section class="sp-hero sp-ask-hero">
            <div class="sp-section-inner">
                <div class="sp-about-kicker">
                    <span>§ Ask</span><span class="rule"></span><span>Answers from 18 years of writing</span>
                </div>
                <h1 class="sp-ask-title">
                    Ask a question about anything I've <em>written about</em>.
                </h1>
                <p class="sp-ask-lede">
                    Answers are generated by AI based on my blog posts. They may not always be perfectly accurate &mdash; but they're grounded in what I've
                    actually published.
                </p>
                <div id="starters" class="sp-ask-examples">
                    <button type="button" class="sp-ask-chip starter-btn" data-query="What's your take on WordPress' market share?"
                        >What's your take on WordPress' market share?</button
                    >
                    <button type="button" class="sp-ask-chip starter-btn" data-query="What is Emilia Capital?">What is Emilia Capital?</button>
                    <button type="button" class="sp-ask-chip starter-btn" data-query="How do you think AI will affect SEO?"
                        >How do you think AI will affect SEO?</button
                    >
                    <button type="button" class="sp-ask-chip starter-btn" data-query="Why did you leave Yoast?">Why did you leave Yoast?</button>
                    <button type="button" class="sp-ask-chip starter-btn" data-query="Astro vs. WordPress for a new blog?"
                        >Astro vs. WordPress for a new blog?</button
                    >
                </div>
            </div>
        </section>

        <section class="sp-ask-body" data-pagefind-ignore="all">
            <div id="conversation" class="sp-ask-convo"></div>

            <div id="loading" class="sp-ask-joost sp-ask-thinking hidden">
                <div class="lbl"><span class="j">J</span> Joost &middot; thinking</div>
                <div class="sp-ask-dots"><span></span><span></span><span></span></div>
            </div>

            <div id="error-content" class="sp-ask-error hidden">
                <p id="error-message">Something went wrong. Please try again.</p>
            </div>

            <form id="ask-form" class="sp-ask-composer">
                <input type="text" id="ask-input" name="q" class="sp-ask-input" placeholder="What's your take on __________ ?" autocomplete="off" />
                <button type="submit" id="ask-btn" class="sp-ask-submit">Ask &rarr;</button>
                <button type="button" id="new-conversation" class="sp-ask-reset hidden">New conversation</button>
            </form>

            <div class="sp-ask-disclaimer">
                &para; Answers are generated by AI based on my blog posts. They may not always be perfectly accurate. For anything that matters, click through
                to the source post or <a href="/contact-me/">email me directly</a>.
            </div>
        </section>
    </div>
</BaseLayout>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const form = document.getElementById('ask-form');
        const input = document.getElementById('ask-input') as HTMLInputElement;
        const btn = document.getElementById('ask-btn') as HTMLButtonElement;
        const conversation = document.getElementById('conversation')!;
        const loading = document.getElementById('loading')!;
        const errorContent = document.getElementById('error-content')!;
        const errorMessage = document.getElementById('error-message')!;
        const starters = document.getElementById('starters')!;
        const newConversationBtn = document.getElementById('new-conversation')!;

        if (!form) return;

        const exchanges: { query: string; answer: string }[] = [];
        const sessionId = crypto.randomUUID();

        starters.addEventListener('click', (e) => {
            const target = e.target as HTMLElement;
            const btn = target.closest('.starter-btn') as HTMLElement | null;
            if (!btn) return;
            const query = btn.dataset.query;
            if (query) {
                input.value = query;
                submitQuery(query);
            }
        });

        newConversationBtn.addEventListener('click', () => {
            exchanges.length = 0;
            conversation.innerHTML = '';
            errorContent.classList.add('hidden');
            newConversationBtn.classList.add('hidden');
            input.focus();
            const url = new URL(window.location.href);
            url.searchParams.delete('q');
            window.history.replaceState(null, '', url);
        });

        const params = new URLSearchParams(window.location.search);
        const prefilledQuery = params.get('q');
        if (prefilledQuery) {
            input.value = prefilledQuery;
            submitQuery(prefilledQuery);
        }

        form.addEventListener('submit', (e) => {
            e.preventDefault();
            const query = input.value.trim();
            if (!query) return;

            const url = new URL(window.location.href);
            url.searchParams.set('q', query);
            url.pathname = url.pathname.replace(/\/+$/, '');
            window.history.replaceState(null, '', url);

            submitQuery(query);
        });

        conversation.addEventListener('click', (e) => {
            const target = e.target as HTMLElement;
            const fbBtn = target.closest('.feedback-btn') as HTMLElement | null;
            if (!fbBtn) return;
            const value = fbBtn.dataset.value;
            const index = parseInt(fbBtn.dataset.index ?? '0', 10);
            const exchange = exchanges[index];
            const container = fbBtn.parentElement!;
            container.innerHTML = `<span style="font-family:var(--font-mono);font-size:11px;color:#4e5666;letter-spacing:0.15em">${value === 'yes' ? 'GLAD IT HELPED' : 'THANKS FOR THE FEEDBACK'}</span>`;
            console.log('Ask feedback:', { query: exchange?.query, value, index });
        });

        function renderSourceItem(s: { url: string; title: string; type?: string; datePublished?: string }) {
            return `<a href="${s.url}" class="src">${escapeHtml(s.title)}</a>`;
        }

        function renderSourcesBlock(sources: { url: string; title: string; type?: string; datePublished?: string }[]) {
            if (!sources || sources.length === 0) return '';
            return `<div class="sp-ask-sources"><span class="lbl">Sources</span>${sources.map(renderSourceItem).join('')}</div>`;
        }

        function renderFeedback(index: number) {
            return `<div style="margin-top:14px;padding-top:10px;border-top:1px solid rgba(31,37,48,0.15);display:flex;align-items:center;gap:10px">
                <span style="font-family:var(--font-mono);font-size:11px;letter-spacing:0.15em;text-transform:uppercase;color:#4e5666">Was this helpful?</span>
                <button type="button" class="feedback-btn" data-index="${index}" data-value="yes" style="background:none;border:none;cursor:pointer;color:#4e5666;font-family:var(--font-mono);font-size:11px;letter-spacing:0.1em" title="Yes">&#10003;</button>
                <button type="button" class="feedback-btn" data-index="${index}" data-value="no" style="background:none;border:none;cursor:pointer;color:#4e5666;font-family:var(--font-mono);font-size:11px;letter-spacing:0.1em" title="No">&#10007;</button>
            </div>`;
        }

        function addExchange(query: string, answerHtml: string, sources: { url: string; title: string; type?: string; datePublished?: string }[]) {
            const index = exchanges.length;
            const div = document.createElement('div');
            div.innerHTML = `
                <div class="sp-ask-user">
                    <div class="lbl">You &middot; asked</div>
                    <p>${escapeHtml(query)}</p>
                </div>
                <div class="sp-ask-joost">
                    <div class="lbl"><span class="j">J</span> Joost &middot; replied</div>
                    <div class="sp-ask-answer">${answerHtml}${renderSourcesBlock(sources)}${renderFeedback(index)}</div>
                </div>`;
            conversation.appendChild(div);
        }

        function addStreamingExchange(query: string) {
            const div = document.createElement('div');
            div.innerHTML = `
                <div class="sp-ask-user">
                    <div class="lbl">You &middot; asked</div>
                    <p>${escapeHtml(query)}</p>
                </div>
                <div class="sp-ask-joost">
                    <div class="lbl"><span class="j">J</span> Joost &middot; replied</div>
                    <div class="sp-ask-answer" data-stream-target></div>
                </div>`;
            conversation.appendChild(div);
            return div.querySelector('[data-stream-target]') as HTMLElement;
        }

        function appendSources(container: HTMLElement, sources: { url: string; title: string }[]) {
            if (!sources || sources.length === 0) return;
            const div = document.createElement('div');
            div.className = 'sp-ask-sources';
            div.innerHTML = `<span class="lbl">Sources</span>${sources.map((s) => `<a href="${s.url}" class="src">${escapeHtml(s.title)}</a>`).join('')}`;
            container.appendChild(div);
        }

        function appendFeedback(container: HTMLElement, index: number) {
            const feedbackDiv = document.createElement('div');
            feedbackDiv.innerHTML = renderFeedback(index);
            container.appendChild(feedbackDiv.firstElementChild!);
        }

        async function submitQuery(query: string) {
            input.value = '';
            newConversationBtn.classList.remove('hidden');
            loading.classList.remove('hidden');
            errorContent.classList.add('hidden');
            btn.disabled = true;
            btn.textContent = 'Asking…';

            if (typeof window.plausible !== 'undefined') window.plausible('Ask Question', { props: { query } });

            const apiBase = window.location.hostname === 'localhost' ? 'https://joost.blog' : '';
            const fetchParams: Record<string, string> = { q: query, mode: 'stream', query_id: sessionId };
            if (exchanges.length > 0) {
                fetchParams.prev = JSON.stringify(exchanges.slice(-3));
            }

            try {
                const res = await fetch(`${apiBase}/ask?${new URLSearchParams(fetchParams)}`);

                if (!res.ok && !res.headers.get('content-type')?.includes('text/event-stream')) {
                    let msg = 'Request failed';
                    try {
                        const data = await res.json();
                        msg = data.error || msg;
                    } catch {
                        /* not JSON */
                    }
                    throw new Error(msg);
                }

                if (res.headers.get('content-type')?.includes('application/json')) {
                    const data = await res.json();
                    if (data.error) throw new Error(data.error);
                    const answer = data.answer || data.summary || 'No answer available.';
                    loading.classList.add('hidden');
                    addExchange(query, formatAnswer(answer), data.sources);
                    exchanges.push({ query, answer });
                } else {
                    loading.classList.add('hidden');
                    const target = addStreamingExchange(query);
                    let fullAnswer = '';
                    let sources: { url: string; title: string }[] = [];

                    const reader = res.body!.getReader();
                    const decoder = new TextDecoder();
                    let buffer = '';

                    while (true) {
                        const { done, value } = await reader.read();
                        if (done) break;

                        buffer += decoder.decode(value, { stream: true });
                        const lines = buffer.split('\n');
                        buffer = lines.pop()!;

                        for (const line of lines) {
                            if (!line.startsWith('data: ')) continue;
                            try {
                                const data = JSON.parse(line.slice(6));
                                if (data.token) {
                                    fullAnswer += data.token;
                                    target.innerHTML = formatAnswer(fullAnswer);
                                }
                                if (data.error && !fullAnswer) {
                                    target.innerHTML = `<p style="color:#4a6480">${escapeHtml(data.error)}</p>`;
                                }
                                if (data.fallback) {
                                    fullAnswer = data.fallback;
                                    target.innerHTML = formatAnswer(fullAnswer);
                                }
                                if (data.sources) {
                                    sources = data.sources;
                                }
                            } catch {
                                /* non-JSON line */
                            }
                        }
                    }

                    appendSources(target, sources);
                    appendFeedback(target, exchanges.length);
                    exchanges.push({ query, answer: fullAnswer });
                }
            } catch (err) {
                loading.classList.add('hidden');
                const error = err as Error;
                const msg =
                    error.message === 'Failed to fetch'
                        ? 'Could not reach the server. Check your connection and try again.'
                        : error.message || 'Something went wrong. Please try again.';
                errorMessage.textContent = msg;
                errorContent.classList.remove('hidden');
            }

            btn.disabled = false;
            btn.textContent = 'Ask →';
            input.focus();
            const lastExchange = conversation.lastElementChild;
            if (lastExchange) lastExchange.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        function escapeHtml(text: string) {
            return text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        }

        function formatAnswer(text: string) {
            const links: { label: string; url: string }[] = [];
            text = text.replace(/\[([^\]]+)\]\((https?:\/\/[^)]+)\)/g, (_, label, url) => {
                links.push({ label, url });
                return `%%LINK${links.length - 1}%%`;
            });

            text = text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

            text = text
                .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
                .replace(/\*(.+?)\*/g, '<em>$1</em>')
                .replace(/`(.+?)`/g, '<code>$1</code>')
                .replace(/^- (.+)$/gm, '<li>$1</li>')
                .replace(/(<li>.*<\/li>\n?)+/g, '<ul>$&</ul>')
                .replace(/\n\n/g, '</p><p>')
                .replace(/\n/g, '<br>');

            for (let i = 0; i < links.length; i++) {
                const { label, url } = links[i];
                text = text.replace(`%%LINK${i}%%`, `<a href="${url}">${label}</a>`);
            }

            return `<p>${text}</p>`;
        }
    });
</script>
