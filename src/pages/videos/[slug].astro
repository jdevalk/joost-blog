---
import { readFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchemaGraph from '../../components/SchemaGraph.astro';
import type { SchemaPageContext } from '../../utils/schema';
import { canonicalUrl } from '../../utils/schema/constants';

export async function getStaticPaths() {
    const videos = await getCollection('videos');
    return Promise.all(videos.map(async (video) => {
        let transcript = '';
        if (video.data.youtubeId) {
            const transcriptPath = join(process.cwd(), 'src/generated/transcripts', `${video.data.youtubeId}.txt`);
            if (existsSync(transcriptPath)) {
                transcript = readFileSync(transcriptPath, 'utf8').trim();
            }
        }
        let thumbnailUrl: string | undefined;
        if (video.data.featureImage) {
            const img = await getImage({ src: video.data.featureImage, width: 1200 });
            thumbnailUrl = new URL(img.src, 'https://joost.blog').href;
        } else if (video.data.thumbnailUrl) {
            thumbnailUrl = video.data.thumbnailUrl;
        }
        return {
            params: { slug: video.id },
            props: { video, transcript, thumbnailUrl }
        };
    }));
}

const { video, transcript, thumbnailUrl } = Astro.props;
const { Content } = await render(video);

function formatDuration(isoDuration: string | undefined): string | null {
    if (!isoDuration) return null;
    const match = isoDuration.match(/PT(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?/);
    if (!match) return null;
    const h = parseInt(match[1] || '0');
    const m = parseInt(match[2] || '0');
    const s = parseInt(match[3] || '0');
    return h > 0
        ? `${h}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`
        : `${m}:${String(s).padStart(2, '0')}`;
}

function dotDate(date: Date): string {
    return `${date.getFullYear()}·${String(date.getMonth()+1).padStart(2,'0')}·${String(date.getDate()).padStart(2,'0')}`;
}

function parseTimestampedTranscript(text: string, youtubeId: string | undefined): { secs: number; label: string; url: string | null; body: string }[] | null {
    if (!text.match(/^\[\d+:\d{2}/)) return null;
    return text.split(/\n\n+/).map(para => {
        const m = para.match(/^\[(\d+):(\d{2})(?::(\d{2}))?\]\s*([\s\S]*)/);
        if (!m) return null;
        const [, a, b, c, body] = m;
        const secs = c !== undefined
            ? parseInt(a) * 3600 + parseInt(b) * 60 + parseInt(c)
            : parseInt(a) * 60 + parseInt(b);
        const label = c !== undefined ? `${a}:${b}:${c}` : `${a}:${b}`;
        const url = youtubeId ? `https://www.youtube.com/watch?v=${youtubeId}&t=${secs}` : null;
        return { secs, label, url, body: body.trim() };
    }).filter(Boolean) as { secs: number; label: string; url: string | null; body: string }[];
}

const duration = formatDuration(video.data.duration);
const pubDate = dotDate(new Date(video.data.publishDate));
const seoTitle = video.data.seo?.title ?? video.data.title;
const seoDescription = video.data.seo?.description ?? video.data.title;

const pageContext: SchemaPageContext = {
    pageType: 'video',
    canonicalUrl: canonicalUrl(Astro.url.pathname),
    title: seoTitle,
    description: seoDescription,
    publishDate: video.data.publishDate,
    youtubeId: video.data.youtubeId,
    duration: video.data.duration,
    thumbnailUrl,
};
---

<BaseLayout title={seoTitle} description={seoDescription}>
    <SchemaGraph pageContext={pageContext} />

    <div class="sp-root sp-blocks sp-video">

        <section class="sp-video-hero">
            <div class="sp-section-inner">
            <nav class="sp-video-crumbs" aria-label="Breadcrumb">
                <a href="/videos/">Videos</a>
                <span class="sep">/</span>
                <span>{new Date(video.data.publishDate).getFullYear()}</span>
                <span class="sep">/</span>
                <span style="color:var(--accent)">{video.data.title}</span>
            </nav>
            <div class="sp-video-meta-top">
                <span>{pubDate}</span>
                {duration && <span>&middot; {duration}</span>}
            </div>
            <h1 class="sp-video-title">{video.data.title}</h1>
            </div>
        </section>

        <div class="sp-video-player-wrap">
            {video.data.youtubeId ? (
                <div class="sp-video-player" style="padding:0">
                    <iframe
                        id="yt-player"
                        src={`https://www.youtube.com/embed/${video.data.youtubeId}?enablejsapi=1`}
                        title={video.data.title}
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        allowfullscreen
                        loading="lazy"
                        style="position:absolute;inset:0;width:100%;height:100%;border:0"
                    ></iframe>
                </div>
            ) : video.data.videoPressId ? (
                <div class="sp-video-player" style="padding:0">
                    <iframe
                        src={`https://video.wordpress.com/embed/${video.data.videoPressId}`}
                        title={video.data.title}
                        style="width:100%;height:100%;border:0"
                        allowfullscreen
                    ></iframe>
                </div>
            ) : video.data.videoUrl ? (
                <div style="padding:24px 0">
                    <a href={video.data.videoUrl} target="_blank" rel="noopener noreferrer" class="sp-btn sp-btn--mono">Watch video →</a>
                </div>
            ) : null}
        </div>

        <div class="sp-video-body" data-pagefind-body>
            <div class="sp-prose">
                <Content />
            </div>
        </div>

        {transcript && (() => {
            const parsed = parseTimestampedTranscript(transcript, video.data.youtubeId);
            const wordCount = transcript.replace(/\[\d+:\d{2}(?::\d{2})?\]\s*/g, '').split(/\s+/).filter(Boolean).length;
            return (
            <div class="sp-video-transcript-wrap">
                <button class="sp-video-transcript-toggle" id="transcript-toggle" type="button" aria-expanded="false">
                    <span>Full transcript &rarr;</span>
                    <span class="meta">{duration && `${duration} · `}{wordCount.toLocaleString()} WORDS</span>
                    <span class="caret">&#9660;</span>
                </button>
                <div class="sp-video-transcript" id="transcript-body" style="display:none">
                    {parsed ? (
                        <div class="sp-transcript-timestamped">
                            {parsed.map(({ secs, label, url, body }) => (
                                <div class="sp-transcript-para">
                                    {url
                                        ? <a href={`#t=${secs}`} data-t={String(secs)} class="sp-transcript-ts">{label}</a>
                                        : <span class="sp-transcript-ts">{label}</span>
                                    }
                                    <span class="sp-transcript-text">{body}</span>
                                </div>
                            ))}
                        </div>
                    ) : (
                        <div style="padding:24px 0;white-space:pre-line;font-family:var(--font-text);font-weight:300;font-size:17px;line-height:1.6;color:var(--body)">
                            {transcript}
                        </div>
                    )}
                </div>
            </div>
            );
        })()}

    </div>
</BaseLayout>

<style>
    .sp-video-hero {
        padding: 56px 0 20px;
    }
    .sp-video-hero .sp-section-inner {
        max-width: var(--measure);
        margin: 0 auto;
    }
    .sp-video-crumbs {
        font-family: var(--font-mono);
        font-size: 12px;
        letter-spacing: 0.04em;
        color: var(--faint);
        margin-bottom: 18px;
    }
    .sp-video-crumbs a {
        color: var(--accent);
        text-decoration: none;
    }
    .sp-video-crumbs .sep {
        margin: 0 8px;
        color: var(--hair-strong);
    }
    .sp-video-meta-top {
        display: flex;
        gap: 10px;
        font-family: var(--font-mono);
        font-size: 11.5px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--faint);
        margin-bottom: 14px;
    }
    .sp-video-title {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: clamp(34px, 4.4vw, 52px);
        line-height: 1.04;
        letter-spacing: -0.02em;
        color: var(--ink);
        margin: 0;
    }
    .sp-video-player-wrap {
        max-width: 860px;
        margin: 24px auto 8px;
    }
    .sp-video-player {
        position: relative;
        aspect-ratio: 16/9;
        background: var(--dark);
        border-radius: 3px;
        overflow: hidden;
    }
    .sp-video-body {
        padding: 28px 0 12px;
    }

    .sp-video-transcript-wrap {
        max-width: var(--measure);
        margin: 8px auto 24px;
    }
    .sp-video-transcript-toggle {
        display: flex;
        align-items: center;
        gap: 14px;
        width: 100%;
        background: none;
        border: none;
        border-top: 2px solid var(--rule);
        padding: 18px 0;
        cursor: pointer;
        font-family: var(--font-mono);
        font-size: 13px;
        color: var(--accent);
        text-align: left;
    }
    .sp-video-transcript-toggle .meta {
        margin-left: auto;
        font-size: 10.5px;
        letter-spacing: 0.08em;
        color: var(--faint);
    }
    .sp-video-transcript-toggle .caret {
        font-size: 9px;
        color: var(--faint);
    }
    .sp-transcript-timestamped {
        display: flex;
        flex-direction: column;
        gap: 16px;
        padding: 8px 0 24px;
    }
    .sp-transcript-para {
        display: grid;
        grid-template-columns: 64px 1fr;
        gap: 16px;
        align-items: baseline;
    }
    .sp-transcript-ts {
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--accent);
        text-decoration: none;
    }
    .sp-transcript-text {
        font-family: var(--font-text);
        font-size: 17px;
        line-height: 1.6;
        color: var(--body);
    }
</style>

<script>
    const transcriptToggle = document.getElementById('transcript-toggle');
    const transcriptBody = document.getElementById('transcript-body');

    if (transcriptToggle && transcriptBody) {
        transcriptToggle.addEventListener('click', () => {
            const isOpen = transcriptBody.style.display !== 'none';
            transcriptBody.style.display = isOpen ? 'none' : 'block';
            transcriptToggle.setAttribute('aria-expanded', String(!isOpen));
        });
    }

    // YouTube IFrame API — seek to timestamp on transcript link click
    const playerIframe = document.getElementById('yt-player') as HTMLIFrameElement | null;
    if (playerIframe) {
        let ytPlayer: YT.Player | null = null;

        function seekTo(secs: number) {
            if (!ytPlayer) return;
            ytPlayer.seekTo(secs, true);
            ytPlayer.playVideo();
            playerIframe.closest('.sp-video-player-wrap')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        (window as any).onYouTubeIframeAPIReady = () => {
            ytPlayer = new YT.Player('yt-player');
            const hash = window.location.hash.match(/^#t=(\d+)$/);
            if (hash) seekTo(parseInt(hash[1]));
        };

        const tag = document.createElement('script');
        tag.src = 'https://www.youtube.com/iframe_api';
        document.head.appendChild(tag);

        document.addEventListener('click', (e) => {
            const link = (e.target as Element).closest('a.sp-transcript-ts') as HTMLAnchorElement | null;
            if (!link) return;
            const tParam = link.dataset.t;
            if (!tParam || !ytPlayer) return;
            e.preventDefault();
            history.replaceState(null, '', `#t=${tParam}`);
            seekTo(parseInt(tParam));
        });
    }
</script>
