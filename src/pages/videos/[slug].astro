---
import { readFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchemaGraph from '../../components/SchemaGraph.astro';
import SpChrome from '../../components/SpChrome.astro';
import SpFooter from '../../components/SpFooter.astro';
import type { SchemaPageContext } from '../../utils/schema';
import { canonicalUrl } from '../../utils/schema/constants';

export async function getStaticPaths() {
    const videos = await getCollection('videos');
    return videos.map((video) => {
        let transcript = '';
        if (video.data.youtubeId) {
            const transcriptPath = join(process.cwd(), 'src/generated/transcripts', `${video.data.youtubeId}.txt`);
            if (existsSync(transcriptPath)) {
                transcript = readFileSync(transcriptPath, 'utf8').trim();
            }
        }
        return {
            params: { slug: video.id },
            props: { video, transcript }
        };
    });
}

const { video, transcript } = Astro.props;
const { Content } = await render(video);

function formatDuration(isoDuration: string | undefined): string | null {
    if (!isoDuration) return null;
    const match = isoDuration.match(/PT(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?/);
    if (!match) return null;
    const h = parseInt(match[1] || '0');
    const m = parseInt(match[2] || '0');
    const s = parseInt(match[3] || '0');
    return h > 0
        ? `${h}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`
        : `${m}:${String(s).padStart(2, '0')}`;
}

function dotDate(date: Date): string {
    return `${date.getFullYear()}·${String(date.getMonth()+1).padStart(2,'0')}·${String(date.getDate()).padStart(2,'0')}`;
}

const duration = formatDuration(video.data.duration);
const pubDate = dotDate(new Date(video.data.publishDate));
const seoTitle = video.data.seo?.title ?? video.data.title;
const seoDescription = video.data.seo?.description ?? video.data.title;

const pageContext: SchemaPageContext = {
    pageType: 'video',
    canonicalUrl: canonicalUrl(Astro.url.pathname),
    title: seoTitle,
    description: seoDescription,
    publishDate: video.data.publishDate,
    youtubeId: video.data.youtubeId,
    duration: video.data.duration
};
---

<BaseLayout title={seoTitle} description={seoDescription}>
    <SchemaGraph pageContext={pageContext} />
    <div slot="header" />
    <div slot="footer" />

    <div class="sp-root sp-blocks sp-video">
        <SpChrome issue="VIDEOS · TALKS · INTERVIEWS" />

        <section class="sp-video-hero">
            <nav class="sp-video-crumbs" aria-label="Breadcrumb">
                <a href="/videos/">Videos</a>
                <span class="sep">/</span>
                <span>{new Date(video.data.publishDate).getFullYear()}</span>
                <span class="sep">/</span>
                <span style="color:#5e1224">{video.data.title}</span>
            </nav>
            <div class="sp-video-meta-top">
                <span>{pubDate}</span>
                {duration && <span>&middot; {duration}</span>}
            </div>
            <h1 class="sp-video-title">{video.data.title}</h1>
        </section>

        <div class="sp-video-player-wrap">
            {video.data.youtubeId ? (
                <div class="sp-video-player" style="padding:0">
                    <iframe
                        src={`https://www.youtube.com/embed/${video.data.youtubeId}`}
                        title={video.data.title}
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        allowfullscreen
                        loading="lazy"
                        style="position:absolute;inset:0;width:100%;height:100%;border:0"
                    ></iframe>
                </div>
            ) : video.data.videoPressId ? (
                <div class="sp-video-player" style="padding:0">
                    <iframe
                        src={`https://video.wordpress.com/embed/${video.data.videoPressId}`}
                        title={video.data.title}
                        style="width:100%;height:100%;border:0"
                        allowfullscreen
                    ></iframe>
                </div>
            ) : video.data.videoUrl ? (
                <div style="padding:32px 64px">
                    <a href={video.data.videoUrl} target="_blank" rel="noopener noreferrer" class="sp-about-build-cta" style="display:inline-block">
                        <span class="primary" style="font-family:'Fraunces',serif;font-style:italic;font-size:20px;padding:14px 22px;background:#d98c3a;color:#1a1410;display:inline-block">Watch video &rarr;</span>
                    </a>
                </div>
            ) : null}
        </div>

        <div class="sp-video-body" data-pagefind-body>
            <div class="sp-video-grid">
                <div></div>
                <div class="sp-video-prose">
                    <Content />
                </div>
                <div></div>
            </div>
        </div>

        {transcript && (
            <div class="sp-video-transcript-wrap">
                <button class="sp-video-transcript-toggle" id="transcript-toggle" type="button" aria-expanded="false">
                    <span>Full transcript &rarr;</span>
                    <span class="meta">{transcript.split(' ').length.toLocaleString()} WORDS</span>
                    <span class="caret">&#9660;</span>
                </button>
                <div class="sp-video-transcript" id="transcript-body" style="display:none">
                    <div style="padding:24px;white-space:pre-line;font-family:'Fraunces',serif;font-size:17px;line-height:1.6;color:#1a1410">
                        {transcript}
                    </div>
                </div>
            </div>
        )}

        <SpFooter />
    </div>
</BaseLayout>

<script>
    const transcriptToggle = document.getElementById('transcript-toggle');
    const transcriptBody = document.getElementById('transcript-body');

    if (transcriptToggle && transcriptBody) {
        transcriptToggle.addEventListener('click', () => {
            const isOpen = transcriptBody.style.display !== 'none';
            transcriptBody.style.display = isOpen ? 'none' : 'block';
            transcriptToggle.setAttribute('aria-expanded', String(!isOpen));
        });
    }
</script>
