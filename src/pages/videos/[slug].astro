---
import { readFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchemaGraph from '../../components/SchemaGraph.astro';
import type { SchemaPageContext } from '../../utils/schema';
import { canonicalUrl } from '../../utils/schema/constants';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';

export async function getStaticPaths() {
    const videos = await getCollection('videos');
    return videos.map((video) => {
        let transcript = '';
        if (video.data.youtubeId) {
            const transcriptPath = join(process.cwd(), 'src/generated/transcripts', `${video.data.youtubeId}.txt`);
            if (existsSync(transcriptPath)) {
                transcript = readFileSync(transcriptPath, 'utf8').trim();
            }
        }
        return {
            params: { slug: video.id },
            props: { video, transcript }
        };
    });
}

const { video, transcript } = Astro.props;
const { Content } = await render(video);

function formatDuration(isoDuration: string | undefined): string | null {
    if (!isoDuration) return null;
    const match = isoDuration.match(/PT(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?/);
    if (!match) return null;
    const hours = parseInt(match[1] || '0');
    const minutes = parseInt(match[2] || '0');
    const seconds = parseInt(match[3] || '0');
    if (hours > 0) {
        return `${hours}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
    }
    return `${minutes}:${String(seconds).padStart(2, '0')}`;
}

const duration = formatDuration(video.data.duration);

const seoTitle = video.data.seo?.title ?? video.data.title;
const seoDescription = video.data.seo?.description ?? video.data.title;

const pageContext: SchemaPageContext = {
    pageType: 'video',
    canonicalUrl: canonicalUrl(Astro.url.pathname),
    title: seoTitle,
    description: seoDescription,
    publishDate: video.data.publishDate,
    youtubeId: video.data.youtubeId,
    duration: video.data.duration
};
---

<BaseLayout title={seoTitle} description={seoDescription}>
    <SchemaGraph pageContext={pageContext} />
    <main class="grow px-4 py-12 sm:px-8" data-pagefind-body>
        <div class="max-w-4xl mx-auto">
            <nav class="mb-6 text-sm" aria-label="Breadcrumb">
                <ol class="flex items-center gap-1.5">
                    <li><a href="/" class="text-slate-500 dark:text-slate-400 hover:text-primary dark:hover:text-accent transition-colors">Home</a></li>
                    <li class="before:content-['/'] before:mx-1.5 before:text-slate-300 dark:before:text-slate-600"><a href="/videos/" class="text-primary dark:text-accent hover:text-secondary dark:hover:text-white transition-colors">Videos</a></li>
                    <li class="before:content-['/'] before:mx-1.5 before:text-slate-300 dark:before:text-slate-600 text-slate-900 dark:text-slate-100 font-medium truncate" aria-current="page">{video.data.title}</li>
                </ol>
            </nav>
            <h1 class="text-4xl font-bold mb-6 text-slate-900 dark:text-slate-100">{video.data.title}</h1>
            {duration && (
                <p class="text-sm text-slate-500 dark:text-slate-400 mb-6">Duration: {duration}</p>
            )}
            {video.data.youtubeId && (
                <div class="mb-8">
                    <YouTubeEmbed youtubeId={video.data.youtubeId} title={video.data.title} />
                </div>
            )}
            {!video.data.youtubeId && video.data.videoPressId && (
                <div class="mb-8">
                    <div class="aspect-video w-full">
                        <iframe
                            src={`https://video.wordpress.com/embed/${video.data.videoPressId}`}
                            title={video.data.title}
                            class="w-full h-full"
                            allowfullscreen
                        ></iframe>
                    </div>
                </div>
            )}
            {!video.data.youtubeId && !video.data.videoPressId && video.data.videoUrl && (
                <div class="mb-8">
                    <a
                        href={video.data.videoUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center rounded-lg bg-primary px-4 py-2 text-white hover:opacity-90 transition"
                    >
                        Watch video
                    </a>
                </div>
            )}
            <div class="prose prose-slate dark:prose-invert max-w-none">
                <Content />
            </div>
            {transcript && (
                <details class="mt-8 rounded-lg border border-slate-200 dark:border-[#2a2623]">
                    <summary class="cursor-pointer px-5 py-3 text-sm font-semibold text-slate-700 dark:text-slate-300 hover:text-primary dark:hover:text-accent transition-colors">
                        Show transcript
                    </summary>
                    <div class="px-5 pb-5 text-sm leading-relaxed text-slate-600 dark:text-slate-400 whitespace-pre-line">
                        {transcript}
                    </div>
                </details>
            )}
        </div>
    </main>
</BaseLayout>
