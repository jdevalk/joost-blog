---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchemaGraph from '../../components/SchemaGraph.astro';
import type { SchemaPageContext } from '../../utils/schema';
import { canonicalUrl } from '../../utils/schema/constants';

const allVideos = await getCollection('videos');
const sorted = allVideos.sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime());
const featuredVideo = sorted.find((v) => v.data.featured) ?? sorted[0];
const gridVideos = sorted.filter((v) => v.id !== featuredVideo.id);

function monthYear(date: Date): string {
    return date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
}

function getExcerpt(body: string | undefined): string {
    if (!body) return '';
    const stripped = body
        .replace(/<[^>]+>/g, '')
        .replace(/\s+/g, ' ')
        .trim();
    if (stripped.length <= 150) return stripped;
    return `${stripped.slice(0, 147).trim()}…`;
}

async function resolveThumb(video: (typeof sorted)[0]): Promise<string | null> {
    if (video.data.thumbnailUrl) return video.data.thumbnailUrl;
    if (video.data.featureImage) {
        const img = await getImage({ src: video.data.featureImage, width: 800 });
        return img.src;
    }
    const yt = video.data.youtubeId;
    if (yt) return `https://img.youtube.com/vi/${yt}/maxresdefault.jpg`;
    return null;
}

const featuredThumb = await resolveThumb(featuredVideo);
const featuredExcerpt = getExcerpt(featuredVideo.body);
const gridThumbs = await Promise.all(gridVideos.map(resolveThumb));

function withLabel(w: string | string[] | undefined): string {
    if (!w) return '';
    return Array.isArray(w) ? w.join(', ') : w;
}

const pageContext: SchemaPageContext = {
    pageType: 'videoListing',
    canonicalUrl: canonicalUrl('/videos/'),
    title: 'Videos',
    description: 'Conference talks, keynotes, and interviews by Joost de Valk on WordPress, SEO, open source, and the web.'
};
---

<BaseLayout title="Videos" description="A decade of conference talks on sustainable open source, SEO, and building a business on a plugin.">
    <SchemaGraph pageContext={pageContext} />

    <div class="sp-root sp-videos">
        <section class="videos-hero">
            <h1 class="sp-display">Talks</h1>
            <p class="sp-section-lede">A decade of conference stages — on sustainable open source, SEO, and building a business on a plugin.</p>
        </section>

        <a href={`/videos/${featuredVideo.id}/`} class="videos-featured">
            <div class="poster" style={featuredThumb ? `--poster: url('${featuredThumb}')` : ''} data-has-thumb={featuredThumb ? 'true' : undefined}>
                <span class="play play--lg"><span class="tri"></span></span>
                {featuredVideo.data.type && <span class="badge">{featuredVideo.data.type}</span>}
            </div>
            <div class="body">
                <span class="eyebrow">Featured · {monthYear(new Date(featuredVideo.data.publishDate))}</span>
                <h2>{featuredVideo.data.title}</h2>
                {featuredExcerpt && <p>{featuredExcerpt}</p>}
                <span class="watch">watch the talk →</span>
            </div>
        </a>

        <section class="videos-grid">
            {
                gridVideos.map((v, i) => (
                    <a href={`/videos/${v.id}/`} class="video-card">
                        <div class="thumb" style={gridThumbs[i] ? `--poster: url('${gridThumbs[i]}')` : ''} data-has-thumb={gridThumbs[i] ? 'true' : undefined}>
                            <span class="play">
                                <span class="tri" />
                            </span>
                            {v.data.type && <span class="badge">{v.data.type}</span>}
                        </div>
                        <div class="date">
                            {monthYear(new Date(v.data.publishDate))}
                            {v.data.with && ` · with ${withLabel(v.data.with)}`}
                        </div>
                        <div class="title">{v.data.title}</div>
                    </a>
                ))
            }
        </section>

        <section class="videos-cta">
            <div>
                <h2>Looking for a speaker?</h2>
                <p>I love the chance to speak at conferences all over the world.</p>
            </div>
            <a href="/contact-me/" class="sp-btn sp-btn--mono">Invite me to speak →</a>
        </section>
    </div>
</BaseLayout>

<style>
    .videos-hero {
        padding: 60px 0 36px;
        max-width: 48ch;
    }

    /* Poster / thumbnail shared treatment */
    .poster,
    .thumb {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background: linear-gradient(135deg, rgba(31, 37, 48, 0.55), rgba(31, 37, 48, 0.35)), var(--poster, linear-gradient(135deg, #6a7a5d, #3d4838));
        background-size: cover;
        background-position: center;
    }
    .thumb {
        aspect-ratio: 16/9;
        border-radius: 2px;
        background: linear-gradient(rgba(31, 37, 48, 0.4), rgba(31, 37, 48, 0.4)), var(--poster, linear-gradient(135deg, #5c6e57, #3d4838));
        background-size: cover;
        background-position: center;
    }
    .play {
        position: relative;
        z-index: 2;
        width: 52px;
        height: 52px;
        border-radius: 50%;
        border: 2px solid rgba(255, 255, 255, 0.9);
        background: rgba(31, 37, 48, 0.25);
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .play--lg {
        width: 74px;
        height: 74px;
    }
    .play .tri {
        width: 0;
        height: 0;
        border-style: solid;
        border-width: 9px 0 9px 15px;
        border-color: transparent transparent transparent var(--paper-white);
        margin-left: 4px;
    }
    .play--lg .tri {
        border-width: 13px 0 13px 22px;
        margin-left: 5px;
    }
    .badge {
        position: absolute;
        z-index: 2;
        top: 14px;
        left: 16px;
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 0.1em;
        color: rgba(255, 255, 255, 0.85);
        text-transform: uppercase;
    }

    /* Featured */
    .videos-featured {
        text-decoration: none;
        display: grid;
        grid-template-columns: 1.3fr 1fr;
        background: var(--dark);
        border-radius: 3px;
        overflow: hidden;
        margin-bottom: 30px;
        transition: opacity 0.15s;
    }
    .videos-featured:hover {
        opacity: 0.97;
    }
    .videos-featured .poster {
        min-height: 300px;
    }
    .videos-featured .body {
        padding: 38px 36px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }
    .videos-featured .eyebrow {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.08em;
        color: var(--dark-fg-accent);
        text-transform: uppercase;
    }
    .videos-featured h2 {
        font-family: var(--font-display);
        font-weight: 500;
        font-size: 34px;
        line-height: 1.08;
        color: var(--paper-white);
        margin: 14px 0 0;
    }
    .videos-featured p {
        font-family: var(--font-text);
        font-size: 17px;
        line-height: 1.5;
        color: var(--dark-fg-soft);
        margin: 14px 0 0;
    }
    .videos-featured .watch {
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--dark-fg-accent);
        margin-top: 20px;
    }

    /* Grid */
    .videos-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 26px;
        padding-bottom: 20px;
    }
    .video-card {
        text-decoration: none;
        display: block;
        transition: opacity 0.15s;
    }
    .video-card:hover {
        opacity: 0.92;
    }
    .video-card .date {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--faint);
        margin-top: 12px;
    }
    .video-card .title {
        font-family: var(--font-display);
        font-weight: 500;
        font-size: 19px;
        color: var(--ink);
        margin-top: 5px;
        line-height: 1.15;
    }

    /* Speaker CTA */
    .videos-cta {
        margin: 34px 0 8px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 30px;
        flex-wrap: wrap;
        padding: 30px 0;
    }
    .videos-cta h2 {
        font-family: var(--font-display);
        font-weight: 500;
        font-size: 30px;
        color: var(--ink);
        margin: 0;
    }
    .videos-cta p {
        font-family: var(--font-text);
        font-size: 18px;
        color: var(--secondary);
        margin: 8px 0 0;
    }
    .videos-cta .sp-btn {
        color: var(--paper-white);
    }

    @media (max-width: 820px) {
        .videos-featured {
            grid-template-columns: 1fr;
        }
        .videos-grid {
            grid-template-columns: 1fr 1fr;
        }
    }
    @media (max-width: 560px) {
        .videos-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
