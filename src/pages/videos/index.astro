---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchemaGraph from '../../components/SchemaGraph.astro';
import type { SchemaPageContext } from '../../utils/schema';
import { canonicalUrl } from '../../utils/schema/constants';
import CustomImage from '../../components/CustomImage.astro';

const allVideos = await getCollection('videos');
const videos = allVideos.sort(
    (a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);

function formatDuration(isoDuration: string | undefined): string | null {
    if (!isoDuration) return null;
    const match = isoDuration.match(/PT(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?/);
    if (!match) return null;
    const hours = parseInt(match[1] || '0');
    const minutes = parseInt(match[2] || '0');
    const seconds = parseInt(match[3] || '0');
    if (hours > 0) {
        return `${hours}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
    }
    return `${minutes}:${String(seconds).padStart(2, '0')}`;
}

function formatDate(date: Date): string {
    return new Intl.DateTimeFormat('en', {
        year: 'numeric',
        month: 'short',
        day: 'numeric'
    }).format(date);
}

function getExcerpt(body: string): string {
    const stripped = body.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
    if (stripped.length <= 150) return stripped;
    return `${stripped.slice(0, 147).trim()}...`;
}

const pageContext: SchemaPageContext = {
    pageType: 'videoListing',
    canonicalUrl: canonicalUrl('/videos/'),
    title: 'Videos',
    description: 'Video presentations and talks by Joost de Valk'
};
---

<BaseLayout title="Videos - Joost.blog" description="Video presentations and talks by Joost de Valk">
    <SchemaGraph pageContext={pageContext} />
    <main class="grow px-4 py-12 sm:px-8" data-pagefind-ignore="all">
        <div class="max-w-6xl mx-auto">
            <div class="max-w-3xl mb-12">
                <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary mb-3">Talks, interviews & keynotes</p>
                <h1 class="text-4xl sm:text-5xl font-bold mb-4 text-slate-900 dark:text-slate-100">Videos</h1>
                <p class="text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
                    A curated archive of talks, interviews, podcasts, and conference sessions featuring Joost de Valk — ordered from newest to oldest.
                </p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {videos.map((video) => {
                    const duration = formatDuration(video.data.duration);
                    const excerpt = getExcerpt(video.body);
                    return (
                        <a href={`/videos/${video.id}/`} class="group block h-full">
                            <article class="h-full overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl dark:border-slate-700 dark:bg-slate-900">
                                <div class="relative overflow-hidden">
                                    {video.data.featureImage?.src && (
                                        <CustomImage
                                            {...video.data.featureImage}
                                            class="w-full aspect-video object-cover transition-transform duration-300 group-hover:scale-105"
                                            loading="lazy"
                                            widths={[400, 600]}
                                        />
                                    )}
                                    {duration && (
                                        <span class="absolute bottom-3 right-3 rounded bg-black/80 px-2 py-1 text-xs font-medium text-white">
                                            {duration}
                                        </span>
                                    )}
                                </div>
                                <div class="p-5">
                                    <p class="mb-2 text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">
                                        {formatDate(video.data.publishDate)}
                                    </p>
                                    <h2 class="text-xl font-semibold text-slate-900 transition-colors group-hover:text-primary dark:text-slate-100">
                                        {video.data.title}
                                    </h2>
                                    <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-300">{excerpt}</p>
                                </div>
                            </article>
                        </a>
                    );
                })}
            </div>
        </div>
    </main>
</BaseLayout>
