---
import { type CollectionEntry } from 'astro:content';
import CustomImage from './CustomImage.astro';
import FormattedDate from './FormattedDate.astro';
import { slugify, getReadingTime } from '../utils/post-utils';

const { post } = Astro.props as { post: CollectionEntry<'blog'> };
const { title, publishDate, updatedDate, featureImage, excerpt, categories } = post.data;
const readingTime = getReadingTime(post.body ?? '');
---

<article class="group">
    <div class="grid gap-6 lg:grid-cols-2 lg:gap-10 items-center">
        {featureImage?.src && (
            <a href={`/${post.id}/`} aria-label={title} class="block overflow-hidden rounded-lg">
                <CustomImage
                    {...featureImage}
                    class="w-full aspect-[16/9] object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                    widths={[480, 640, 768, 960, 1200]}
                    sizes="(min-width: 1024px) 50vw, calc(100vw - 32px)"
                    fetchpriority="high"
                    loading="eager"
                />
            </a>
        )}
        <div>
            <div class="mb-3 flex flex-wrap items-center gap-2 text-xs">
                {categories && categories.length > 0 && categories.map((cat: string) => (
                    <a
                        href={`/category/${slugify(cat)}/`}
                        class="rounded-full bg-primary/15 px-2.5 py-0.5 font-bold text-primary transition-colors duration-300 hover:bg-primary hover:text-white dark:bg-accent/15 dark:text-accent dark:hover:bg-accent dark:hover:text-slate-900"
                    >
                        {cat}
                    </a>
                ))}
            </div>
            <h2 class="text-2xl font-extrabold leading-snug tracking-tight text-slate-900 dark:text-slate-100 sm:text-3xl lg:text-4xl">
                <a href={`/${post.id}/`} class="hover:text-primary dark:hover:text-accent transition-colors duration-300">{title}</a>
            </h2>
            {excerpt && (
                <p class="mt-3 text-base leading-relaxed text-slate-600 dark:text-slate-400 line-clamp-3">{excerpt}</p>
            )}
            <div class="mt-4 flex items-center gap-3 text-sm text-slate-500 dark:text-slate-400">
                <FormattedDate date={publishDate} />
                <span>&middot;</span>
                <span>{readingTime} min read</span>
            </div>
            <div class="mt-5">
                <a
                    class="inline-flex items-center gap-1.5 text-sm font-bold text-primary hover:text-secondary dark:text-accent dark:hover:text-white transition-colors duration-300"
                    href={`/${post.id}/`}
                >
                    Read article
                    <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
                    </svg>
                </a>
            </div>
        </div>
    </div>
</article>
