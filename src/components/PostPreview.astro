---
import { type CollectionEntry } from 'astro:content';
import CustomImage from './CustomImage.astro';
import FormattedDate from './FormattedDate.astro';
import { slugify, getReadingTime } from '../utils/post-utils';

const { post } = Astro.props as { post: CollectionEntry<'blog'> };
const { title, publishDate, updatedDate, featureImage, excerpt, isFeatured, categories } = post.data;
const readingTime = getReadingTime(post.body ?? '');
---

<article class="group flex flex-col overflow-hidden rounded-lg border border-slate-200 bg-white shadow-card transition duration-300 hover:shadow-card-hover hover:-translate-y-0.5 dark:border-slate-700 dark:bg-slate-800/50">
    {featureImage?.src && (
        <a href={`/${post.id}/`} aria-label={title} class="block overflow-hidden">
            <CustomImage
                {...featureImage}
                class="w-full aspect-[16/9] object-cover transition-transform duration-500 group-hover:scale-105"
                widths={[320, 480, 640, 768]}
                sizes="(min-width: 1024px) 384px, (min-width: 640px) 50vw, calc(100vw - 32px)"
            />
        </a>
    )}
    <div class="flex flex-1 flex-col p-5">
        <div class="mb-2 flex flex-wrap items-center gap-2 text-xs">
            {categories && categories.length > 0 && categories.map((cat: string) => (
                <a
                    href={`/category/${slugify(cat)}/`}
                    class="rounded-full bg-primary/15 px-2.5 py-0.5 font-bold text-primary transition-colors duration-300 hover:bg-primary hover:text-white dark:bg-accent/15 dark:text-accent dark:hover:bg-accent dark:hover:text-slate-900"
                >
                    {cat}
                </a>
            ))}
        </div>
        <h2 class="text-xl font-extrabold leading-snug text-slate-900 dark:text-slate-100">
            <a href={`/${post.id}/`} class="hover:text-primary dark:hover:text-accent transition-colors duration-300">{title}</a>
        </h2>
        {excerpt && (
            <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400 line-clamp-2">{excerpt}</p>
        )}
        <div class="mt-auto pt-4 flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
            <FormattedDate date={publishDate} />
            <span>&middot;</span>
            <span>{readingTime} min read</span>
        </div>
    </div>
</article>
