---
import { Image } from 'astro:assets';
import avatar from '../assets/images/joost-tuscany.jpg';
import siteConfig from '../data/site-config';

const pathname = Astro.url.pathname;

function isActive(href: string): boolean {
    if (href === '/') return pathname === '/';
    // Blog stays active on category pages and individual posts reached via /blog
    if (href === '/blog/') return pathname.startsWith('/blog') || pathname.startsWith('/category');
    return pathname.startsWith(href);
}
---

<header class="site-header">
    <a href="/" class="site-wordmark">
        <Image src={avatar} alt="Joost de Valk" width={160} height={160} loading="eager" class="site-avatar" />
        <span>Joost de Valk</span>
    </a>
    <div class="site-nav-group">
        <nav class="site-nav" aria-label="Primary navigation">
            {
                siteConfig.primaryNavLinks?.map((link) => (
                    <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
                        {link.text}
                    </a>
                ))
            }
        </nav>
        <button type="button" class="site-search" data-open-search aria-label="Search (⌘K)">
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="19"
                height="19"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
            >
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.3-4.3"></path>
            </svg>
        </button>
    </div>
</header>
