---
import { Image } from 'astro:assets';
import avatar from '../assets/images/joost-headshot.jpg';
import siteConfig from '../data/site-config';

const pathname = Astro.url.pathname;

function isActive(href: string): boolean {
    if (href === '/') return pathname === '/';
    // Blog stays active on category pages and individual posts reached via /blog
    if (href === '/blog/') return pathname.startsWith('/blog') || pathname.startsWith('/category');
    return pathname.startsWith(href);
}
---

<header class="site-header">
    <a href="/" class="site-wordmark">
        <Image src={avatar} alt="Joost de Valk" width={72} loading="eager" class="site-avatar" />
        <span>Joost de Valk</span>
    </a>
    <nav class="site-nav" aria-label="Primary navigation">
        {
            siteConfig.primaryNavLinks?.map((link) => (
                <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
                    {link.text}
                </a>
            ))
        }
    </nav>
</header>
