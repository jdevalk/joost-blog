---
import HeaderNavLink from './HeaderNavLink.astro';
import ThemeToggle from './ThemeToggle.astro';
import siteConfig from '../data/site-config';
import CustomImage from './CustomImage.astro';

const primaryNavLinks = siteConfig.primaryNavLinks ?? [];

const { class: className, variant } = Astro.props;
const isDark = variant === 'dark';
---

<header class:list={['flex items-center justify-between gap-4 px-4 py-4 sm:px-8 sm:py-5', className]}>
    {
        siteConfig.logo?.src ? (
            <a href="/">
                <CustomImage class="max-h-10" {...siteConfig.logo} loading="eager" fetchpriority="high" />
            </a>
        ) : (
            <a class:list={["text-lg font-extrabold tracking-tight sm:text-xl", isDark ? "text-white" : "text-slate-900 dark:text-slate-100"]} href="/">
                {siteConfig.title}
            </a>
        )
    }
    <div class="flex items-center gap-1 sm:gap-2">
        {/* Desktop nav */}
        {
            primaryNavLinks.length > 0 && (
                <nav class="hidden md:flex items-center gap-1" aria-label="Primary navigation">
                    {primaryNavLinks.map((link) => (
                        <HeaderNavLink
                            class:list={["relative rounded-md px-3 py-1.5 text-sm font-medium transition duration-300", isDark ? "text-white/70 hover:text-white hover:bg-white/10" : "text-slate-600 hover:text-slate-900 hover:bg-slate-100 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-700"]}
                            href={link.href}
                        >
                            {link.text}
                        </HeaderNavLink>
                    ))}
                </nav>
            )
        }
        <button
            data-open-search
            class="inline-flex items-center justify-center w-9 h-9 rounded-md text-current opacity-60 hover:opacity-100 hover:bg-white/10 transition cursor-pointer"
            aria-label="Search (Cmd+K)">
            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24"
                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8" />
                <path d="m21 21-4.3-4.3" />
            </svg>
        </button>
        <ThemeToggle />
        {/* Mobile nav */}
        {
            primaryNavLinks.length > 0 && (
                <nav class="relative md:hidden" aria-label="Mobile navigation">
                    <button
                        class="relative z-20 inline-flex items-center justify-center w-9 h-9 rounded-md text-current opacity-60 hover:opacity-100 hover:bg-white/10 transition cursor-pointer menu-toggle"
                        aria-label="Open Menu"
                        aria-expanded="false"
                        aria-controls="menu-items"
                    >
                        <span class="relative w-1 h-1 bg-current rounded-full menu-toggle-icon" />
                    </button>
                    <ul id="menu-items" class="absolute z-10 px-8 pt-16 pb-10 border menu -top-3 -right-3 border-white/20 bg-white/90 dark:border-slate-600/40 dark:bg-slate-800/95 sm:px-12 sm:pt-20 sm:pb-16">
                        {primaryNavLinks.map((link) => (
                            <li class="mb-1 border-b border-slate-200/70 dark:border-slate-600/70">
                                <HeaderNavLink
                                    class="relative block py-1.5 pr-6 text-base font-semibold transition duration-300 text-slate-700 hover:text-primary dark:text-slate-200 dark:hover:text-accent"
                                    href={link.href}
                                >
                                    {link.text}
                                </HeaderNavLink>
                            </li>
                        ))}
                    </ul>
                </nav>
            )
        }
    </div>
</header>

<style>
    @reference "tailwindcss";

    .menu {
        width: calc(100vw - 0.5rem);
        max-width: 18.75rem;
        border-radius: 16px;
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
        backdrop-filter: blur(12px);
        opacity: 0;
        transform: scale(0.6);
        transform-origin: top right;
        transition:
            transform 0.2s cubic-bezier(0.4, 0, 0.2, 1) 0.3s,
            opacity 0.25s cubic-bezier(0.4, 0, 0.2, 1) 0.25s,
            visibility 0s 0.5s;
        visibility: hidden;
    }
    .menu.is-visible {
        opacity: 1;
        transform: scale(1);
        transition:
            transform 0.25s cubic-bezier(0.4, 0, 0.2, 1) 0.25s,
            opacity 0.15s 0.15s,
            visibility 0s 0.25s;
        visibility: visible;
    }
    .menu-toggle-icon {
        transition:
            height 0s 0.25s,
            width 0s 0.25s;
    }
    .menu-toggle-icon.is-active {
        height: 3px;
        width: 3px;
    }
    .menu-toggle-icon:before,
    .menu-toggle-icon:after {
        @apply absolute top-1/2 left-1/2 h-1 w-1 -translate-x-1/2 -translate-y-1/2 rounded-full bg-current;
        content: '';
        transition:
            width 0.25s cubic-bezier(0.4, 0, 0.2, 1),
            height 0s 0.25s,
            translate 0s 0.25s,
            rotate 0s 0.25s,
            margin 0.25s cubic-bezier(0.4, 0, 0.2, 1) 0.25s;
    }
    .menu-toggle-icon:before {
        @apply -ml-2;
    }
    .menu-toggle-icon:after {
        @apply ml-2;
    }
    .menu-toggle-icon.is-active:before,
    .menu-toggle-icon.is-active:after {
        @apply ml-0 w-5 rounded-md;
        height: 3px;
        transition:
            margin 0.25s cubic-bezier(0.4, 0, 0.2, 1),
            height 0s 0.25s,
            translate 0s 0.25s,
            rotate 0s 0.25s,
            width 0.25s cubic-bezier(0.4, 0, 0.2, 1) 0.25s;
    }
    .menu-toggle-icon.is-active:before {
        @apply rotate-45;
    }
    .menu-toggle-icon.is-active:after {
        @apply -rotate-45;
    }
</style>

<script>
    function menuToggle() {
        const menu = document.querySelector('.menu');
        const menuToggleBtn = document.querySelector('.menu-toggle');
        const menuToggleIcon = document.querySelector('.menu-toggle-icon');
        menuToggleBtn?.addEventListener('click', () => {
            const isMenuExpanded = menuToggleBtn.getAttribute('aria-expanded') === 'true';
            menuToggleBtn.setAttribute('aria-expanded', isMenuExpanded ? 'false' : 'true');
            menuToggleBtn.setAttribute('aria-label', isMenuExpanded ? 'Open Menu' : 'Close Menu');
            menuToggleIcon?.classList.toggle('is-active');
            menu?.classList.toggle('is-visible');
        });
    }
    menuToggle();
    document.addEventListener('astro:after-swap', menuToggle);
</script>
