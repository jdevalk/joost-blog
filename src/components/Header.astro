---
import siteConfig from '../data/site-config';
---

<header class="sp-header">
    <div class="sp-header-inner">
        <div class="sp-header-left">
            <a href="/" class="sp-logo-link">
                <div class="sp-mark">J</div>
                <div class="sp-wordmark">
                    <div class="sp-title">{siteConfig.title}</div>
                </div>
            </a>
        </div>
        <nav class="sp-nav" id="sp-nav" aria-label="Primary navigation">
            {
                siteConfig.primaryNavLinks?.map((link) => (
                    <a href={link.href} aria-current={Astro.url.pathname.startsWith(link.href) ? 'page' : undefined}>
                        {link.text}
                    </a>
                ))
            }
        </nav>
        <div class="sp-header-right">
            <button class="sp-search" data-open-search aria-label="Search (⌘K)"> ⌕&nbsp;&nbsp;search the archive </button>
            <button class="sp-hamburger" id="sp-hamburger" aria-label="Open menu" aria-expanded="false" aria-controls="sp-nav">
                <span></span><span></span><span></span>
            </button>
        </div>
    </div>
</header>

<script>
    const hamburger = document.getElementById('sp-hamburger');
    const nav = document.getElementById('sp-nav');

    hamburger?.addEventListener('click', () => {
        const isOpen = nav?.classList.toggle('is-open');
        hamburger.setAttribute('aria-expanded', String(!!isOpen));
        hamburger.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
    });

    nav?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
            nav.classList.remove('is-open');
            hamburger?.setAttribute('aria-expanded', 'false');
            hamburger?.setAttribute('aria-label', 'Open menu');
        });
    });
</script>
