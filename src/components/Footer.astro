---
import siteConfig from '../data/site-config';
import SocialLink from './SocialLink.astro';

const socialLinks = siteConfig.socialLinks ?? [];
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-[#7a1830]/10 bg-[#4a1525] px-4 py-10 text-white dark:border-[#c9506a]/10 dark:bg-[#1c1614] sm:px-8 sm:py-14">
    <div class="mx-auto max-w-5xl">
        <div class="grid gap-8 sm:grid-cols-3">
            {/* About column */}
            <div class="sm:col-span-2">
                <p class="text-lg font-extrabold tracking-tight text-white dark:text-slate-100">Joost de Valk</p>
                <p class="mt-2 max-w-md text-sm leading-relaxed text-white/85 dark:text-slate-400">
                    Internet entrepreneur from the Netherlands. Founder of Yoast, investor through Emilia Capital, and maker of Progress Planner.
                </p>
                {socialLinks.length > 0 && (
                    <div class="mt-4 flex flex-wrap gap-x-2 gap-y-2">
                        {socialLinks.map((link) => (
                            <SocialLink {...link} class="h-9 w-9 bg-white/10 text-white/80 hover:bg-white/20 hover:text-white dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-accent dark:hover:text-slate-900" />
                        ))}
                    </div>
                )}
            </div>

            {/* Navigation column */}
            <div>
                <p class="text-xs font-bold uppercase tracking-widest text-white/70 dark:text-accent">Navigate</p>
                <ul class="mt-3 space-y-2">
                    {siteConfig.primaryNavLinks?.map((link) => (
                        <li>
                            <a href={link.href} class="text-sm text-white/85 hover:text-white dark:text-slate-400 dark:hover:text-accent transition-colors duration-300">
                                {link.text}
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
        </div>

        <div class="mt-10 border-t border-white/10 pt-6 dark:border-slate-700">
            <p class="text-xs text-white/60 dark:text-slate-500">
                &copy; 2020&ndash;{currentYear} Joost de Valk. Built with Astro.
            </p>
        </div>
    </div>
</footer>
