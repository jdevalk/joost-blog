---
const currentYear = new Date().getFullYear();

const elsewhere = [
    { text: 'bsky', href: 'https://bsky.app/profile/joost.blog' },
    { text: 'github', href: 'https://github.com/jdevalk' },
    { text: 'linkedin', href: 'https://www.linkedin.com/in/jdevalk/' }
];
---

<footer class="site-footer">
    <div class="site-footer-elsewhere">
        <div class="site-footer-elsewhere-title">Find me elsewhere</div>
        <div class="site-footer-links">
            {
                elsewhere.map((link) => (
                    <a href={link.href} target="_blank" rel="noopener noreferrer me">
                        → {link.text}
                    </a>
                ))
            }
        </div>
    </div>
    <div class="site-colophon">
        Set in Domaine &amp; Pitch<br />© {currentYear} Joost de Valk · Wijchen, NL
    </div>
</footer>
