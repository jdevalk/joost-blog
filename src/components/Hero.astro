---
import type { Hero as HeroProps, SocialLink as SocialLinkProps } from '../types';
import CustomImage from './CustomImage.astro';
import SocialLink from './SocialLink.astro';

type Props = HeroProps & {
    socialLinks?: SocialLinkProps[];
    variant?: 'dark' | 'light';
};

const { title, text, avatar, backgroundImage, socialLinks, variant } = Astro.props;
const isDark = variant === 'dark';
---

{
    (title || text || avatar?.src) && (
        <>
            {backgroundImage?.src && (
                <CustomImage
                    {...backgroundImage}
                    class="absolute inset-0 object-cover w-full h-full pointer-events-none opacity-20"
                    sizes="100vw"
                    widths={[640, 960, 1280, 1600, 1920]}
                    fetchpriority="high"
                    loading="eager"
                />
            )}
            <section class="relative px-4 py-10 sm:px-8 sm:py-14">
                <div class="flex flex-col items-center w-full max-w-3xl mx-auto sm:flex-row sm:items-center sm:text-left sm:gap-8">
                    {avatar?.src && (
                        <div class="shrink-0 mb-4 sm:mb-0">
                            <CustomImage
                                {...avatar}
                                class:list={["object-cover w-36 sm:w-44 border-2 rounded-full aspect-square", isDark ? "border-white/20 shadow-avatar-dark" : "border-primary/20 shadow-avatar"]}
                                width={176}
                                height={176}
                                widths={[176, 352]}
                                sizes="176px"
                                fetchpriority="high"
                                loading="eager"
                            />
                        </div>
                    )}
                    <div class="text-center sm:text-left">
                        {title && <div class:list={["text-3xl font-extrabold tracking-tight sm:text-4xl", isDark ? "text-white" : "text-slate-900 dark:text-slate-100"]}>Hi, I'm <h1 class="inline">{title}</h1></div>}
                        {text && <p class:list={['mt-2 text-base sm:text-lg leading-relaxed', isDark ? 'text-white/75 [&_a]:text-accent [&_a]:underline [&_a]:underline-offset-2 [&_a:hover]:text-white' : 'text-slate-600 dark:text-slate-300', { 'mt-3': title }]} set:html={text} />}
                        {socialLinks && socialLinks.length > 0 && (
                            <div class:list={['flex flex-wrap gap-x-2 gap-y-2 justify-center sm:justify-start', { 'mt-5': title || text }]}>
                                {socialLinks.map((link) => (
                                    <SocialLink {...link} class:list={[isDark ? "bg-white/10 hover:bg-white/20 text-white hover:text-white" : "bg-white hover:bg-primary hover:shadow-button text-slate-700 hover:text-white dark:bg-[#2a2623] dark:text-slate-200"]} />
                                ))}
                            </div>
                        )}
                    </div>
                </div>
            </section>
        </>
    )
}
