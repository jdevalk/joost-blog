---
type Props = {
    title: string;
    description: string;
    href: string;
    label?: string;
};

const { title, description, href, label } = Astro.props;
---

<a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    class="group flex flex-col rounded-lg border border-slate-200 bg-white p-5 transition duration-300 hover:shadow-card-hover hover:-translate-y-0.5 dark:border-slate-700 dark:bg-slate-800/50"
>
    {label && (
        <span class="mb-2 text-xs font-semibold uppercase tracking-wider text-primary dark:text-accent">{label}</span>
    )}
    <h3 class="text-lg font-bold text-slate-900 dark:text-slate-100 group-hover:text-primary dark:group-hover:text-accent transition-colors duration-300">{title}</h3>
    <p class="mt-1.5 text-sm leading-relaxed text-slate-600 dark:text-slate-400">{description}</p>
</a>
