---
type Props = {
    title: string;
    description: string;
    href: string;
    label?: string;
    external?: boolean;
    transitionName?: string;
};

const { title, description, href, label, external = true, transitionName } = Astro.props;
---

<a
    href={href}
    target={external ? '_blank' : undefined}
    rel={external ? 'noopener noreferrer' : undefined}
    class="group hover:shadow-card-hover flex flex-col rounded-lg border border-slate-200 bg-white p-5 transition duration-300 hover:-translate-y-0.5 dark:border-[#2a2623] dark:bg-[#1e1b19]/50"
    style={transitionName ? `view-transition-name: ${transitionName}` : undefined}
>
    {label && <span class="text-primary dark:text-accent mb-2 text-xs font-bold tracking-wider uppercase">{label}</span>}
    <h3 class="group-hover:text-primary dark:group-hover:text-accent text-lg font-extrabold text-slate-950 transition-colors duration-300 dark:text-slate-100">
        {title}
    </h3>
    <p class="mt-1.5 text-sm leading-relaxed text-slate-700 dark:text-slate-400">{description}</p>
</a>
