---
import monaSansWoff2 from '@fontsource-variable/mona-sans/files/mona-sans-latin-wght-normal.woff2?url';
import Seo from '@jdevalk/astro-seo-graph/Seo.astro';
import siteConfig from '../data/site-config';
import { SITE_URL } from '../utils/schema/constants';

import '../styles/global.css';

export type Props = {
    title?: string;
    description?: string;
    pageType?: 'website' | 'article';
    publishDate?: Date;
    updatedDate?: Date;
    categories?: string[];
    noindex?: boolean;
};

const {
    description = '',
    pageType = 'website',
    publishDate,
    updatedDate,
    categories,
    noindex,
} = Astro.props;
const title = [Astro.props.title, siteConfig.title].filter(Boolean).join(' · ');

// OG image: always use auto-generated image from slug
const slug = Astro.url.pathname.replace(/^\/|\/$/g, '');
const ogImageBase = Astro.site?.origin ?? SITE_URL;
const ogImage = new URL(`/og/${slug || 'index'}.webp`, ogImageBase).toString();

// Canonical URL always points to production domain
const canonicalURL = new URL(Astro.url.pathname, SITE_URL);

/**
 * Enforce some standard canonical URL formatting across the site.
 */
function formatCanonicalURL(url: string | URL) {
    const path = url.toString();
    const hasQueryParams = path.includes('?');
    if (hasQueryParams) {
        path.replace(/\/?$/, '');
    }
    return path.replace(/\/?$/, hasQueryParams ? '' : '/');
}

// Build article-specific OG data
const articleMeta =
    pageType === 'article' && publishDate
        ? {
              publishedTime: publishDate,
              ...(updatedDate ? { modifiedTime: updatedDate } : {}),
              authors: ['https://joost.blog/about-me/'],
              ...(categories?.length ? { tags: [...categories] } : {}),
          }
        : undefined;

const ogImageAlt = Astro.props.title ?? siteConfig.title;
---

<!-- High Priority Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<!-- Font preloads -->
<link rel="preload" as="font" type="font/woff2" href={monaSansWoff2} crossorigin="anonymous" />
<link rel="preload" href="/fonts/DomaineDisplay-Medium.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/DomaineDisplay-MediumItalic.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/DomaineText-Light.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/DomaineText-LightItalic.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/DomaineText-Bold.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/Pitch-Regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/Pitch-RegularItalic.woff2" as="font" type="font/woff2" crossorigin>

<!-- NLWeb discovery -->
<link rel="nlweb" href="https://joost.blog/ask" />

<!-- DNS prefetch for external resources -->
<link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />

<!-- SEO -->
<Seo
    title={title}
    description={description}
    canonical={formatCanonicalURL(canonicalURL)}
    ogType={pageType}
    ogImage={ogImage}
    ogImageAlt={ogImageAlt}
    ogImageWidth={1200}
    ogImageHeight={675}
    siteName={siteConfig.title}
    locale="en_US"
    twitter={{ card: 'summary_large_image', site: '@jdevalk', creator: '@jdevalk' }}
    article={articleMeta}
    noindex={noindex}
    extraLinks={[
        { rel: 'icon', href: '/favicon.ico', sizes: '48x48 32x32 16x16' },
        { rel: 'icon', type: 'image/png', href: '/favicon-512.png', sizes: '512x512' },
        { rel: 'apple-touch-icon', href: '/favicon-512.png' },
        { rel: 'sitemap', href: '/sitemap-index.xml' },
        { rel: 'alternate', type: 'application/rss+xml', href: '/feed.xml', title: 'RSS' },
    ]}
    extraMeta={[{ name: 'author', content: 'Joost de Valk' }]}
/>

<!-- Analytics (Cloudflare Pages Functions — only works in production) -->
{
    !import.meta.env.DEV && (
        <script defer data-domain="joost.blog" data-api="/api/event" src="/api/s" />
    )
}
<!-- Speculation Rules: prefetch same-origin links on hover/touchstart -->
<script type="speculationrules" is:inline set:html={JSON.stringify({
    prefetch: [{
        source: 'document',
        where: { and: [
            { href_matches: '/*' },
            { not: { href_matches: '/*\\?*' } },
            { not: { selector_matches: '[rel~="nofollow"]' } },
        ] },
        eagerness: 'moderate',
    }],
})} />
