---
import monaSansWoff2 from '@fontsource-variable/mona-sans/files/mona-sans-latin-wght-normal.woff2?url';
import { SEO } from 'astro-seo';
import { getImage } from 'astro:assets';
import siteConfig from '../data/site-config';
import { SITE_URL } from '../utils/schema/constants';
import type { ImageInput } from '../types';

import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

export type Props = {
    title?: string;
    description?: string;
    image?: ImageInput | undefined;
    ogImage?: string;
    pageType?: 'website' | 'article';
    publishDate?: Date;
    updatedDate?: Date;
    categories?: string[];
};

const {
    description = '',
    pageType = 'website',
    publishDate,
    updatedDate,
    categories,
} = Astro.props;
const title = [Astro.props.title, siteConfig.title].filter(Boolean).join(' | ');

// OG image resolution: prefer explicit ogImage prop, then auto-generated OG image from slug
const slug = Astro.url.pathname.replace(/^\/|\/$/g, '');
const autoOgImage = `/og/${slug || 'index'}.png`;
const ogImageUrl = Astro.props.ogImage ?? autoOgImage;
// OG images must point to the actual deployed site (not production canonical) so they resolve
const ogImageBase = Astro.site?.origin ?? SITE_URL;
const ogImageSrc = ogImageUrl ? new URL(ogImageUrl, ogImageBase).toString() : undefined;

// Fallback image resolution for pages without auto-generated OG images
const image = Astro.props.image ?? siteConfig.image;
let resolvedImage: { src: string; alt?: string } | undefined;
if (!ogImageSrc && image?.src) {
    if (typeof image.src === 'string') {
        resolvedImage = {
            src: new URL(image.src, ogImageBase).toString(),
            alt: image.alt
        };
    } else {
        const optimizedImage = await getImage({
            src: image.src as ImageMetadata,
            width: 1200,
            height: 630,
            format: 'jpeg',
            fit: 'cover'
        });
        resolvedImage = {
            src: new URL(optimizedImage.src, ogImageBase).toString(),
            alt: image.alt
        };
    }
}

// Final OG image: auto-generated takes priority, then resolved from image prop
const finalOgImage = ogImageSrc ?? resolvedImage?.src;

// Canonical URL always points to production domain
const canonicalURL = new URL(Astro.url.pathname, SITE_URL);

/**
 * Enforce some standard canonical URL formatting across the site.
 */
function formatCanonicalURL(url: string | URL) {
    const path = url.toString();
    const hasQueryParams = path.includes('?');
    if (hasQueryParams) {
        path.replace(/\/?$/, '');
    }
    return path.replace(/\/?$/, hasQueryParams ? '' : '/');
}

// Build article-specific OG data
const articleOg = pageType === 'article' && publishDate ? {
    publishedTime: publishDate.toISOString(),
    ...(updatedDate ? { modifiedTime: updatedDate.toISOString() } : {}),
    authors: ['https://joost.blog/about-me/'],
    ...(categories?.length ? { tags: categories } : {}),
} : undefined;
---

<!-- High Priority Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<!-- Font preloads -->
<link rel="preload" as="font" type="font/woff2" href={monaSansWoff2} crossorigin="anonymous" />

<!-- DNS prefetch for external resources -->
<link rel="dns-prefetch" href="https://giscus.app" />
<link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />

<!-- SEO -->
<SEO
    title={title}
    description={description}
    canonical={formatCanonicalURL(canonicalURL)}
    openGraph={{
        basic: {
            title,
            type: pageType,
            image: finalOgImage ?? '',
            url: formatCanonicalURL(canonicalURL),
        },
        optional: {
            description,
            locale: 'en_US',
            siteName: siteConfig.title,
        },
        image: {
            alt: resolvedImage?.alt ?? Astro.props.title ?? siteConfig.title,
            width: 1200,
            height: 630,
        },
        ...(articleOg ? { article: articleOg } : {}),
    }}
    twitter={{
        card: 'summary_large_image',
        site: '@jdevalk',
        creator: '@jdevalk',
        title,
        description,
        image: finalOgImage,
        imageAlt: resolvedImage?.alt ?? Astro.props.title ?? siteConfig.title,
    }}
    extend={{
        link: [
            { rel: 'icon', type: 'image/svg+xml', href: '/favicon.svg' },
            { rel: 'sitemap', href: '/sitemap-index.xml' },
            { rel: 'alternate', type: 'application/rss+xml', href: '/rss.xml', title: 'RSS' },
        ],
        meta: [
            { name: 'author', content: 'Joost de Valk' },
        ],
    }}
/>

<!-- Analytics -->
<script defer data-domain="joost.blog" data-api="/api/event" src="/api/js/script.js"></script>

<!-- View Transitions -->
<ClientRouter />
