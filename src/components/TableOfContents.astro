---
interface Heading {
    depth: number;
    slug: string;
    text: string;
}

interface Props {
    headings: Heading[];
}

const { headings } = Astro.props;
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{tocHeadings.length > 0 && (
    <Fragment>
        {/* Mobile: inline at top, hidden on lg+ */}
        <nav class="lg:hidden mb-8 rounded-lg border border-slate-200 bg-surface p-5 dark:border-[#2a2623] dark:bg-[#1e1b19]/50" aria-label="Table of contents">
            <p class="text-xs font-bold uppercase tracking-widest text-primary dark:text-accent mb-3">On this page</p>
            <ul class="space-y-1.5">
                {tocHeadings.map((h) => (
                    <li>
                        <a
                            href={`#${h.slug}`}
                            class:list={[
                                'block text-sm text-slate-600 hover:text-primary dark:text-slate-400 dark:hover:text-accent transition-colors',
                                h.depth === 3 && 'pl-4',
                            ]}
                        >
                            {h.text}
                        </a>
                    </li>
                ))}
            </ul>
        </nav>

        {/* Desktop: sticky sidebar, hidden below lg. Row-span handled by grid parent. */}
        <aside class="hidden lg:block row-span-full" aria-label="Table of contents">
            <div class="sticky top-24 max-h-[calc(100vh-8rem)] overflow-y-auto">
                <p class="text-xs font-bold uppercase tracking-widest text-primary dark:text-accent mb-3">On this page</p>
                <ul class="space-y-1.5">
                    {tocHeadings.map((h) => (
                        <li>
                            <a
                                href={`#${h.slug}`}
                                data-toc-link
                                class:list={[
                                    'block text-sm leading-snug text-slate-500 hover:text-primary dark:text-slate-400 dark:hover:text-accent transition-colors',
                                    h.depth === 3 && 'pl-3',
                                ]}
                            >
                                {h.text}
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
        </aside>
    </Fragment>
)}

<style>
    [data-toc-link].active {
        color: var(--color-primary);
        font-weight: 600;
    }

    :global(.dark) [data-toc-link].active {
        color: var(--color-accent);
    }
</style>

<script>
    function initToc() {
        const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
        if (links.length === 0) return;

        const headingIds = Array.from(links).map((l) => l.hash.slice(1));
        const headings = headingIds
            .map((id) => document.getElementById(id))
            .filter((el): el is HTMLElement => el !== null);

        if (headings.length === 0) return;

        const observer = new IntersectionObserver(
            () => {
                let active = headings[0]!.id;
                for (const heading of headings) {
                    if (heading.getBoundingClientRect().top <= 120) {
                        active = heading.id;
                    }
                }
                links.forEach((link) => {
                    link.classList.toggle('active', link.hash === `#${active}`);
                });
            },
            { rootMargin: '-80px 0px -70% 0px', threshold: 0 },
        );

        headings.forEach((h) => observer.observe(h));
    }

    initToc();
</script>
