---
interface Heading {
    depth: number;
    slug: string;
    text: string;
}

interface Props {
    headings: Heading[];
}

const { headings } = Astro.props;

interface TocItem {
    depth: number;
    slug: string;
    text: string;
    idx: number | null;
}
const tocItems: TocItem[] = [];
let h2Idx = 0;
for (const h of headings.filter((h) => h.depth === 2 || h.depth === 3)) {
    if (h.depth === 2) h2Idx++;
    tocItems.push({ ...h, idx: h.depth === 2 ? h2Idx : null });
}
---

{
    tocItems.length > 0 && (
        <nav class="sp-post-toc" aria-label="Table of contents">
            <button
                type="button"
                class="sp-post-toc-mobile"
                aria-expanded="false"
                aria-controls="sp-post-toc-body"
                data-toc-toggle
            >
                <span class="sp-post-toc-mobile-eyebrow">Contents</span>
                <span class="sp-post-toc-mobile-current" data-toc-current>
                    Top of page
                </span>
                <svg
                    class="sp-post-toc-mobile-chev"
                    xmlns="http://www.w3.org/2000/svg"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <polyline points="6 9 12 15 18 9" />
                </svg>
            </button>
            <div class="sp-post-toc-body" id="sp-post-toc-body">
                <div class="lbl">
                    On this page{' '}
                    <a href="#" aria-label="Back to top">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="13"
                            height="13"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                        >
                            <polyline points="18 15 12 9 6 15" />
                        </svg>
                    </a>
                </div>
                <ol>
                    {tocItems.map((item) => (
                        <li class:list={[{ sub: item.depth === 3 }]}>
                            <a href={`#${item.slug}`} data-toc-link>
                                {item.idx !== null && <span class="sp-post-toc-num">{String(item.idx).padStart(2, '0')}</span>}
                                {item.text}
                            </a>
                        </li>
                    ))}
                </ol>
            </div>
        </nav>
    )
}
