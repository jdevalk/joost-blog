---
import BaseHead, { type Props as HeadProps } from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SearchModal from '../components/SearchModal.astro';

export type Props = HeadProps;

const { ...head } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead {...head} />
    </head>
    <body>
        <a
            href="#main-content"
            class="focus:bg-primary sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-lg focus:px-4 focus:py-2 focus:text-white focus:shadow-lg"
            >Skip to content</a
        >
        <slot name="header">
            <Header />
        </slot>
        <div id="main-content">
            <slot />
        </div>
        <slot name="footer">
            <Footer />
        </slot>
        <SearchModal />
        <script>
            import '../scripts/webmcp.ts';
        </script>
    </body>
</html>
