CF_ACCOUNT_ID=your-cloudflare-account-id
CF_API_TOKEN=your-cloudflare-api-token

# Token with permission: Account → Account Analytics → Read.
# Used by scripts/ai-crawler-roi.mjs to query Analytics Engine SQL.
CF_ANALYTICS_TOKEN=your-cloudflare-analytics-token

# AI crawler ROI script (scripts/ai-crawler-roi.mjs). See the header comment in
# that file for the full Google Cloud setup.
GSC_SERVICE_ACCOUNT_JSON=/absolute/path/to/gsc-service-account.json
GSC_SITE=sc-domain:joost.blog
